+// TestMessageCache exercises the standalone capture cache: enumeration
+// snapshot safety, exact-instance Take, Drop, DropMsgs, and Clear.
+func TestMessageCache(t *testing.T) {
+	c := NewMessageCache()
+	if c.Len() != 0 {
+		t.Fatalf("new cache has %d messages, want 0", c.Len())
+	}
+	c.Add(
+		pb.Message{Type: pb.MsgHeartbeat, From: 1, To: 2, Term: 3},
+		pb.Message{Type: pb.MsgApp, From: 1, To: 2, Term: 3, Entries: []pb.Entry{{Index: 4, Term: 3, Data: []byte("x")}}},
+		pb.Message{Type: pb.MsgVote, From: 2, To: 1, Term: 3},
+	)
+	if c.Len() != 3 {
+		t.Fatalf("cache has %d messages, want 3", c.Len())
+	}
+
+	// Messages() returns a snapshot that does not alias the cache.
+	snap := c.Messages()
+	snap[1].Entries[0].Data[0] = 'z'
+	snap[2].Type = pb.MsgProp
+	if got := c.Messages()[1].Entries[0].Data; string(got) != "x" {
+		t.Fatalf("snapshot mutation reached the cache: entries data %q, want %q", got, "x")
+	}
+	if got := c.Messages()[2].Type; got != pb.MsgVote {
+		t.Fatalf("snapshot mutation reached the cache: type %v, want MsgVote", got)
+	}
+
+	// TakeMsg removes the exact instance and preserves routing and content.
+	m, ok := c.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgApp })
+	if !ok {
+		t.Fatal("TakeMsg did not find the MsgApp")
+	}
+	if m.To != 2 || m.From != 1 || len(m.Entries) != 1 || string(m.Entries[0].Data) != "x" {
+		t.Fatalf("TakeMsg returned wrong instance: %+v", m)
+	}
+	if c.Len() != 2 {
+		t.Fatalf("cache has %d messages after TakeMsg, want 2", c.Len())
+	}
+	if _, ok := c.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgApp }); ok {
+		t.Fatal("TakeMsg returned an already-removed instance")
+	}
+
+	// DropMsg removes one matching instance without delivering it.
+	if !c.DropMsg(func(m pb.Message) bool { return m.Type == pb.MsgHeartbeat }) {
+		t.Fatal("DropMsg did not remove the MsgHeartbeat")
+	}
+	if c.Len() != 1 {
+		t.Fatalf("cache has %d messages after DropMsg, want 1", c.Len())
+	}
+
+	// DropMsgs removes all remaining matches.
+	if n := c.DropMsgs(func(m pb.Message) bool { return m.Term == 3 }); n != 1 {
+		t.Fatalf("DropMsgs removed %d messages, want 1", n)
+	}
+	if c.Len() != 0 {
+		t.Fatalf("cache has %d messages after DropMsgs, want 0", c.Len())
+	}
+
+	// Clear removes everything.
+	c.Add(pb.Message{Type: pb.MsgVote, From: 3, To: 1})
+	c.Clear()
+	if c.Len() != 0 {
+		t.Fatalf("cache has %d messages after Clear, want 0", c.Len())
+	}
+}
