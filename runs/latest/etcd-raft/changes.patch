+// TestDriverCaptureAndDeliver drives a two-node RawNode group through the
+// Driver seam: Ready output is captured into the driver cache before delivery,
+// the combined Deliver form injects captured instances through the normal
+// Step input, and the separated TakeMsg+Step form completes the same route.
+func TestDriverCaptureAndDeliver(t *testing.T) {
+	snap := pb.Snapshot{Metadata: pb.SnapshotMetadata{
+		ConfState: pb.ConfState{Voters: []uint64{1, 2}},
+		Index:     1,
+		Term:      1,
+	}}
+	newNode := func(id uint64) (*Driver, *raft.MemoryStorage) {
+		s := raft.NewMemoryStorage()
+		if err := s.ApplySnapshot(snap); err != nil {
+			t.Fatal(err)
+		}
+		rn, err := raft.NewRawNode(&raft.Config{
+			ID:              id,
+			ElectionTick:    10,
+			HeartbeatTick:   1,
+			Storage:         s,
+			MaxSizePerMsg:   math.MaxUint64,
+			MaxInflightMsgs: 256,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return NewDriver(rn), s
+	}
+
+	d1, s1 := newNode(1)
+	d2, s2 := newNode(2)
+	storages := map[uint64]*raft.MemoryStorage{1: s1, 2: s2}
+	drivers := map[uint64]*Driver{1: d1, 2: d2}
+	bind := func(m pb.Message) *raft.RawNode {
+		if d, ok := drivers[m.To]; ok {
+			return d.RawNode
+		}
+		return nil
+	}
+
+	// drive handles every pending Ready (persisting entries, hard state, and
+	// snapshot before any delivery) and delivers every captured message
+	// through the combined Deliver call, until the system quiesces.
+	drive := func() {
+		for {
+			progress := false
+			for id, d := range drivers {
+				for d.HasReady() {
+					progress = true
+					rd, hasWork := d.Ready()
+					if hasWork {
+						if err := storages[id].Append(rd.Entries); err != nil {
+							t.Fatal(err)
+						}
+						if !raft.IsEmptyHardState(rd.HardState) {
+							if err := storages[id].SetHardState(rd.HardState); err != nil {
+								t.Fatal(err)
+							}
+						}
+						if !raft.IsEmptySnap(rd.Snapshot) {
+							if err := storages[id].ApplySnapshot(rd.Snapshot); err != nil {
+								t.Fatal(err)
+							}
+						}
+					}
+					d.Advance(rd)
+				}
+				for d.Len() > 0 {
+					progress = true
+					if err := d.Deliver(func(pb.Message) bool { return true }, bind); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			if !progress {
+				return
+			}
+		}
+	}
+
+	// Elect node 1 as leader; the vote request and response travel through the
+	// driver capture caches.
+	if err := d1.Campaign(); err != nil {
+		t.Fatal(err)
+	}
+	drive()
+	if st := d1.Status().RaftState; st != raft.StateLeader {
+		t.Fatalf("node 1 state = %v, want StateLeader", st)
+	}
+
+	// Propose and drive the append to a commit on both nodes.
+	if err := d1.Propose([]byte("write-a")); err != nil {
+		t.Fatal(err)
+	}
+	drive()
+	if commit := d1.Status().Commit; commit != 3 {
+		t.Fatalf("leader commit = %d, want 3", commit)
+	}
+	if commit := d2.Status().Commit; commit != 3 {
+		t.Fatalf("follower commit = %d, want 3", commit)
+	}
+
+	// Separated form: TakeMsg plus the documented normal input call on the
+	// target node the test owns.
+	if err := d1.Propose([]byte("write-b")); err != nil {
+		t.Fatal(err)
+	}
+	for d1.HasReady() {
+		rd, hasWork := d1.Ready()
+		if hasWork {
+			if err := s1.Append(rd.Entries); err != nil {
+				t.Fatal(err)
+			}
+			if !raft.IsEmptyHardState(rd.HardState) {
+				if err := s1.SetHardState(rd.HardState); err != nil {
+					t.Fatal(err)
+				}
+			}
+		}
+		d1.Advance(rd)
+	}
+	msg, ok := d1.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgApp })
+	if !ok {
+		t.Fatal("no MsgApp captured after second proposal")
+	}
+	if msg.To != 2 || len(msg.Entries) != 1 || string(msg.Entries[0].Data) != "write-b" {
+		t.Fatalf("TakeMsg returned wrong message: %+v", msg)
+	}
+	if err := d2.RawNode.Step(msg); err != nil {
+		t.Fatal(err)
+	}
+	for d2.HasReady() {
+		rd, hasWork := d2.Ready()
+		if hasWork {
+			if err := s2.Append(rd.Entries); err != nil {
+				t.Fatal(err)
+			}
+			if !raft.IsEmptyHardState(rd.HardState) {
+				if err := s2.SetHardState(rd.HardState); err != nil {
+					t.Fatal(err)
+				}
+			}
+		}
+		d2.Advance(rd)
+	}
+	resp, ok := d2.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgAppResp })
+	if !ok || resp.To != 1 || resp.Index != 4 {
+		t.Fatalf("no MsgAppResp captured after separated delivery: %+v (ok=%v)", resp, ok)
+	}
+	if err := d1.RawNode.Step(resp); err != nil {
+		t.Fatal(err)
+	}
+	if commit := d1.Status().Commit; commit != 4 {
+		t.Fatalf("leader commit = %d, want 4", commit)
+	}
+}
+
+// TestInteractionEnvCacheOps exercises the exact-instance cache operations on
+// the InteractionEnv message path: capture retains in-flight messages in
+// env.Messages, TakeMsg removes one instance, DeliverMsg (combined form) binds
+// the destination to env.Nodes and steps the message in, and responses
+// re-enter the same cache through ProcessReady.
+func TestInteractionEnvCacheOps(t *testing.T) {
+	env := NewInteractionEnv(nil)
+	cfg := raftConfigStub()
+	snap := pb.Snapshot{Metadata: pb.SnapshotMetadata{
+		ConfState: pb.ConfState{Voters: []uint64{1, 2, 3}},
+		Index:     2,
+		Term:      1,
+	}}
+	if err := env.AddNodes(3, cfg, snap); err != nil {
+		t.Fatal(err)
+	}
+	env.Messages = append(env.Messages,
+		pb.Message{Type: pb.MsgHeartbeat, From: 1, To: 2, Term: 2},
+		pb.Message{Type: pb.MsgApp, From: 1, To: 2, Term: 2, Entries: []pb.Entry{{Index: 3, Term: 2, Data: []byte("d")}}},
+		pb.Message{Type: pb.MsgVote, From: 2, To: 99, Term: 2},
+	)
+
+	// TakeMsg removes one exact instance and preserves content and routing.
+	m, ok := env.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgApp })
+	if !ok {
+		t.Fatal("TakeMsg did not find the MsgApp")
+	}
+	if m.To != 2 || len(m.Entries) != 1 || string(m.Entries[0].Data) != "d" {
+		t.Fatalf("TakeMsg returned wrong instance: %+v", m)
+	}
+	if got := len(env.Messages); got != 2 {
+		t.Fatalf("env has %d in-flight messages after TakeMsg, want 2", got)
+	}
+
+	// DeliverMsg (combined form) locates the cached instance, validates its
+	// destination against env.Nodes, steps it into the target node, and
+	// removes it from the cache.
+	if err := env.DeliverMsg(func(m pb.Message) bool { return m.Type == pb.MsgHeartbeat }); err != nil {
+		t.Fatal(err)
+	}
+	if got := len(env.Messages); got != 1 {
+		t.Fatalf("env has %d in-flight messages after DeliverMsg, want 1", got)
+	}
+	// The delivered heartbeat produced a response in the target node's next
+	// Ready; capture it back into the same cache via ProcessReady.
+	if !env.Nodes[1].HasReady() {
+		t.Fatal("node 2 has no Ready after receiving the heartbeat")
+	}
+	if err := env.ProcessReady(1); err != nil {
+		t.Fatal(err)
+	}
+	resp, ok := env.TakeMsg(func(m pb.Message) bool { return m.Type == pb.MsgHeartbeatResp })
+	if !ok || resp.To != 1 {
+		t.Fatalf("no MsgHeartbeatResp captured: %+v (ok=%v)", resp, ok)
+	}
+
+	// No match: cache unchanged, ErrNoMessage.
+	if err := env.DeliverMsg(func(m pb.Message) bool { return m.Type == pb.MsgSnap }); err != ErrNoMessage {
+		t.Fatalf("DeliverMsg returned %v, want ErrNoMessage", err)
+	}
+	if got := len(env.Messages); got != 1 {
+		t.Fatalf("env has %d in-flight messages after failed DeliverMsg, want 1", got)
+	}
+
+	// Unknown destination: cache unchanged, explicit failure.
+	if err := env.DeliverMsg(func(m pb.Message) bool { return m.Type == pb.MsgVote }); err == nil {
+		t.Fatal("DeliverMsg to unknown node returned nil error")
+	}
+	if got := len(env.Messages); got != 1 {
+		t.Fatalf("env has %d in-flight messages after failed DeliverMsg, want 1", got)
+	}
+
+	// DropMsgs and ClearMessages.
+	if n := env.DropMsgs(func(m pb.Message) bool { return true }); n != 1 {
+		t.Fatalf("DropMsgs removed %d messages, want 1", n)
+	}
+	if got := len(env.Messages); got != 0 {
+		t.Fatalf("env has %d in-flight messages after DropMsgs, want 0", got)
+	}
+	env.Messages = append(env.Messages, pb.Message{Type: pb.MsgVote, From: 2, To: 1})
+	env.ClearMessages()
+	if got := len(env.Messages); got != 0 {
+		t.Fatalf("env has %d in-flight messages after ClearMessages, want 0", got)
+	}
+}
