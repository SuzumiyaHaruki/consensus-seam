+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package raft
+
+import (
+	"testing"
+	"time"
+)
+
+// TestNodeTickLossless verifies that Node.Tick never silently drops an advance:
+// a Tick call blocks until the node's run loop accepts the tick, and every
+// requested tick is applied to the underlying raft state machine.
+func TestNodeTickLossless(t *testing.T) {
+	s := newTestMemoryStorage(withPeers(1))
+	// Use a large election tick so that the ticks below cannot trigger an
+	// election, which would reset the elapsed counter.
+	rn := newTestRawNode(1, 1000, 1, s)
+	n := newNode(rn)
+	r := rn.raft
+
+	// Fill the tick queue while the run loop is not running so that it cannot
+	// accept another tick. A Tick implementation that drops advances would
+	// return immediately here; a lossless one must wait for the run loop.
+	for i := 0; i < cap(n.tickc); i++ {
+		n.tickc <- struct{}{}
+	}
+	ticked := make(chan struct{})
+	go func() {
+		defer close(ticked)
+		n.Tick()
+	}()
+	select {
+	case <-ticked:
+		t.Fatal("Tick() returned while the run loop could not accept it; the advance was dropped")
+	case <-time.After(100 * time.Millisecond):
+		// Expected: Tick is waiting for the run loop to accept the tick.
+	}
+
+	go n.run()
+
+	// The run loop drains the queued ticks in FIFO order; the blocked Tick
+	// call completes once the queue has room, and every tick is applied.
+	<-ticked
+	deadline := time.Now().Add(5 * time.Second)
+	for len(n.tickc) != 0 {
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for the run loop to drain the tick queue")
+		}
+		time.Sleep(time.Millisecond)
+	}
+
+	n.Stop()
+	if got, want := r.electionElapsed, cap(n.tickc)+1; got != want {
+		t.Fatalf("electionElapsed = %d, want %d (every requested tick must be applied)", got, want)
+	}
+}
+
+// TestNodeTickAfterStop verifies that Tick on a stopped node returns promptly
+// instead of blocking forever.
+func TestNodeTickAfterStop(t *testing.T) {
+	s := newTestMemoryStorage(withPeers(1))
+	rn := newTestRawNode(1, 10, 1, s)
+	n := newNode(rn)
+	go n.run()
+	n.Stop()
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		n.Tick()
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Tick() blocked on a stopped node")
+	}
+}
