+
+package raft_test
+
+import (
+	"testing"
+
+	"go.etcd.io/raft/v3"
+	pb "go.etcd.io/raft/v3/raftpb"
+	"go.etcd.io/raft/v3/rafttest"
+)
+
+// newSingleNode returns a RawNode with a single voter (itself) and the given
+// election tick. If electionTimeoutRand is non-nil it is installed as
+// Config.ElectionTimeoutRand, otherwise the production default (crypto/rand)
+// is used.
+func newSingleNode(t *testing.T, electionTick int, electionTimeoutRand func(int) int) *raft.RawNode {
+	t.Helper()
+	st := raft.NewMemoryStorage()
+	snap := pb.Snapshot{
+		Metadata: pb.SnapshotMetadata{
+			Index: 3,
+			Term:  1,
+			ConfState: pb.ConfState{
+				Voters: []uint64{1},
+			},
+		},
+	}
+	if err := st.ApplySnapshot(snap); err != nil {
+		t.Fatalf("ApplySnapshot failed: %v", err)
+	}
+	rn, err := raft.NewRawNode(&raft.Config{
+		ID:                  1,
+		ElectionTick:        electionTick,
+		HeartbeatTick:       1,
+		Storage:             st,
+		MaxInflightMsgs:     256,
+		ElectionTimeoutRand: electionTimeoutRand,
+	})
+	if err != nil {
+		t.Fatalf("NewRawNode failed: %v", err)
+	}
+	return rn
+}
+
+// TestElectionTimeoutRandHook verifies that Config.ElectionTimeoutRand supplies
+// the randomized election timeout draw on every (re-)draw, so the test both
+// knows the value and can reproduce the same election timing across runs.
+func TestElectionTimeoutRandHook(t *testing.T) {
+	aCalls, bCalls := 0, 0
+	a := newSingleNode(t, 10, func(int) int { aCalls++; return 10 })
+	b := newSingleNode(t, 10, func(int) int { bCalls++; return 15 })
+
+	for i := 1; i <= 15; i++ {
+		a.Tick()
+		b.Tick()
+		wantA := raft.StateFollower
+		if i >= 10 {
+			wantA = raft.StateCandidate
+		}
+		wantB := raft.StateFollower
+		if i >= 15 {
+			wantB = raft.StateCandidate
+		}
+		if gotA, gotB := a.Status().RaftState, b.Status().RaftState; gotA != wantA || gotB != wantB {
+			t.Fatalf("tick %d: a=%v (want %v), b=%v (want %v)", i, gotA, wantA, gotB, wantB)
+		}
+	}
+	if aCalls == 0 || bCalls == 0 {
+		t.Fatalf("ElectionTimeoutRand was not consulted (aCalls=%d, bCalls=%d)", aCalls, bCalls)
+	}
+}
+
+// TestRawNodeSetRandomizedElectionTimeout verifies the per-instance setter: the
+// election fires at exactly the tick determined by the supplied value.
+func TestRawNodeSetRandomizedElectionTimeout(t *testing.T) {
+	rn := newSingleNode(t, 10, nil)
+	rn.SetRandomizedElectionTimeout(12)
+
+	for i := 0; i < 11; i++ {
+		rn.Tick()
+	}
+	if got := rn.Status().RaftState; got != raft.StateFollower {
+		t.Fatalf("state after 11 ticks = %v, want follower", got)
+	}
+	rn.Tick()
+	if got := rn.Status().RaftState; got != raft.StateCandidate {
+		t.Fatalf("state after 12 ticks = %v, want candidate", got)
+	}
+}
+
+// TestInteractionEnvSetRandomizedElectionTimeoutHook verifies that the exported
+// RawNode method implements rafttest's InteractionOpts.SetRandomizedElectionTimeout
+// hook, so external consumers can use the rafttest harness without access to
+// the raft package's internal state.
+func TestInteractionEnvSetRandomizedElectionTimeoutHook(t *testing.T) {
+	// The method expression has exactly the hook's signature.
+	var _ func(*raft.RawNode, int) = (*raft.RawNode).SetRandomizedElectionTimeout
+
+	env := rafttest.NewInteractionEnv(&rafttest.InteractionOpts{
+		SetRandomizedElectionTimeout: (*raft.RawNode).SetRandomizedElectionTimeout,
+	})
+	snap := pb.Snapshot{
+		Metadata: pb.SnapshotMetadata{
+			Index: 3,
+			Term:  1,
+			ConfState: pb.ConfState{
+				Voters: []uint64{1},
+			},
+		},
+	}
+	cfg := raft.Config{
+		ID:              1,
+		ElectionTick:    10,
+		HeartbeatTick:   1,
+		MaxInflightMsgs: 256,
+	}
+	if err := env.AddNodes(1, cfg, snap); err != nil {
+		t.Fatalf("AddNodes failed: %v", err)
+	}
+	env.Options.SetRandomizedElectionTimeout(env.Nodes[0].RawNode, 12)
+
+	if err := env.Tick(0, 11); err != nil {
+		t.Fatalf("Tick failed: %v", err)
+	}
+	if got := env.Nodes[0].Status().RaftState; got != raft.StateFollower {
+		t.Fatalf("state after 11 ticks = %v, want follower", got)
+	}
+	if err := env.Tick(0, 1); err != nil {
+		t.Fatalf("Tick failed: %v", err)
+	}
+	if got := env.Nodes[0].Status().RaftState; got != raft.StateCandidate {
+		t.Fatalf("state after 12 ticks = %v, want candidate", got)
+	}
+}
