+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"fmt"
+
+	"go.etcd.io/raft/v3"
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+// Driver drives a *raft.RawNode through the Ready cycle while capturing
+// outbound messages into an owned cache before delivery. It is the capture
+// seam for the direct RawNode message path: Ready moves Ready.Messages into
+// the cache, and nothing is delivered automatically — delivery resumes only
+// through a later test action on the cache.
+type Driver struct {
+	*raft.RawNode
+	cache *MessageCache
+}
+
+// NewDriver wraps rn. The returned Driver owns continuation: outbound
+// messages are retained in the cache until a test action takes, drops, clears,
+// or delivers them.
+func NewDriver(rn *raft.RawNode) *Driver {
+	return &Driver{RawNode: rn, cache: NewMessageCache()}
+}
+
+// Ready returns the next Ready with its outbound Messages moved into the
+// cache; the returned Ready carries no Messages. hasWork reports whether rd
+// contains entries, committed entries, a hard state, or a snapshot that must
+// be handled before Advance. Captured messages are enumerated via Messages
+// and consumed via TakeMsg, DropMsg, DropMsgs, ClearMessages, and Deliver.
+func (d *Driver) Ready() (rd raft.Ready, hasWork bool) {
+	rd = d.RawNode.Ready()
+	if len(rd.Messages) > 0 {
+		d.cache.Add(rd.Messages...)
+		rd.Messages = nil
+	}
+	hasWork = len(rd.Entries) > 0 || len(rd.CommittedEntries) > 0 ||
+		!raft.IsEmptySnap(rd.Snapshot) || !raft.IsEmptyHardState(rd.HardState)
+	return rd, hasWork
+}
+
+// Advance hands a Ready returned by Ready back to the underlying RawNode.
+func (d *Driver) Advance(rd raft.Ready) {
+	d.RawNode.Advance(rd)
+}
+
+// Len reports how many messages are currently captured.
+func (d *Driver) Len() int { return d.cache.Len() }
+
+// Messages returns an ordered snapshot of the captured messages.
+func (d *Driver) Messages() []pb.Message { return d.cache.Messages() }
+
+// TakeMsg removes and returns the first captured message matching pred,
+// together with its routing fields.
+func (d *Driver) TakeMsg(pred func(pb.Message) bool) (pb.Message, bool) {
+	return d.cache.TakeMsg(pred)
+}
+
+// DropMsg removes the first captured message matching pred without delivering
+// it. It reports whether a message was removed.
+func (d *Driver) DropMsg(pred func(pb.Message) bool) bool {
+	return d.cache.DropMsg(pred)
+}
+
+// DropMsgs removes every captured message matching pred and reports how many
+// were removed.
+func (d *Driver) DropMsgs(pred func(pb.Message) bool) int {
+	return d.cache.DropMsgs(pred)
+}
+
+// ClearMessages empties the capture cache.
+func (d *Driver) ClearMessages() { d.cache.Clear() }
+
+// Deliver removes the first captured message matching pred and steps it into
+// the target RawNode resolved by bind, which maps the message's routing
+// fields (typically To) to the test's own node objects. This is the combined
+// single-call injection form: the cache entry is located, the target is bound
+// and validated, the message enters the normal protocol input boundary
+// (*raft.RawNode).Step, and the cache is updated.
+//
+// Cache effects: if no message matches, the cache is unchanged and
+// ErrNoMessage is returned; if bind returns nil, the cache is unchanged and an
+// error is returned; otherwise the message is removed before Step runs and a
+// Step error is returned without restoring the entry.
+func (d *Driver) Deliver(pred func(pb.Message) bool, bind func(pb.Message) *raft.RawNode) error {
+	if bind == nil {
+		return fmt.Errorf("rafttest: nil target binding")
+	}
+	idx := firstMatch(d.cache.msgs, pred)
+	if idx < 0 {
+		return ErrNoMessage
+	}
+	msg := d.cache.msgs[idx]
+	target := bind(msg)
+	if target == nil {
+		return fmt.Errorf("rafttest: no target node for message %s", raft.DescribeMessage(msg, defaultEntryFormatter))
+	}
+	d.cache.msgs = append(d.cache.msgs[:idx], d.cache.msgs[idx+1:]...)
+	return target.Step(msg)
+}
diff --git a/rafttest/interaction_env_cache.go b/rafttest/interaction_env_cache.go
new file mode 100644
index 0000000..128e661
--- /dev/null
+++ b/rafttest/interaction_env_cache.go
@@ -0,0 +1,105 @@
+// Copyright 2024 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"fmt"
+
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+// TakeMsg removes from env.Messages and returns the first in-flight message
+// for which pred returns true, preserving message order. It reports false when
+// no in-flight message matches. The returned message is the exact captured
+// instance with its routing fields (From, To, Type); the test can deliver it
+// through the normal protocol input boundary, e.g. env.Nodes[To-1].Step (or
+// env.Step).
+func (env *InteractionEnv) TakeMsg(pred func(pb.Message) bool) (pb.Message, bool) {
+	idx := firstMatch(env.Messages, pred)
+	if idx < 0 {
+		return pb.Message{}, false
+	}
+	msg := env.Messages[idx]
+	env.Messages = append(env.Messages[:idx], env.Messages[idx+1:]...)
+	return msg, true
+}
+
+// DropMsg removes from env.Messages the first message matching pred without
+// delivering it. It reports whether a message was removed.
+func (env *InteractionEnv) DropMsg(pred func(pb.Message) bool) bool {
+	idx := firstMatch(env.Messages, pred)
+	if idx < 0 {
+		return false
+	}
+	env.Messages = append(env.Messages[:idx], env.Messages[idx+1:]...)
+	return true
+}
+
+// DropMsgs removes from env.Messages every message matching pred without
+// delivering them and reports how many were removed.
+func (env *InteractionEnv) DropMsgs(pred func(pb.Message) bool) int {
+	kept := env.Messages[:0]
+	var dropped int
+	for _, m := range env.Messages {
+		if pred(m) {
+			dropped++
+		} else {
+			kept = append(kept, m)
+		}
+	}
+	env.Messages = kept
+	return dropped
+}
+
+// ClearMessages removes all in-flight messages from env.Messages.
+func (env *InteractionEnv) ClearMessages() {
+	env.Messages = nil
+}
+
+// Step delivers an in-flight message into the node that owns its destination,
+// env.Nodes[To-1], through the normal protocol input boundary
+// (*raft.RawNode).Step. It is the separated-form input call for messages taken
+// from the cache with TakeMsg: Step does not touch env.Messages itself. It
+// returns an error when no node owns the destination or when the node rejects
+// the message.
+func (env *InteractionEnv) Step(msg pb.Message) error {
+	if msg.To == 0 || msg.To > uint64(len(env.Nodes)) {
+		return fmt.Errorf("rafttest: no node with id %d (have %d nodes)", msg.To, len(env.Nodes))
+	}
+	return env.Nodes[int(msg.To)-1].Step(msg)
+}
+
+// DeliverMsg removes from env.Messages the first message matching pred and
+// steps it into the node that owns its destination, env.Nodes[To-1]. This is
+// the combined single-call injection form: the cache entry is located, the
+// target is validated against the env's nodes, the message enters the normal
+// protocol input boundary, and the cache is updated.
+//
+// Cache effects: if no message matches, the cache is unchanged and
+// ErrNoMessage is returned; if no node owns the destination, the cache is
+// unchanged and an error is returned; otherwise the message is removed before
+// Step runs and a Step error is returned without restoring the entry.
+func (env *InteractionEnv) DeliverMsg(pred func(pb.Message) bool) error {
+	idx := firstMatch(env.Messages, pred)
+	if idx < 0 {
+		return ErrNoMessage
+	}
+	msg := env.Messages[idx]
+	if msg.To == 0 || msg.To > uint64(len(env.Nodes)) {
+		return fmt.Errorf("rafttest: no node with id %d (have %d nodes)", msg.To, len(env.Nodes))
+	}
+	env.Messages = append(env.Messages[:idx], env.Messages[idx+1:]...)
+	return env.Nodes[int(msg.To)-1].Step(msg)
+}
diff --git a/rafttest/message_cache.go b/rafttest/message_cache.go
new file mode 100644
index 0000000..8eae8bb
--- /dev/null
+++ b/rafttest/message_cache.go
@@ -0,0 +1,148 @@
+// Copyright 2024 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"errors"
+
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+// ErrNoMessage is returned by the exact-instance cache operations when no
+// cached message matches the selection predicate.
+var ErrNoMessage = errors.New("rafttest: no cached message matches")
+
+// MessageCache retains outbound protocol messages until a test action takes,
+// drops, clears, or delivers them. It is the capture cache for message paths
+// that hand the outbound messages to the caller (the Ready returned by
+// RawNode.Ready and the Ready received from the Node.Ready channel): the test
+// adds the Ready.Messages it received, and continuation (delivery) is then
+// owned by the cache until the test acts.
+type MessageCache struct {
+	msgs []pb.Message
+}
+
+// NewMessageCache returns an empty MessageCache.
+func NewMessageCache() *MessageCache {
+	return &MessageCache{}
+}
+
+// Add retains msgs in order at the end of the cache.
+func (c *MessageCache) Add(msgs ...pb.Message) {
+	c.msgs = append(c.msgs, msgs...)
+}
+
+// Len reports the number of retained messages.
+func (c *MessageCache) Len() int {
+	return len(c.msgs)
+}
+
+// Messages returns an ordered snapshot of the retained messages. The returned
+// messages are deep copies: mutating them cannot affect the cache or the
+// protocol state they were captured from.
+func (c *MessageCache) Messages() []pb.Message {
+	out := make([]pb.Message, len(c.msgs))
+	for i := range c.msgs {
+		out[i] = cloneMessage(c.msgs[i])
+	}
+	return out
+}
+
+// TakeMsg removes and returns the first retained message for which pred
+// returns true, together with its routing fields (From, To, Type). It reports
+// false when no retained message matches. The returned message is the exact
+// captured instance: ownership moves from the cache to the caller.
+func (c *MessageCache) TakeMsg(pred func(pb.Message) bool) (pb.Message, bool) {
+	idx := firstMatch(c.msgs, pred)
+	if idx < 0 {
+		return pb.Message{}, false
+	}
+	msg := c.msgs[idx]
+	c.msgs = append(c.msgs[:idx], c.msgs[idx+1:]...)
+	return msg, true
+}
+
+// DropMsg removes the first retained message matching pred without delivering
+// it. It reports whether a message was removed.
+func (c *MessageCache) DropMsg(pred func(pb.Message) bool) bool {
+	idx := firstMatch(c.msgs, pred)
+	if idx < 0 {
+		return false
+	}
+	c.msgs = append(c.msgs[:idx], c.msgs[idx+1:]...)
+	return true
+}
+
+// DropMsgs removes every retained message matching pred and reports how many
+// were removed.
+func (c *MessageCache) DropMsgs(pred func(pb.Message) bool) int {
+	kept := c.msgs[:0]
+	var dropped int
+	for _, m := range c.msgs {
+		if pred(m) {
+			dropped++
+		} else {
+			kept = append(kept, m)
+		}
+	}
+	c.msgs = kept
+	return dropped
+}
+
+// Clear removes all retained messages.
+func (c *MessageCache) Clear() {
+	c.msgs = nil
+}
+
+func firstMatch(msgs []pb.Message, pred func(pb.Message) bool) int {
+	for i := range msgs {
+		if pred(msgs[i]) {
+			return i
+		}
+	}
+	return -1
+}
+
+// cloneMessage deep-copies a message so that snapshot enumeration does not
+// expose mutable aliases into the cache: the slice fields (Entries, Context,
+// Responses, and the Snapshot payload and ConfState) are copied.
+func cloneMessage(m pb.Message) pb.Message {
+	if len(m.Entries) > 0 {
+		ents := make([]pb.Entry, len(m.Entries))
+		for i := range m.Entries {
+			ents[i] = m.Entries[i]
+			ents[i].Data = append([]byte(nil), m.Entries[i].Data...)
+		}
+		m.Entries = ents
+	}
+	m.Context = append([]byte(nil), m.Context...)
+	if m.Snapshot != nil {
+		snap := *m.Snapshot
+		snap.Data = append([]byte(nil), m.Snapshot.Data...)
+		snap.Metadata.ConfState.Voters = append([]uint64(nil), m.Snapshot.Metadata.ConfState.Voters...)
+		snap.Metadata.ConfState.Learners = append([]uint64(nil), m.Snapshot.Metadata.ConfState.Learners...)
+		snap.Metadata.ConfState.VotersOutgoing = append([]uint64(nil), m.Snapshot.Metadata.ConfState.VotersOutgoing...)
+		snap.Metadata.ConfState.LearnersNext = append([]uint64(nil), m.Snapshot.Metadata.ConfState.LearnersNext...)
+		m.Snapshot = &snap
+	}
+	if len(m.Responses) > 0 {
+		resps := make([]pb.Message, len(m.Responses))
+		for i := range m.Responses {
+			resps[i] = cloneMessage(m.Responses[i])
+		}
+		m.Responses = resps
+	}
+	return m
+}
