+// limitations under the License.
+
+package raft
+
+import "testing"
+
+// TestRandomizedElectionTimeoutDefault checks that, without the
+// Config.RandomizedElectionTimeout override, the randomized election timeout
+// is drawn from [electionTimeout, 2*electionTimeout) and re-drawn on role
+// transitions.
+func TestRandomizedElectionTimeoutDefault(t *testing.T) {
+	c := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+	r := newRaft(c)
+
+	if got := r.randomizedElectionTimeout; got < r.electionTimeout || got >= 2*r.electionTimeout {
+		t.Fatalf("randomized election timeout %d out of range [%d, %d)", got, r.electionTimeout, 2*r.electionTimeout)
+	}
+
+	r.becomeCandidate()
+	if got := r.randomizedElectionTimeout; got < r.electionTimeout || got >= 2*r.electionTimeout {
+		t.Fatalf("after becomeCandidate: randomized election timeout %d out of range [%d, %d)", got, r.electionTimeout, 2*r.electionTimeout)
+	}
+}
+
+// TestConfigRandomizedElectionTimeoutOverride checks that
+// Config.RandomizedElectionTimeout pins the randomized election timeout and
+// that the pinned value survives every role transition (i.e. every reset that
+// would otherwise re-randomize it).
+func TestConfigRandomizedElectionTimeoutOverride(t *testing.T) {
+	c := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+	c.RandomizedElectionTimeout = 13
+	r := newRaft(c)
+
+	if got := r.randomizedElectionTimeout; got != 13 {
+		t.Fatalf("expected randomized election timeout 13, got %d", got)
+	}
+
+	r.becomeFollower(r.Term, None)
+	if got := r.randomizedElectionTimeout; got != 13 {
+		t.Fatalf("after becomeFollower: expected randomized election timeout 13, got %d", got)
+	}
+	r.becomeCandidate()
+	if got := r.randomizedElectionTimeout; got != 13 {
+		t.Fatalf("after becomeCandidate: expected randomized election timeout 13, got %d", got)
+	}
+	r.becomePreCandidate()
+	if got := r.randomizedElectionTimeout; got != 13 {
+		t.Fatalf("after becomePreCandidate: expected randomized election timeout 13, got %d", got)
+	}
+	r.becomeLeader()
+	if got := r.randomizedElectionTimeout; got != 13 {
+		t.Fatalf("after becomeLeader: expected randomized election timeout 13, got %d", got)
+	}
+}
+
+// TestConfigRandomizedElectionTimeoutDeterminism checks that two RawNodes
+// created from identical configs with Config.RandomizedElectionTimeout set
+// campaign at exactly the configured tick and converge to identical status.
+func TestConfigRandomizedElectionTimeoutDeterminism(t *testing.T) {
+	const election = 10
+
+	newNode := func() *RawNode {
+		c := newTestConfig(1, election, 1, newTestMemoryStorage(withPeers(1)))
+		c.RandomizedElectionTimeout = election
+		rn, err := NewRawNode(c)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return rn
+	}
+
+	a, b := newNode(), newNode()
+	for i := 0; i < election-1; i++ {
+		a.Tick()
+		b.Tick()
+	}
+	if got := a.BasicStatus().RaftState; got != StateFollower {
+		t.Fatalf("expected node a to still be a follower after %d ticks, got %v", election-1, got)
+	}
+	a.Tick()
+	b.Tick()
+	if got := a.BasicStatus().RaftState; got != StateCandidate {
+		t.Fatalf("expected node a to campaign exactly at tick %d, got %v", election, got)
+	}
+	if got := a.BasicStatus(); got != b.BasicStatus() {
+		t.Fatalf("identically configured nodes diverged after campaigning:\na: %+v\nb: %+v", got, b.BasicStatus())
+	}
+	// Complete the elections by handling Ready/Advance (which steps each
+	// node's self vote back into it) and verify the nodes converge again.
+	for _, rn := range []*RawNode{a, b} {
+		rd := rn.Ready()
+		rn.Advance(rd)
+	}
+	if got := a.BasicStatus().RaftState; got != StateLeader {
+		t.Fatalf("expected node a to become leader after handling Ready, got %v", got)
+	}
+	if got := a.BasicStatus(); got != b.BasicStatus() {
+		t.Fatalf("identically configured nodes diverged after election:\na: %+v\nb: %+v", got, b.BasicStatus())
+	}
+}
