+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// PendingMessage is a protocol message parked in an env's pending store at the
+// time it was produced by a node. The ID is a stable control-plane identity
+// assigned at capture time; it is unique within the pending store of the
+// capturing env and is not derived from any protocol field (term, index, type,
+// or payload).
+type PendingMessage struct {
+	// ID is the stable control-plane identity assigned at capture time.
+	ID uint64
+	// Msg is the captured protocol message with sender and receiver intact.
+	Msg raftpb.Message
+}
+
+// capturePending parks msgs in the env's pending store, assigning stable
+// control-plane IDs at capture time, and mirrors them into the in-flight
+// Messages queue so that the existing delivery machinery (DeliverMsgs,
+// Stabilize) consumes them. Messages captured this way never continue along
+// their original path: they are only delivered when explicitly handed to a
+// node's Step entrypoint via DeliverMsgs.
+func (env *InteractionEnv) capturePending(msgs []raftpb.Message) {
+	for _, m := range msgs {
+		env.nextPendingID++
+		env.pending = append(env.pending, PendingMessage{ID: env.nextPendingID, Msg: m})
+	}
+	env.Messages = append(env.Messages, msgs...)
+}
+
+// ListPending returns a copy of the messages currently parked in the env's
+// pending store, in capture order. Each entry carries a stable control-plane ID
+// assigned at capture time (PendingMessage.ID) plus the full message: sender in
+// Msg.From, receiver in Msg.To, and message type in Msg.Type. The returned
+// slice is a copy; modifying it does not affect the env.
+func (env *InteractionEnv) ListPending() []PendingMessage {
+	out := make([]PendingMessage, len(env.pending))
+	copy(out, env.pending)
+	return out
+}
+
+// ClearPending removes all messages from the env's pending store and from the
+// in-flight Messages queue. Cleared messages are never delivered.
+func (env *InteractionEnv) ClearPending() {
+	env.pending = nil
+	env.Messages = nil
+}
+
+// splitPending extracts the pending records for the given recipient of the
+// given type (-1 for all types) from pend, mirroring splitMsgs. It returns the
+// extracted records along with the remainder.
+func splitPending(pend []PendingMessage, to uint64, typ raftpb.MessageType, drop bool) (toPend []PendingMessage, rmdr []PendingMessage) {
+	// NB: this method does not reorder messages.
+	for _, p := range pend {
+		if p.Msg.To == to && !(drop && isLocalMsg(p.Msg)) && (typ < 0 || p.Msg.Type == typ) {
+			toPend = append(toPend, p)
+		} else {
+			rmdr = append(rmdr, p)
+		}
+	}
+	return toPend, rmdr
+}
diff --git a/rafttest/pending_msgs_test.go b/rafttest/pending_msgs_test.go
new file mode 100644
index 0000000..5c93d5c
--- /dev/null
+++ b/rafttest/pending_msgs_test.go
@@ -0,0 +1,148 @@
+// Copyright 2024 The etcd Authors
