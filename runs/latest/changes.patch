+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package raft
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// TestConfigRandomizedElectionTimeoutValidation verifies that
+// Config.RandomizedElectionTimeout preserves the legal domain of the
+// randomized election timeout, [ElectionTick, 2*ElectionTick-1], and rejects
+// any value outside of it instead of silently creating an impossible state.
+func TestConfigRandomizedElectionTimeoutValidation(t *testing.T) {
+	const wantErr = "randomized election timeout must be in [election tick, 2 * election tick - 1]"
+	tests := []struct {
+		name      string
+		election  int
+		heartbeat int
+		fixed     int
+		wantErr   string
+	}{
+		{"zero keeps randomized default", 10, 5, 0, ""},
+		{"lower bound", 10, 5, 10, ""},
+		{"upper bound", 10, 5, 19, ""},
+		{"mid range", 10, 5, 15, ""},
+		{"below lower bound", 10, 5, 9, wantErr},
+		{"above upper bound", 10, 5, 20, wantErr},
+		{"negative", 10, 5, -1, wantErr},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg := &Config{
+				ID:                        1,
+				ElectionTick:              tt.election,
+				HeartbeatTick:             tt.heartbeat,
+				Storage:                   NewMemoryStorage(),
+				MaxSizePerMsg:             noLimit,
+				MaxInflightMsgs:           256,
+				RandomizedElectionTimeout: tt.fixed,
+			}
+			err := cfg.validate()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.EqualError(t, err, tt.wantErr)
+		})
+	}
+}
+
+// TestFixedRandomizedElectionTimeout verifies that a Config-fixed randomized
+// election timeout is used at startup and survives every state reset that
+// would normally draw a new random value.
+func TestFixedRandomizedElectionTimeout(t *testing.T) {
+	cfg := newTestConfig(1, 10, 5, newTestMemoryStorage(withPeers(1)))
+	cfg.RandomizedElectionTimeout = 15
+	r := newRaft(cfg)
+	require.Equal(t, 15, r.randomizedElectionTimeout)
+
+	// Resets (becomeFollower / becomeCandidate) keep the fixed value.
+	r.becomeFollower(2, None)
+	require.Equal(t, 15, r.randomizedElectionTimeout)
+	r.becomeCandidate()
+	require.Equal(t, 15, r.randomizedElectionTimeout)
+	r.becomeFollower(3, 1)
+	require.Equal(t, 15, r.randomizedElectionTimeout)
+}
+
+// TestDefaultRandomizedElectionTimeout verifies that the default (zero) value
+// keeps drawing the randomized election timeout from its legal domain.
+func TestDefaultRandomizedElectionTimeout(t *testing.T) {
+	r := newTestRaft(1, 10, 5, newTestMemoryStorage(withPeers(1)))
+	require.GreaterOrEqual(t, r.randomizedElectionTimeout, 10)
+	require.LessOrEqual(t, r.randomizedElectionTimeout, 19)
+}
+
+// TestFixedRandomizedElectionTimeoutTick verifies end-to-end determinism
+// through the public RawNode.Tick entrypoint: with a fixed timeout, the
+// election fires at exactly the configured tick and never before.
+func TestFixedRandomizedElectionTimeoutTick(t *testing.T) {
+	storage := newTestMemoryStorage(withPeers(1))
+	cfg := newTestConfig(1, 10, 5, storage)
+	cfg.RandomizedElectionTimeout = 10
+	rn, err := NewRawNode(cfg)
+	require.NoError(t, err)
+
+	for i := 0; i < 9; i++ {
+		rn.Tick()
+		require.Equal(t, StateFollower, rn.raft.state, "expected follower at tick %d", i+1)
+	}
+	rn.Tick()
+	require.Equal(t, StateCandidate, rn.raft.state, "election must fire at exactly tick 10")
+}
