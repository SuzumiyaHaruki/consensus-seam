+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package raft
+
+import (
+	"testing"
+)
+
+// TestConfigRandomizedElectionTimeoutValidation verifies the legal domain of
+// Config.RandomizedElectionTimeout: zero means "randomize as before", and any
+// non-zero value must lie within [ElectionTick, 2*ElectionTick-1].
+func TestConfigRandomizedElectionTimeoutValidation(t *testing.T) {
+	storage := NewMemoryStorage()
+	base := newTestConfig(1, 10, 1, storage)
+
+	for _, v := range []int{0, 10, 15, 19} {
+		cfg := *base
+		cfg.RandomizedElectionTimeout = v
+		if err := cfg.validate(); err != nil {
+			t.Fatalf("RandomizedElectionTimeout=%d: unexpected error: %v", v, err)
+		}
+	}
+	for _, v := range []int{-1, 9, 20} {
+		cfg := *base
+		cfg.RandomizedElectionTimeout = v
+		if err := cfg.validate(); err == nil {
+			t.Fatalf("RandomizedElectionTimeout=%d: expected validation error", v)
+		}
+	}
+}
+
+// TestRandomizedElectionTimeoutFixedSurvivesStateChanges ensures that a fixed
+// Config.RandomizedElectionTimeout is honored by reset() on every state
+// change, unlike the transient test-only setter.
+func TestRandomizedElectionTimeoutFixedSurvivesStateChanges(t *testing.T) {
+	cfg := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+	cfg.RandomizedElectionTimeout = 13
+	sm := newRaft(cfg)
+	if sm.randomizedElectionTimeout != 13 {
+		t.Fatalf("initial randomizedElectionTimeout = %d, want 13", sm.randomizedElectionTimeout)
+	}
+	sm.becomeCandidate()
+	if sm.randomizedElectionTimeout != 13 {
+		t.Fatalf("after becomeCandidate randomizedElectionTimeout = %d, want 13", sm.randomizedElectionTimeout)
+	}
+	sm.becomeLeader()
+	if sm.randomizedElectionTimeout != 13 {
+		t.Fatalf("after becomeLeader randomizedElectionTimeout = %d, want 13", sm.randomizedElectionTimeout)
+	}
+	sm.becomeFollower(sm.Term+1, None)
+	if sm.randomizedElectionTimeout != 13 {
+		t.Fatalf("after becomeFollower randomizedElectionTimeout = %d, want 13", sm.randomizedElectionTimeout)
+	}
+}
+
+// TestRandomizedElectionTimeoutDeterministicElection verifies end-to-end
+// determinism through RawNode: with the timeout fixed at the minimum
+// (ElectionTick), the election fires on exactly the ElectionTick-th Tick.
+func TestRandomizedElectionTimeoutDeterministicElection(t *testing.T) {
+	cfg := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+	cfg.RandomizedElectionTimeout = 10
+	rn, err := NewRawNode(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 9; i++ {
+		rn.Tick()
+		if st := rn.Status().RaftState; st != StateFollower {
+			t.Fatalf("tick %d: state = %v, want StateFollower", i+1, st)
+		}
+	}
+	rn.Tick()
+	if st := rn.Status().RaftState; st == StateFollower {
+		t.Fatalf("tick 10: election did not fire, state = %v", st)
+	}
+}
+
+// TestRandomizedElectionTimeoutDefaultRange checks that the default (zero)
+// configuration still draws from the documented
+// [ElectionTick, 2*ElectionTick-1] range.
+func TestRandomizedElectionTimeoutDefaultRange(t *testing.T) {
+	cfg := newTestConfig(1, 10, 1, NewMemoryStorage())
+	sm := newRaft(cfg)
+	if v := sm.randomizedElectionTimeout; v < 10 || v > 19 {
+		t.Fatalf("randomizedElectionTimeout = %d, want in [10, 19]", v)
+	}
+}
