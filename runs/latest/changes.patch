+package rafttest
+
+import (
+	"testing"
+
+	"github.com/cockroachdb/datadriven"
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+)
+
+// TestAddNodesRandomizedElectionTimeout verifies that the add-nodes command
+// accepts a randomized-election-timeout argument and that the fixed value
+// makes election timing deterministic: with the raftConfigStub's ElectionTick
+// of 3, a fixed timeout of 5 fires the election on exactly the 5th tick.
+func TestAddNodesRandomizedElectionTimeout(t *testing.T) {
+	env := NewInteractionEnv(nil)
+	d := datadriven.TestData{
+		Cmd: "add-nodes",
+		CmdArgs: []datadriven.CmdArg{
+			{Key: "1"},
+			{Key: "voters", Vals: []string{"1"}},
+			{Key: "index", Vals: []string{"2"}},
+			{Key: "randomized-election-timeout", Vals: []string{"5"}},
+		},
+	}
+	if err := env.handleAddNodes(t, d); err != nil {
+		t.Fatal(err)
+	}
+	require.Equal(t, 5, env.Nodes[0].Config.RandomizedElectionTimeout)
+
+	env.Tick(0, 4)
+	require.Equal(t, raft.StateFollower, env.Nodes[0].RawNode.Status().RaftState)
+	env.Tick(0, 1)
+	require.NotEqual(t, raft.StateFollower, env.Nodes[0].RawNode.Status().RaftState)
+}
