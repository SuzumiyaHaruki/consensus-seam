+package rafttest
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// TestInteractionEnvFixedRandomizedElectionTimeout verifies the rafttest path
+// for randomness control: fixing Config.RandomizedElectionTimeout through
+// InteractionOpts.OnConfig makes election timing deterministic for every node
+// created by the env.
+func TestInteractionEnvFixedRandomizedElectionTimeout(t *testing.T) {
+	env := NewInteractionEnv(&InteractionOpts{
+		OnConfig: func(c *raft.Config) {
+			c.RandomizedElectionTimeout = c.ElectionTick
+		},
+	})
+	cfg := raftConfigStub()
+	snap := raftpb.Snapshot{
+		Metadata: raftpb.SnapshotMetadata{
+			ConfState: raftpb.ConfState{Voters: []uint64{1, 2, 3}},
+			Index:     2,
+		},
+	}
+	require.NoError(t, env.AddNodes(3, cfg, snap))
+
+	// ElectionTick - 1 ticks never trigger an election...
+	require.NoError(t, env.Tick(1, cfg.ElectionTick-1))
+	require.Equal(t, raft.StateFollower, env.Nodes[1].Status().RaftState)
+
+	// ...and the ElectionTick-th tick always does, on every run.
+	require.NoError(t, env.Tick(1, 1))
+	require.Equal(t, raft.StateCandidate, env.Nodes[1].Status().RaftState)
+
+	// The fixed value is part of the stored per-node Config, so it survives
+	// node restart (which rebuilds the RawNode from this Config).
+	require.Equal(t, cfg.ElectionTick, env.Nodes[1].Config.RandomizedElectionTimeout)
+}
