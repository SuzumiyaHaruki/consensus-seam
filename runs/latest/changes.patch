+// limitations under the License.
+
+package rafttest
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// electAndCommit drives the given 3-node env to a stable state with node 1 as
+// leader and one committed entry, and returns the committed (and applied)
+// index that all nodes agree on.
+func electAndCommit(t *testing.T, env *InteractionEnv) uint64 {
+	t.Helper()
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.Stabilize())
+	require.Equal(t, raft.StateLeader, env.Nodes[0].Status().RaftState)
+
+	require.NoError(t, env.Propose(0, []byte("foo")))
+	require.NoError(t, env.Stabilize())
+
+	commit := env.Nodes[0].Status().Commit
+	for i := range env.Nodes {
+		st := env.Nodes[i].Status()
+		require.Equal(t, commit, st.Commit)
+		require.Equal(t, commit, st.Applied)
+	}
+	return commit
+}
+
+// TestInteractionEnvStopRestart exercises the lifecycle facade: a node is
+// stopped (volatile state discarded, storage preserved), the remaining nodes
+// keep making progress while it is down, and the stopped node is restarted
+// from its storage and catches back up.
+func TestInteractionEnvStopRestart(t *testing.T) {
+	env := newMessageEnv(t)
+	commit := electAndCommit(t, env)
+
+	// Stop node 2 (index 1).
+	require.NoError(t, env.StopNode(1))
+	require.True(t, env.Nodes[1].Stopped)
+	require.Nil(t, env.Nodes[1].RawNode)
+	require.Error(t, env.StopNode(1))    // already stopped
+	require.Error(t, env.RestartNode(0)) // not stopped
+	require.Error(t, env.StopNode(99))   // out of range
+
+	// No env operation may drive the stopped node's protocol state.
+	require.Error(t, env.ProcessReady(1))
+	require.Error(t, env.ProcessAppendThread(1))
+	require.Error(t, env.ProcessApplyThread(1))
+	require.Error(t, env.Tick(1, 1))
+	require.Error(t, env.Campaign(1))
+	require.Error(t, env.Propose(1, []byte("x")))
+	require.Error(t, env.ProposeConfChange(1, raftpb.ConfChange{Type: raftpb.ConfChangeAddNode, NodeID: 4}))
+	require.Error(t, env.Compact(1, 3))
+	require.Error(t, env.Status(1))
+	require.Error(t, env.SendSnapshot(1, 2))
+	require.Panics(t, func() { env.ForgetLeader(1) })
+
+	// The stable log of the stopped node remains readable, and raft-state
+	// reports the node as stopped.
+	require.NoError(t, env.RaftLog(1))
+	require.Equal(t, commit, env.Nodes[1].History[len(env.Nodes[1].History)-1].Metadata.Index)
+	require.NoError(t, env.handleRaftState())
+	require.Contains(t, env.Output.String(), "2: stopped")
+
+	// The remaining nodes keep making progress while node 2 is down.
+	require.NoError(t, env.Propose(0, []byte("bar")))
+	require.NoError(t, env.ProcessReady(0))
+	require.Equal(t, 1, env.DeliverMsgs(-1, Recipient{ID: 3}))
+	// Delivery to the stopped node is refused; its message stays in the cache.
+	require.Equal(t, 0, env.DeliverMsgs(-1, Recipient{ID: 2}))
+	require.Len(t, env.EnumerateMessages(), 1)
+	require.Equal(t, uint64(2), env.EnumerateMessages()[0].Msg.To)
+	require.NoError(t, env.ProcessReady(2))
+	require.Equal(t, 1, env.DeliverMsgs(-1, Recipient{ID: 1}))
+	require.NoError(t, env.ProcessReady(0))
+	require.Greater(t, env.Nodes[0].Status().Commit, commit)
+
+	// Restart node 2: term, commit and applied are restored from storage, and
+	// no already-applied entry is re-applied.
+	require.NoError(t, env.RestartNode(1))
+	require.False(t, env.Nodes[1].Stopped)
+	require.NotNil(t, env.Nodes[1].RawNode)
+	st := env.Nodes[1].Status()
+	require.Equal(t, uint64(1), st.Term)
+	require.Equal(t, commit, st.Commit)
+	require.Equal(t, commit, st.Applied)
+	require.Equal(t, commit, env.Nodes[1].History[len(env.Nodes[1].History)-1].Metadata.Index)
+
+	// Deliver the messages left in flight and let the restarted node catch up.
+	env.DeliverMsgs(-1, Recipient{ID: 2})
+	require.NoError(t, env.Stabilize())
+
+	// The whole group is back in agreement.
+	c0 := env.Nodes[0].Status().Commit
+	require.Equal(t, c0, env.Nodes[1].Status().Commit)
+	require.Equal(t, c0, env.Nodes[2].Status().Commit)
+	require.Equal(t, c0, env.Nodes[1].Status().Applied)
+	require.Equal(t, env.Nodes[1].History, env.Nodes[2].History)
+}
