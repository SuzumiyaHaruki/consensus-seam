+
+package rafttest
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/cockroachdb/datadriven"
+
+	"go.etcd.io/raft/v3"
+)
+
+func (env *InteractionEnv) handleStopNode(t *testing.T, d datadriven.TestData) error {
+	idx := firstAsNodeIdx(t, d)
+	return env.StopNode(idx)
+}
+
+// StopNode makes the node at the given index unavailable by discarding all of
+// its volatile in-memory state: the RawNode (and with it the raft state
+// machine, the randomized election timeout, and any in-flight storage work)
+// is dropped. This mirrors the stop semantics of the internal network harness
+// (rafttest/node.go): "All in memory state of node is discarded. All stable
+// MUST be unchanged."
+//
+// The node's Storage (log entries, HardState, snapshot) and its Config are
+// preserved: RaftLog keeps working on a stopped node, and RestartNode
+// reconstructs the node from them. While a node is stopped, env operations
+// that would drive its protocol state (ProcessReady, Tick, Campaign, Propose,
+// DeliverMsgs to it, and so on) fail with an error, and messages in flight
+// addressed to it remain in the message cache until it is restarted.
+//
+// StopNode is an availability simulation only. It does not model crash
+// durability, fsync, or process supervision; the application's Storage
+// implementation owns any persistence semantics.
+func (env *InteractionEnv) StopNode(idx int) error {
+	if idx < 0 || idx >= len(env.Nodes) {
+		return fmt.Errorf("node index %d out of range", idx)
+	}
+	n := &env.Nodes[idx]
+	if n.Stopped {
+		return fmt.Errorf("node %d is already stopped", n.Config.ID)
+	}
+	// Record the applied index so that RestartNode can restore it from the
+	// config: committed entries that were already applied before the stop
+	// must not be re-applied by the test's state machine afterwards.
+	n.Config.Applied = n.BasicStatus().Applied
+	n.Stopped = true
+	n.RawNode = nil // discard volatile state
+	n.AppendWork = nil
+	n.ApplyWork = nil
+	return nil
+}
+
+func (env *InteractionEnv) handleRestartNode(t *testing.T, d datadriven.TestData) error {
+	idx := firstAsNodeIdx(t, d)
+	return env.RestartNode(idx)
+}
+
+// RestartNode makes the stopped node at the given index available again by
+// constructing a fresh RawNode from the node's Config, which shares the same
+// Storage the node used before it was stopped. The HardState (term, vote,
+// commit index), the log, the membership and the applied index are restored
+// from stable storage; volatile state such as elapsed tick counters, leader
+// knowledge, and in-flight messages starts fresh, exactly like the internal
+// harness's restart. Restarting a node that is not stopped is an error.
+func (env *InteractionEnv) RestartNode(idx int) error {
+	if idx < 0 || idx >= len(env.Nodes) {
+		return fmt.Errorf("node index %d out of range", idx)
+	}
+	n := &env.Nodes[idx]
+	if !n.Stopped {
+		return fmt.Errorf("node %d is not stopped", n.Config.ID)
+	}
+	rn, err := raft.NewRawNode(n.Config)
+	if err != nil {
+		return err
+	}
+	n.RawNode = rn
+	n.Stopped = false
+	return nil
+}
+
+// checkNodeRunning returns an error if the node at the given index is
+// currently stopped. It is the guard used by every env operation that would
+// drive the node's protocol state.
+func (env *InteractionEnv) checkNodeRunning(idx int) error {
+	if env.Nodes[idx].Stopped {
+		return fmt.Errorf("node %d is stopped; restart it with RestartNode before driving it again", env.Nodes[idx].Config.ID)
+	}
+	return nil
+}
