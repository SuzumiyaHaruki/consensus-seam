+package rafttest
+
+import (
+	"fmt"
+
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// InjectByID selects the pending message with the given stable control-plane ID
+// from the env's pending store (see ListPending) and delivers it through the
+// normal protocol input entrypoint of its recorded recipient: the recipient is
+// bound to the env node env.Nodes[Msg.To-1] and the message is handed to that
+// node's RawNode.Step unchanged, so sender (Msg.From), receiver (Msg.To), and
+// content are preserved. The delivered message is returned unchanged.
+//
+// Only the selected message is consumed: after a successful delivery it is
+// removed from the pending store and from the in-flight Messages queue, so it
+// cannot be delivered again by DeliverMsgs or Stabilize. If no pending message
+// carries the given ID, or the recipient node is not part of the env, an error
+// is returned and nothing is consumed. If the recipient's Step entrypoint
+// returns an error, the target's existing error semantics are preserved: the
+// error is returned and the message is left pending so that the caller can
+// retry it, drop it (DeliverMsgs with Drop), or discard it (ClearPending).
+func (env *InteractionEnv) InjectByID(id uint64) (raftpb.Message, error) {
+	idx := -1
+	for i := range env.pending {
+		if env.pending[i].ID == id {
+			idx = i
+			break
+		}
+	}
+	if idx == -1 {
+		return raftpb.Message{}, fmt.Errorf("no pending message with ID %d", id)
+	}
+	p := env.pending[idx]
+	toIdx := int(p.Msg.To - 1)
+	if toIdx < 0 || toIdx >= len(env.Nodes) {
+		return raftpb.Message{}, fmt.Errorf("pending message %d targets node %d, which is not part of the env", id, p.Msg.To)
+	}
+	// Deliver through the normal protocol input entrypoint of the recipient,
+	// preserving the captured message unchanged.
+	if err := env.Nodes[toIdx].Step(p.Msg); err != nil {
+		return p.Msg, err
+	}
+	// Consume only the selected message. env.pending and env.Messages remain
+	// aligned (capturePending appends the same messages to both, and
+	// DeliverMsgs/ClearPending remove from both), so the pending index is also
+	// the Messages index.
+	env.pending = append(env.pending[:idx], env.pending[idx+1:]...)
+	env.Messages = append(env.Messages[:idx], env.Messages[idx+1:]...)
+	return p.Msg, nil
+}
+
+// injectByID selects the captured message with the given stable control-plane
+// ID from the node's pending store (capture mode only; see startNodeWithCapture)
+// and delivers it through the normal protocol input entrypoint of its recorded
+// recipient: the message is routed via the node's iface into the recipient's
+// receive queue, which the recipient's run loop feeds into Node.Step. Only the
+// selected message is consumed from the node's pending store; sender, receiver,
+// and content are preserved, and the delivered message is returned unchanged.
+//
+// Delivery is asynchronous and follows the harness's existing network
+// semantics: like any other iface.send, the message can be dropped when the
+// recipient is disconnected, matches a dropmap entry, or has a full receive
+// queue. Returns an error if no captured message carries the given ID.
+func (n *node) injectByID(id uint64) (raftpb.Message, error) {
+	n.mu.Lock()
+	idx := -1
+	for i := range n.captured {
+		if n.captured[i].ID == id {
+			idx = i
+			break
+		}
+	}
+	if idx == -1 {
+		n.mu.Unlock()
+		return raftpb.Message{}, fmt.Errorf("no captured message with ID %d", id)
+	}
+	p := n.captured[idx]
+	n.captured = append(n.captured[:idx], n.captured[idx+1:]...)
+	n.mu.Unlock()
+
+	// Route the message through the existing iface; the recipient's run loop
+	// consumes it and hands it to Node.Step, the normal protocol input.
+	n.iface.send(p.Msg)
+	return p.Msg, nil
+}
