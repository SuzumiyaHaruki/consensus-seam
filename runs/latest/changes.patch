+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// newMessageEnv builds a 3-node InteractionEnv bootstrapped like the
+// datadriven tests (voters 1,2,3, snapshot index 2).
+func newMessageEnv(t *testing.T) *InteractionEnv {
+	t.Helper()
+	env := NewInteractionEnv(nil)
+	cfg := raftConfigStub()
+	snap := raftpb.Snapshot{
+		Metadata: raftpb.SnapshotMetadata{
+			ConfState: raftpb.ConfState{Voters: []uint64{1, 2, 3}},
+			Index:     2,
+		},
+	}
+	require.NoError(t, env.AddNodes(3, cfg, snap))
+	return env
+}
+
+// TestInteractionEnvMessageCaptureAndInject exercises the full message
+// control seam: capture via ProcessReady, per-instance enumeration, exact
+// take, and cache-linked injection through the normal protocol input.
+func TestInteractionEnvMessageCaptureAndInject(t *testing.T) {
+	env := newMessageEnv(t)
+
+	// Activation: candidate 1 emits one MsgVote per peer into the cache.
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+	msgs := env.EnumerateMessages()
+	require.Len(t, msgs, 2)
+	require.Equal(t, raftpb.MsgVote, msgs[0].Msg.Type)
+	require.Equal(t, raftpb.MsgVote, msgs[1].Msg.Type)
+
+	// Selection is by target-native content; the handle is the reference.
+	var voteTo2, voteTo3 EnvMessage
+	for _, em := range msgs {
+		switch em.Msg.To {
+		case 2:
+			voteTo2 = em
+		case 3:
+			voteTo3 = em
+		default:
+			t.Fatalf("unexpected MsgVote destination %d", em.Msg.To)
+		}
+	}
+
+	// Take removes exactly the referenced instance.
+	taken, ok := env.TakeMessage(voteTo3.Handle)
+	require.True(t, ok)
+	require.Equal(t, raftpb.MsgVote, taken.Type)
+	require.Equal(t, uint64(3), taken.To)
+	require.Len(t, env.EnumerateMessages(), 1)
+	_, ok = env.TakeMessage(voteTo3.Handle) // stale now
+	require.False(t, ok)
+
+	// Inject delivers the remaining cached message to its cached
+	// destination (node 2) through RawNode.Step.
+	require.NoError(t, env.InjectMessage(voteTo2.Handle))
+	require.Len(t, env.EnumerateMessages(), 0)
+	// The follower cast its vote for the candidate.
+	require.Equal(t, raft.StateFollower, env.Nodes[1].Status().RaftState)
+	require.Equal(t, uint64(1), env.Nodes[1].Status().Term)
+
+	// The follower's response is captured the same way and injected back,
+	// electing the candidate.
+	require.NoError(t, env.ProcessReady(1))
+	msgs = env.EnumerateMessages()
+	require.Len(t, msgs, 1)
+	require.Equal(t, raftpb.MsgVoteResp, msgs[0].Msg.Type)
+	require.Equal(t, uint64(1), msgs[0].Msg.To)
+	require.NoError(t, env.InjectMessage(msgs[0].Handle))
+	require.Len(t, env.EnumerateMessages(), 0)
+	require.Equal(t, uint64(1), env.Nodes[0].Status().Lead)
+}
+
+// TestInteractionEnvMessageHandleDuplicateInstances checks that two
+// equal-valued cached messages are separately addressable and that all
+// existing mutation paths keep outstanding handles consistent.
+func TestInteractionEnvMessageHandleDuplicateInstances(t *testing.T) {
+	env := NewInteractionEnv(nil)
+	dup := raftpb.Message{Type: raftpb.MsgHeartbeat, From: 1, To: 2, Term: 3}
+	env.appendMessages(dup, dup)
+
+	msgs := env.EnumerateMessages()
+	require.Len(t, msgs, 2)
+	require.Equal(t, dup, msgs[0].Msg)
+	require.Equal(t, dup, msgs[1].Msg)
+	require.NotEqual(t, msgs[0].Handle, msgs[1].Handle)
+
+	// Removing one instance leaves the other addressable.
+	require.True(t, env.DropMessage(msgs[0].Handle))
+	require.Len(t, env.EnumerateMessages(), 1)
+	got, ok := env.TakeMessage(msgs[1].Handle)
+	require.True(t, ok)
+	require.Equal(t, dup, got)
+	require.Len(t, env.EnumerateMessages(), 0)
+
+	// DeliverMsgs (bulk path) invalidates handles of handled messages.
+	env.appendMessages(dup, dup)
+	handles := env.EnumerateMessages()
+	require.Equal(t, 2, env.DeliverMsgs(-1, Recipient{ID: 2, Drop: true}))
+	_, ok = env.TakeMessage(handles[0].Handle)
+	require.False(t, ok)
+	_, ok = env.TakeMessage(handles[1].Handle)
+	require.False(t, ok)
+
+	// ClearMessages invalidates everything.
+	env.appendMessages(dup)
+	h := env.EnumerateMessages()[0].Handle
+	require.Equal(t, 1, env.ClearMessages())
+	require.False(t, env.DropMessage(h))
+	require.Len(t, env.EnumerateMessages(), 0)
+}
+
+// TestInteractionEnvMessageSnapshotSafety verifies that enumerated and
+// taken messages are deep copies that cannot mutate cache or protocol state.
+func TestInteractionEnvMessageSnapshotSafety(t *testing.T) {
+	env := NewInteractionEnv(nil)
+	orig := raftpb.Message{
+		Type:    raftpb.MsgSnap,
+		From:    1,
+		To:      2,
+		Term:    3,
+		Context: []byte("ctx"),
+		Entries: []raftpb.Entry{{Term: 1, Index: 5, Type: raftpb.EntryNormal, Data: []byte("data")}},
+		Snapshot: &raftpb.Snapshot{
+			Data:     []byte("snap"),
+			Metadata: raftpb.SnapshotMetadata{Index: 5, Term: 1},
+		},
+	}
+	env.appendMessages(orig, orig)
+
+	ems := env.EnumerateMessages()
+	require.Len(t, ems, 2)
+	require.Equal(t, orig, ems[0].Msg)
+	// Mutate every mutable part of the snapshot.
+	ems[0].Msg.Context[0] = 'X'
+	ems[0].Msg.Entries[0].Data[0] = 'X'
+	ems[0].Msg.Snapshot.Data[0] = 'X'
+	require.Equal(t, orig, env.EnumerateMessages()[1].Msg)
+
+	taken, ok := env.TakeMessage(ems[1].Handle)
+	require.True(t, ok)
+	require.Equal(t, orig, taken)
+	taken.Entries[0].Data[0] = 'Y'
+	taken.Snapshot.Data[0] = 'Y'
+	taken.Context[0] = 'Y'
+	// The cache still holds the first, unmutated instance.
+	require.Equal(t, orig, env.EnumerateMessages()[0].Msg)
+}
+
+// TestInteractionEnvInjectMessageErrors checks the error and cache-effect
+// contract of InjectMessage.
+func TestInteractionEnvInjectMessageErrors(t *testing.T) {
+	env := newMessageEnv(t)
+	other := NewInteractionEnv(nil)
+
+	msg := raftpb.Message{Type: raftpb.MsgVote, From: 1, To: 99, Term: 1}
+	env.appendMessages(msg)
+	h := env.EnumerateMessages()[0].Handle
+
+	// Unknown destination: error, message stays cached.
+	require.Error(t, env.InjectMessage(h))
+	require.Len(t, env.EnumerateMessages(), 1)
+
+	// Handle from another env: rejected.
+	other.appendMessages(msg)
+	oh := other.EnumerateMessages()[0].Handle
+	require.Error(t, env.InjectMessage(oh))
+	require.Len(t, env.EnumerateMessages(), 1)
+}
diff --git a/rafttest/interaction_env_handler.go b/rafttest/interaction_env_handler.go
index 2ffec2b..96ccc97 100644
