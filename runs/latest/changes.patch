diff --git a/rafttest/interaction_env_handle.go b/rafttest/interaction_env_handle.go
new file mode 100644
index 0000000..a7b4e06
--- /dev/null
+++ b/rafttest/interaction_env_handle.go
@@ -0,0 +1,177 @@
+// Copyright 2024 The etcd Authors
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package rafttest
+
+import (
+	"fmt"
+
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// MessageHandle is an opaque reference to one concrete message instance in
+// an InteractionEnv's message cache. Handles are obtained from
+// EnumerateMessages and remain valid until the referenced message is
+// consumed by TakeMessage or InjectMessage, removed by DropMessage or
+// ClearMessages, or delivered/dropped via DeliverMsgs. A handle obtained
+// from one InteractionEnv is not valid for another env. Two cached messages
+// with identical content always receive distinct handles.
+type MessageHandle struct {
+	env *InteractionEnv
+	id  uint64
+}
+
+// EnvMessage pairs one cached message instance with its stable handle. Msg
+// is a snapshot copy: mutating it (including its slice fields) does not
+// affect the cache or the underlying raft state.
+type EnvMessage struct {
+	Handle MessageHandle
+	Msg    raftpb.Message
+}
+
+// EnumerateMessages returns a snapshot of the currently cached messages in
+// cache order, each paired with a stable handle for later per-instance
+// operations. The returned messages are deep copies and are safe to mutate.
+func (env *InteractionEnv) EnumerateMessages() []EnvMessage {
+	msgs := make([]EnvMessage, len(env.Messages))
+	for i, m := range env.Messages {
+		msgs[i] = EnvMessage{
+			Handle: MessageHandle{env: env, id: env.msgIDs[i]},
+			Msg:    cloneMessage(m),
+		}
+	}
+	return msgs
+}
+
+// TakeMessage removes the cached message referenced by h from the cache and
+// returns a snapshot copy of it. The second return value is false if h does
+// not reference a currently cached message (for example because it was
+// already consumed, dropped, cleared, or delivered).
+func (env *InteractionEnv) TakeMessage(h MessageHandle) (raftpb.Message, bool) {
+	i := env.indexOf(h)
+	if i < 0 {
+		return raftpb.Message{}, false
+	}
+	m := env.Messages[i]
+	env.removeIndex(i)
+	return cloneMessage(m), true
+}
+
+// DropMessage removes the cached message referenced by h from the cache
+// without delivering it anywhere. It reports whether a message was removed.
+func (env *InteractionEnv) DropMessage(h MessageHandle) bool {
+	i := env.indexOf(h)
+	if i < 0 {
+		return false
+	}
+	env.removeIndex(i)
+	return true
+}
+
+// InjectMessage removes the cached message referenced by h from the cache
+// and delivers it through the normal protocol input boundary: the message
+// is stepped into env.Nodes[msg.To-1], preserving sender, receiver, and
+// content. On success the message is gone from the cache. If Step reports a
+// synchronous error the message has already been removed from the cache and
+// the error is returned; retry/requeue/loss policy is left to the test. If
+// the cached destination is out of range, an error is returned and the
+// message stays in the cache.
+func (env *InteractionEnv) InjectMessage(h MessageHandle) error {
+	i := env.indexOf(h)
+	if i < 0 {
+		return fmt.Errorf("message handle does not reference a cached message")
+	}
+	m := env.Messages[i]
+	toIdx := int(m.To - 1)
+	if toIdx < 0 || toIdx >= len(env.Nodes) {
+		return fmt.Errorf("cached message targets unknown node %d", m.To)
+	}
+	if env.Nodes[toIdx].Stopped {
+		// The destination is down; keep the message in the cache so that it
+		// can be delivered after the node is restarted.
+		return fmt.Errorf("cached message targets stopped node %d", m.To)
+	}
+	env.removeIndex(i)
+	if err := env.Nodes[toIdx].Step(m); err != nil {
+		return err
+	}
+	return nil
+}
+
+// ClearMessages removes all messages from the cache and returns the number
+// of messages removed. All outstanding handles become invalid.
+func (env *InteractionEnv) ClearMessages() int {
+	n := len(env.Messages)
+	env.Messages = nil
+	env.msgIDs = nil
+	return n
+}
+
+// indexOf returns the cache position of the message referenced by h, or -1.
+func (env *InteractionEnv) indexOf(h MessageHandle) int {
+	if h.env != env {
+		return -1
+	}
+	for i, id := range env.msgIDs {
+		if id == h.id {
+			return i
+		}
+	}
+	return -1
+}
+
+// removeIndex removes the cache entry at position i, keeping msgIDs aligned.
+func (env *InteractionEnv) removeIndex(i int) {
+	env.Messages = append(env.Messages[:i], env.Messages[i+1:]...)
+	env.msgIDs = append(env.msgIDs[:i], env.msgIDs[i+1:]...)
+}
+
+// appendMessages adds messages to the authoritative cache, assigning each a
+// fresh stable id. All in-package cache mutations must go through this
+// method (or the removal helpers) so that message handles stay consistent.
+func (env *InteractionEnv) appendMessages(msgs ...raftpb.Message) {
+	for _, m := range msgs {
+		env.nextMsgID++
+		env.msgIDs = append(env.msgIDs, env.nextMsgID)
+		env.Messages = append(env.Messages, m)
+	}
+}
+
+// cloneMessage returns a deep copy of m so that snapshots handed to tests
+// share no mutable storage (Entries, Context, Snapshot.Data, Responses)
+// with the cache or the raft state machine.
+func cloneMessage(m raftpb.Message) raftpb.Message {
+	m.Context = append([]byte(nil), m.Context...)
+	if m.Snapshot != nil {
+		s := *m.Snapshot
+		s.Data = append([]byte(nil), m.Snapshot.Data...)
+		m.Snapshot = &s
+	}
+	if len(m.Entries) > 0 {
+		ents := make([]raftpb.Entry, len(m.Entries))
+		for i := range m.Entries {
+			ents[i] = m.Entries[i]
+			ents[i].Data = append([]byte(nil), m.Entries[i].Data...)
+		}
+		m.Entries = ents
+	}
+	if len(m.Responses) > 0 {
+		resps := make([]raftpb.Message, len(m.Responses))
+		for i := range m.Responses {
+			resps[i] = cloneMessage(m.Responses[i])
+		}
+		m.Responses = resps
+	}
+	return m
+}
diff --git a/rafttest/interaction_env_handle_test.go b/rafttest/interaction_env_handle_test.go
