@@ -0,0 +1,105 @@
+package miniraft
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+)
+
+// ErrUnknownMessage reports an Inject call for an ID that is not pending.
+var ErrUnknownMessage = errors.New("mini-raft: no pending message with that ID")
+
+// MessageMeta describes one captured outbound message. The embedded Message is
+// the stable snapshot taken at capture time; the controlled transport never
+// mutates it.
+type MessageMeta struct {
+	// ID uniquely identifies the captured message within this transport.
+	ID string
+	// CaptureSequence is a strictly increasing counter in capture order.
+	CaptureSequence uint64
+	// Message is the stable clone captured before the original send path.
+	Message
+}
+
+// ControlledTransport is the test-mode capture/injection seam around a
+// Transport. Send captures every outbound message as a pending snapshot and
+// suppresses the original delivery path; Inject delivers a selected pending
+// message through the wrapped transport's normal protocol boundary. It does
+// not implement any scheduling policy.
+type ControlledTransport struct {
+	mu           sync.Mutex
+	wrapped      Transport
+	pending      []MessageMeta
+	nextSequence uint64
+}
+
+// NewControlledTransport wraps transport so outbound messages are captured
+// instead of delivered. Delivery happens only through Inject.
+func NewControlledTransport(transport Transport) *ControlledTransport {
+	return &ControlledTransport{wrapped: transport}
+}
+
+// Send captures message before the wrapped transport would see it and does
+// not forward it, so a captured message never continues automatically along
+// the original uncontrollable send path.
+func (transport *ControlledTransport) Send(message Message) error {
+	transport.mu.Lock()
+	defer transport.mu.Unlock()
+	transport.nextSequence++
+	transport.pending = append(transport.pending, MessageMeta{
+		ID:              fmt.Sprintf("%d", transport.nextSequence),
+		CaptureSequence: transport.nextSequence,
+		Message:         message.Clone(),
+	})
+	return nil
+}
+
+// ListPending returns stable copies of all captured, not-yet-injected
+// messages in capture order.
+func (transport *ControlledTransport) ListPending() []MessageMeta {
+	transport.mu.Lock()
+	defer transport.mu.Unlock()
+	result := make([]MessageMeta, len(transport.pending))
+	for index, meta := range transport.pending {
+		result[index] = MessageMeta{
+			ID:              meta.ID,
+			CaptureSequence: meta.CaptureSequence,
+			Message:         meta.Message.Clone(),
+		}
+	}
+	return result
+}
+
+// Inject delivers the pending message identified by id through the wrapped
+// transport, which routes it to the recorded target's normal Step boundary
+// without mutating the message content. The message is consumed only after
+// delivery succeeds; a failed delivery leaves it pending and returns the
+// delivery error unchanged.
+func (transport *ControlledTransport) Inject(id string) error {
+	transport.mu.Lock()
+	var snapshot Message
+	found := false
+	for _, meta := range transport.pending {
+		if meta.ID == id {
+			snapshot = meta.Message.Clone()
+			found = true
+			break
+		}
+	}
+	transport.mu.Unlock()
+	if !found {
+		return ErrUnknownMessage
+	}
+	if err := transport.wrapped.Send(snapshot); err != nil {
+		return err
+	}
+	transport.mu.Lock()
+	for index, meta := range transport.pending {
+		if meta.ID == id {
+			transport.pending = append(transport.pending[:index], transport.pending[index+1:]...)
+			break
+		}
+	}
+	transport.mu.Unlock()
+	return nil
+}
diff --git a/controlled_transport_test.go b/controlled_transport_test.go
new file mode 100644
index 0000000..2cd5aa3
--- /dev/null
+++ b/controlled_transport_test.go
@@ -0,0 +1,129 @@
+package miniraft
+
+import (
+	"errors"
+	"testing"
+)
+
+type failingTransport struct {
+	err error
+}
+
+func (transport failingTransport) Send(Message) error {
+	return transport.err
+}
+
+func newControlledCluster(t *testing.T) (map[uint64]*Node, *ControlledTransport) {
+	t.Helper()
+	network := NewMemoryTransport()
+	controlled := NewControlledTransport(network)
+	nodes := make(map[uint64]*Node)
+	for id := uint64(1); id <= 3; id++ {
+		peers := make([]uint64, 0, 2)
+		for peer := uint64(1); peer <= 3; peer++ {
+			if peer != id {
+				peers = append(peers, peer)
+			}
+		}
+		node, err := NewNode(Config{
+			ID: id, Peers: peers, ElectionTick: 4, HeartbeatTick: 1,
+			Transport: controlled,
+		})
+		if err != nil {
+			t.Fatalf("NewNode(%d): %v", id, err)
+		}
+		nodes[id] = node
+		network.Register(node)
+	}
+	return nodes, controlled
+}
+
+func tickUntilCaptured(t *testing.T, node *Node, controlled *ControlledTransport) []MessageMeta {
+	t.Helper()
+	for tick := 0; tick < 16; tick++ {
+		if err := node.Tick(); err != nil {
+			t.Fatalf("Tick: %v", err)
+		}
+		if pending := controlled.ListPending(); len(pending) > 0 {
+			return pending
+		}
+	}
+	t.Fatal("Tick did not produce a pending outbound message")
+	return nil
+}
+
+func TestControlledTransportCaptureAndSuppress(t *testing.T) {
+	nodes, controlled := newControlledCluster(t)
+	pending := tickUntilCaptured(t, nodes[1], controlled)
+	if len(pending) != 2 {
+		t.Fatalf("pending count = %d, want 2 vote requests", len(pending))
+	}
+	if pending[0].ID == pending[1].ID || pending[0].CaptureSequence >= pending[1].CaptureSequence {
+		t.Fatalf("message identity/order is not stable: %+v", pending)
+	}
+	for _, id := range []uint64{2, 3} {
+		if status := nodes[id].Status(); status.Term != 0 {
+			t.Fatalf("node %d processed a message before Inject: %+v", id, status)
+		}
+	}
+}
+
+func TestControlledTransportInjection(t *testing.T) {
+	nodes, controlled := newControlledCluster(t)
+	pending := tickUntilCaptured(t, nodes[1], controlled)
+	if len(pending) != 2 {
+		t.Fatalf("pending count = %d, want 2", len(pending))
+	}
+	first, second := pending[0], pending[1]
+	if second.To != 3 {
+		first, second = second, first
+	}
+	if second.To != 3 {
+		t.Fatalf("no pending request targets node 3: %+v", pending)
+	}
+	if err := controlled.Inject(second.ID); err != nil {
+		t.Fatalf("Inject(%q): %v", second.ID, err)
+	}
+	remaining := controlled.ListPending()
+	foundFirst := false
+	for _, message := range remaining {
+		if message.ID == second.ID {
+			t.Fatalf("injected message %q remains pending", second.ID)
+		}
+		if message.ID == first.ID {
+			foundFirst = true
+		}
+	}
+	if !foundFirst {
+		t.Fatalf("unselected message %q was consumed: %+v", first.ID, remaining)
+	}
+	if status := nodes[3].Status(); status.Term == 0 {
+		t.Fatalf("selected target did not process injected message: %+v", status)
+	}
+	if status := nodes[2].Status(); status.Term != 0 {
+		t.Fatalf("unselected target processed a message: %+v", status)
+	}
+
+	deliveryError := errors.New("injected delivery failed")
+	rejecting := NewControlledTransport(failingTransport{err: deliveryError})
+	if err := rejecting.Send(Message{
+		From: 1, To: 2, Type: MessageRequestVote, Term: 1,
+	}); err != nil {
+		t.Fatalf("capture before failed injection: %v", err)
+	}
+	failedPending := rejecting.ListPending()
+	if len(failedPending) != 1 {
+		t.Fatalf("pending before failed injection = %+v, want one", failedPending)
+	}
+	failedID := failedPending[0].ID
+	if err := rejecting.Inject(failedID); !errors.Is(err, deliveryError) {
+		t.Fatalf("Inject(%q) error = %v, want %v", failedID, err, deliveryError)
+	}
+	stillPending := rejecting.ListPending()
+	if len(stillPending) != 1 || stillPending[0].ID != failedID {
+		t.Fatalf("failed injection consumed pending message: %+v", stillPending)
+	}
+	if err := rejecting.Inject("does-not-exist"); !errors.Is(err, ErrUnknownMessage) {
+		t.Fatalf("unknown Inject error = %v, want %v", err, ErrUnknownMessage)
+	}
+}
