+// limitations under the License.
+
+package rafttest
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// TestInteractionEnvInjectByID verifies that InjectByID selects one captured
+// message by its stable control-plane ID, delivers it unchanged through the
+// recipient's normal protocol input entrypoint (RawNode.Step), and consumes
+// only that message.
+func TestInteractionEnvInjectByID(t *testing.T) {
+	env := twoNodeEnv(t)
+
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+
+	pend := env.ListPending()
+	require.Len(t, pend, 1)
+	require.Equal(t, raftpb.MsgVote, pend[0].Msg.Type)
+
+	delivered, err := env.InjectByID(pend[0].ID)
+	require.NoError(t, err)
+	// Sender, receiver, and content are preserved.
+	require.Equal(t, pend[0].Msg, delivered)
+	require.Equal(t, uint64(1), delivered.From)
+	require.Equal(t, uint64(2), delivered.To)
+
+	// Only the selected message was consumed: the store is now empty.
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+
+	// The message entered the protocol through Step: node 2 processed it.
+	require.Equal(t, uint64(1), env.Nodes[1].BasicStatus().HardState.Vote)
+}
+
+// TestInteractionEnvInjectByIDUnknownID verifies that an unknown ID leaves the
+// pending store and the in-flight Messages queue untouched.
+func TestInteractionEnvInjectByIDUnknownID(t *testing.T) {
+	env := twoNodeEnv(t)
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+	pend := env.ListPending()
+	require.Len(t, pend, 1)
+
+	_, err := env.InjectByID(pend[0].ID + 1)
+	require.Error(t, err)
+
+	require.Equal(t, pend, env.ListPending())
+	require.Len(t, env.Messages, 1)
+	require.Equal(t, uint64(0), env.Nodes[1].BasicStatus().HardState.Vote)
+}
+
+// TestInteractionEnvInjectByIDConsumesOnlySelected verifies that injecting one
+// of several pending messages consumes exactly that message and leaves the
+// others pending and injectable.
+func TestInteractionEnvInjectByIDConsumesOnlySelected(t *testing.T) {
+	snap := raftpb.Snapshot{
+		Metadata: raftpb.SnapshotMetadata{
+			ConfState: raftpb.ConfState{Voters: []uint64{1, 2, 3}},
+			Index:     2,
+		},
+	}
+	cfg := raftConfigStub()
+	cfg.Applied = snap.Metadata.Index
+	env := NewInteractionEnv(nil)
+	require.NoError(t, env.AddNodes(3, cfg, snap))
+
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+
+	pend := env.ListPending()
+	require.Len(t, pend, 2) // MsgVote to node 2 and node 3
+	vote2, vote3 := pend[0], pend[1]
+	require.Equal(t, uint64(2), vote2.Msg.To)
+	require.Equal(t, uint64(3), vote3.Msg.To)
+
+	delivered, err := env.InjectByID(vote2.ID)
+	require.NoError(t, err)
+	require.Equal(t, vote2.Msg, delivered)
+
+	// Only the selected message was consumed.
+	rem := env.ListPending()
+	require.Len(t, rem, 1)
+	require.Equal(t, vote3.ID, rem[0].ID)
+	require.Len(t, env.Messages, 1)
+	require.Equal(t, uint64(1), env.Nodes[1].BasicStatus().HardState.Vote) // node 2 voted
+	require.Equal(t, uint64(0), env.Nodes[2].BasicStatus().HardState.Vote) // node 3 has not
+
+	// The remaining captured message is still injectable.
+	delivered2, err := env.InjectByID(vote3.ID)
+	require.NoError(t, err)
+	require.Equal(t, vote3.Msg, delivered2)
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+	require.Equal(t, uint64(1), env.Nodes[2].BasicStatus().HardState.Vote)
+}
+
+// TestInteractionEnvInjectByIDAsyncStorageWrites verifies injection on the
+// async-storage-writes path: storage-thread response messages are captured in
+// the same pending store and are injectable by ID through the same entrypoint,
+// entering the protocol via the recipient's RawNode.Step.
+func TestInteractionEnvInjectByIDAsyncStorageWrites(t *testing.T) {
+	snap := raftpb.Snapshot{
+		Metadata: raftpb.SnapshotMetadata{
+			ConfState: raftpb.ConfState{Voters: []uint64{1, 2}},
+			Index:     2,
+		},
+	}
+	cfg := raftConfigStub()
+	cfg.Applied = snap.Metadata.Index
+	cfg.AsyncStorageWrites = true
+	env := NewInteractionEnv(nil)
+	require.NoError(t, env.AddNodes(2, cfg, snap))
+
+	// Node 1 campaigns. ProcessReady parks the MsgVote (ID 1) and moves the
+	// MsgStorageAppend to the append thread.
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+	pend := env.ListPending()
+	require.Len(t, pend, 1)
+	require.Equal(t, raftpb.MsgVote, pend[0].Msg.Type)
+
+	// Running the append thread captures the storage response (ID 2).
+	require.NoError(t, env.ProcessAppendThread(0))
+	pend = env.ListPending()
+	require.Len(t, pend, 2)
+	require.Equal(t, raftpb.MsgVoteResp, pend[1].Msg.Type)
+	require.Equal(t, uint64(1), pend[1].Msg.To)
+
+	// Inject the captured MsgVote into node 2 and the self-vote response
+	// into node 1, then process node 2's Ready and append thread, which
+	// captures node 2's MsgVoteResp (ID 3).
+	delivered, err := env.InjectByID(pend[0].ID)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), delivered.To)
+	delivered, err = env.InjectByID(pend[1].ID)
+	require.NoError(t, err)
+	require.Equal(t, uint64(1), delivered.To)
+	require.NoError(t, env.ProcessReady(1))
+	require.NoError(t, env.ProcessAppendThread(1))
+	pend = env.ListPending()
+	require.Len(t, pend, 1)
+	require.Equal(t, raftpb.MsgVoteResp, pend[0].Msg.Type)
+	require.Equal(t, uint64(2), pend[0].Msg.From)
+	require.Equal(t, uint64(1), pend[0].Msg.To)
+
+	// Inject node 2's vote response into node 1: with the self-vote from the
+	// storage response (already injected) and node 2's vote, node 1 wins
+	// the election.
+	delivered, err = env.InjectByID(pend[0].ID)
+	require.NoError(t, err)
+	require.Equal(t, uint64(2), delivered.From)
+	require.Equal(t, uint64(1), delivered.To)
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+	require.Equal(t, uint64(1), env.Nodes[0].Status().Lead)
+}
+
+// TestNodeInjectByID exercises injection on the Node async goroutine path: the
+// captured message is selected by ID from the node's pending store and routed
+// through the existing iface into the recipient's Node.Step.
+func TestNodeInjectByID(t *testing.T) {
+	peers := []raft.Peer{{ID: 1}, {ID: 2}}
+	nt := newRaftNetwork(1, 2)
+	n1 := startNodeWithCapture(1, peers, nt.nodeNetwork(1))
+	n2 := startNodeWithCapture(2, peers, nt.nodeNetwork(2))
+	// Keep n2 from ticking (and thus from campaigning) until the injected
+	// vote arrives: while paused it buffers the injected message and steps
+	// it through Node.Step on resume.
+	n2.pause()
+	defer n1.stop()
+	defer n2.stop()
+
+	// Node 1 eventually campaigns (its first campaign is refused until the
+	// initial configuration-change entries are applied) and its MsgVote is
+	// parked in its pending store with a stable ID.
+	require.Eventually(t, func() bool {
+		pend := n1.listPending()
+		return len(pend) > 0 && pend[0].Msg.Type == raftpb.MsgVote
+	}, 5*time.Second, 10*time.Millisecond)
+	vote := n1.listPending()[0]
+
+	delivered, err := n1.injectByID(vote.ID)
+	require.NoError(t, err)
+	// Sender, receiver, and content are preserved.
+	require.Equal(t, vote.Msg, delivered)
+	require.Equal(t, uint64(1), delivered.From)
+	require.Equal(t, uint64(2), delivered.To)
+
+	// Only the selected message was consumed from the node's store.
+	for _, p := range n1.listPending() {
+		require.NotEqual(t, vote.ID, p.ID)
+	}
+
+	// Resuming n2 delivers the buffered vote through its normal protocol
+	// input entrypoint (Node.Step), and node 2 grants it.
+	n2.resume()
+	require.Eventually(t, func() bool {
+		return n2.Status().HardState.Vote == 1
+	}, 5*time.Second, 10*time.Millisecond)
+}
