@@ -192,6 +192,24 @@ func (env *InteractionEnv) Handle(t *testing.T, d datadriven.TestData) string {
 		// Example:
 		// report-unreachable 1 2
 		err = env.handleReportUnreachable(t, d)
+	case "stop-node":
+		// Make a node unavailable by discarding all of its volatile in-memory
+		// state. The node's stable Storage (log, HardState, snapshot) is
