+// limitations under the License.
+
+package rafttest
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"go.etcd.io/raft/v3"
+	"go.etcd.io/raft/v3/raftpb"
+)
+
+// twoNodeEnv returns a fresh InteractionEnv with two voters (IDs 1 and 2)
+// bootstrapped at index 2.
+func twoNodeEnv(t *testing.T) *InteractionEnv {
+	t.Helper()
+	snap := raftpb.Snapshot{
+		Metadata: raftpb.SnapshotMetadata{
+			ConfState: raftpb.ConfState{Voters: []uint64{1, 2}},
+			Index:     2,
+		},
+	}
+	cfg := raftConfigStub()
+	cfg.Applied = snap.Metadata.Index
+	env := NewInteractionEnv(nil)
+	require.NoError(t, env.AddNodes(2, cfg, snap))
+	return env
+}
+
+// TestInteractionEnvCapturePending exercises the pending capture store on the
+// RawNode synchronous path: ProcessReady parks protocol output with stable
+// control-plane IDs, the captured message does not continue automatically, and
+// DeliverMsgs consumes exactly the delivered message.
+func TestInteractionEnvCapturePending(t *testing.T) {
+	env := twoNodeEnv(t)
+	require.Empty(t, env.ListPending())
+
+	// Node 1 campaigns; the resulting MsgVote is protocol output of node 1.
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+
+	pend := env.ListPending()
+	require.Len(t, pend, 1)
+	p := pend[0]
+	require.Equal(t, uint64(1), p.ID) // first capture in this env
+	require.Equal(t, raftpb.MsgVote, p.Msg.Type)
+	require.Equal(t, uint64(1), p.Msg.From)
+	require.Equal(t, uint64(2), p.Msg.To)
+
+	// The captured message must not continue along its original path: it is
+	// still pending and node 2 has not seen it.
+	require.Len(t, env.ListPending(), 1)
+	require.Equal(t, uint64(0), env.Nodes[1].BasicStatus().HardState.Vote) // not voted
+
+	// Delivering the captured message consumes it from the pending store.
+	env.DeliverMsgs(-1 /* typ */, Recipient{ID: 2})
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+}
+
+// TestInteractionEnvClearPending verifies that ClearPending discards captured
+// messages so that they are never delivered.
+func TestInteractionEnvClearPending(t *testing.T) {
+	env := twoNodeEnv(t)
+
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+	require.NotEmpty(t, env.ListPending())
+
+	env.ClearPending()
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+
+	// Stabilization must not deliver the cleared messages.
+	require.NoError(t, env.Stabilize())
+	require.Empty(t, env.ListPending())
+	require.Empty(t, env.Messages)
+}
+
+// TestInteractionEnvCaptureOrder verifies that IDs are assigned at capture time
+// and increase across captures, and that messages captured from different
+// nodes share one store.
+func TestInteractionEnvCaptureOrder(t *testing.T) {
+	env := twoNodeEnv(t)
+
+	// Node 1 campaigns and its MsgVote is captured first (ID 1).
+	require.NoError(t, env.Campaign(0))
+	require.NoError(t, env.ProcessReady(0))
+
+	// Deliver the vote to node 2 and process node 2's Ready: the MsgVoteResp
+	// produced by node 2 is captured next (ID 2).
+	env.DeliverMsgs(-1 /* typ */, Recipient{ID: 2})
+	require.NoError(t, env.ProcessReady(1))
+
+	pend := env.ListPending()
+	require.Len(t, pend, 1)
+	require.Equal(t, raftpb.MsgVoteResp, pend[0].Msg.Type)
+	require.Equal(t, uint64(2), pend[0].ID)
+	require.Equal(t, uint64(2), pend[0].Msg.From)
+	require.Equal(t, uint64(1), pend[0].Msg.To)
+
+	// ListPending returns a defensive copy: mutating it must not affect the
+	// env's store.
+	pend[0].ID = 999
+	require.Equal(t, uint64(2), env.ListPending()[0].ID)
+}
+
+// TestNodeCapturePending exercises the Node async goroutine path: the rafttest
+// node harness parks Ready-loop output in its pending store (with stable
+// control-plane IDs) instead of sending it over the network.
+func TestNodeCapturePending(t *testing.T) {
+	peers := []raft.Peer{{ID: 1}, {ID: 2}}
+	nt := newRaftNetwork(1, 2)
+	n := startNodeWithCapture(1, peers, nt.nodeNetwork(1))
+
+	require.NoError(t, n.Campaign(context.TODO()))
+
+	require.Eventually(t, func() bool {
+		return len(n.listPending()) > 0
+	}, 5*time.Second, 10*time.Millisecond)
+
+	pend := n.listPending()
+	require.Equal(t, raftpb.MsgVote, pend[0].Msg.Type)
+	require.Equal(t, uint64(1), pend[0].Msg.From)
+	require.Equal(t, uint64(2), pend[0].Msg.To)
+	for i := 1; i < len(pend); i++ {
+		require.Greater(t, pend[i].ID, pend[i-1].ID)
+	}
+
+	n.stop()
+	n.clearPending()
+	require.Empty(t, n.listPending())
+}
