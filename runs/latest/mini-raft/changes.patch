@@ -0,0 +1,227 @@
+package miniraft
+
+import (
+	"errors"
+	"testing"
+)
+
+// newControllerCluster builds a 3-node cluster whose outbound messages flow
+// through a MessageController (capture + suppression) while the nodes are
+// registered with the wrapped MemoryTransport so Inject can resolve targets.
+func newControllerCluster(t *testing.T) (*MessageController, *MemoryTransport, map[uint64]*Node) {
+	t.Helper()
+	transport := NewMemoryTransport()
+	controller := NewMessageController(transport)
+	nodes := make(map[uint64]*Node)
+	for id := uint64(1); id <= 3; id++ {
+		peers := make([]uint64, 0, 2)
+		for peer := uint64(1); peer <= 3; peer++ {
+			if peer != id {
+				peers = append(peers, peer)
+			}
+		}
+		node, err := NewNode(Config{
+			ID: id, Peers: peers, ElectionTick: 4, HeartbeatTick: 1,
+			Transport: controller,
+		})
+		if err != nil {
+			t.Fatalf("NewNode(%d): %v", id, err)
+		}
+		nodes[id] = node
+		transport.Register(node)
+	}
+	return controller, transport, nodes
+}
+
+func TestMessageControllerCaptureAndSuppress(t *testing.T) {
+	controller, transport, nodes := newControllerCluster(t)
+	for tick := 0; tick < 8; tick++ {
+		for id := uint64(1); id <= 3; id++ {
+			if err := nodes[id].Tick(); err != nil {
+				t.Fatalf("Tick(%d): %v", id, err)
+			}
+		}
+	}
+	pending := controller.ListPending()
+	if len(pending) == 0 {
+		t.Fatal("expected captured messages, got none")
+	}
+	if delivered := transport.Delivered(); len(delivered) != 0 {
+		t.Fatalf("capture must suppress the original send, got %d delivered", len(delivered))
+	}
+	seen := make(map[uint64]bool)
+	for index, p := range pending {
+		if p.ID == 0 || p.From == 0 || p.To == 0 || p.Type == "" || p.CaptureSequence == 0 {
+			t.Fatalf("pending[%d] has incomplete metadata: %+v", index, p)
+		}
+		if seen[p.ID] {
+			t.Fatalf("duplicate pending ID %d", p.ID)
+		}
+		seen[p.ID] = true
+	}
+	// The metadata is stable across calls.
+	again := controller.ListPending()
+	if len(again) != len(pending) {
+		t.Fatalf("ListPending not stable: %d vs %d", len(again), len(pending))
+	}
+}
+
+func TestMessageControllerClearPending(t *testing.T) {
+	controller, _, nodes := newControllerCluster(t)
+	for tick := 0; tick < 8; tick++ {
+		for id := uint64(1); id <= 3; id++ {
+			if err := nodes[id].Tick(); err != nil {
+				t.Fatalf("Tick(%d): %v", id, err)
+			}
+		}
+	}
+	if len(controller.ListPending()) == 0 {
+		t.Fatal("expected pending messages before ClearPending")
+	}
+	controller.ClearPending()
+	if got := controller.ListPending(); len(got) != 0 {
+		t.Fatalf("ClearPending left %d messages pending", len(got))
+	}
+}
+
+func TestMessageControllerInjectUnknownID(t *testing.T) {
+	controller, _, _ := newControllerCluster(t)
+	if err := controller.Inject(424242); !errors.Is(err, ErrUnknownMessageID) {
+		t.Fatalf("Inject(unknown) error = %v, want %v", err, ErrUnknownMessageID)
+	}
+}
+
+func TestMessageControllerInjectFailedDeliveryKeepsPending(t *testing.T) {
+	controller, _, nodes := newControllerCluster(t)
+	nodes[3].Pause()
+	message := Message{From: 1, To: 3, Type: MessageAppendEntries, Term: 1}
+	if err := controller.Send(message); err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+	pending := controller.ListPending()
+	if len(pending) != 1 {
+		t.Fatalf("expected 1 pending message, got %d", len(pending))
+	}
+	id := pending[0].ID
+	if err := controller.Inject(id); !errors.Is(err, ErrPaused) {
+		t.Fatalf("Inject error = %v, want %v", err, ErrPaused)
+	}
+	remaining := controller.ListPending()
+	if len(remaining) != 1 || remaining[0].ID != id {
+		t.Fatalf("failed injection must keep the message pending: %+v", remaining)
+	}
+}
+
+func TestMessageControllerInjectExactDelivery(t *testing.T) {
+	controller, transport, nodes := newControllerCluster(t)
+
+	// Drive node 1 into a campaign; its request votes are captured.
+	for tick := 0; tick < 16 && nodes[1].Status().Role != RoleCandidate; tick++ {
+		if err := nodes[1].Tick(); err != nil {
+			t.Fatalf("Tick: %v", err)
+		}
+	}
+	if role := nodes[1].Status().Role; role != RoleCandidate {
+		t.Fatalf("node 1 did not campaign, role = %s", role)
+	}
+
+	// Inject the captured request votes into the followers.
+	for {
+		pending := controller.ListPending()
+		injected := false
+		for _, p := range pending {
+			if p.Type == MessageRequestVote && p.From == 1 {
+				if err := controller.Inject(p.ID); err != nil {
+					t.Fatalf("Inject(request vote %d): %v", p.ID, err)
+				}
+				injected = true
+				break
+			}
+		}
+		if !injected {
+			break
+		}
+	}
+	// Inject the followers' vote responses back to node 1.
+	for {
+		pending := controller.ListPending()
+		injected := false
+		for _, p := range pending {
+			if p.Type == MessageRequestVoteResponse && p.To == 1 {
+				if err := controller.Inject(p.ID); err != nil {
+					t.Fatalf("Inject(vote response %d): %v", p.ID, err)
+				}
+				injected = true
+				break
+			}
+		}
+		if !injected {
+			break
+		}
+	}
+	if role := nodes[1].Status().Role; role != RoleLeader {
+		t.Fatalf("node 1 did not become leader, role = %s", role)
+	}
+
+	// Drop the leadership heartbeats, then propose so the only pending
+	// append_entries messages carry the proposal entry.
+	controller.ClearPending()
+	if err := nodes[1].Propose([]byte("exact")); err != nil {
+		t.Fatalf("Propose: %v", err)
+	}
+
+	var targetID uint64
+	for _, p := range controller.ListPending() {
+		if p.Type == MessageAppendEntries && p.To == 3 {
+			targetID = p.ID
+			break
+		}
+	}
+	if targetID == 0 {
+		t.Fatalf("no append_entries to node 3 captured: %+v", controller.ListPending())
+	}
+
+	if before := nodes[3].Status().LastIndex; before != 0 {
+		t.Fatalf("node 3 should start at LastIndex 0, got %d", before)
+	}
+	if err := controller.Inject(targetID); err != nil {
+		t.Fatalf("Inject(append_entries %d): %v", targetID, err)
+	}
+	if after := nodes[3].Status().LastIndex; after != 1 {
+		t.Fatalf("node 3 LastIndex = %d after injection, want 1", after)
+	}
+	// The injected message was consumed.
+	for _, p := range controller.ListPending() {
+		if p.ID == targetID {
+			t.Fatalf("injected message %d still pending", targetID)
+		}
+	}
+	// Capture-only mode never touched the wrapped transport.
+	if delivered := transport.Delivered(); len(delivered) != 0 {
+		t.Fatalf("wrapped transport must stay untouched, got %d delivered", len(delivered))
+	}
+}
+
+func TestMessageControllerRegisterResolvesTarget(t *testing.T) {
+	controller := NewMessageController(nil)
+	node, err := NewNode(Config{ID: 1, Peers: []uint64{2}, ElectionTick: 4, HeartbeatTick: 1, Transport: controller})
+	if err != nil {
+		t.Fatalf("NewNode: %v", err)
+	}
+	controller.Register(node)
+	message := Message{From: 2, To: 1, Type: MessageRequestVote, Term: 1}
+	if err := controller.Send(message); err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+	pending := controller.ListPending()
+	if len(pending) != 1 {
+		t.Fatalf("expected 1 pending message, got %d", len(pending))
+	}
+	if err := controller.Inject(pending[0].ID); err != nil {
+		t.Fatalf("Inject: %v", err)
+	}
+	status := node.Status()
+	if status.Vote != 2 || status.Term != 1 {
+		t.Fatalf("injected request vote not processed: %+v", status)
+	}
+}
