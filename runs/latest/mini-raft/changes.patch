@@ -0,0 +1,173 @@
+package miniraft
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+)
+
+// ErrUnknownMessageID is returned by MessageController.Inject when no pending
+// message carries the requested ID.
+var ErrUnknownMessageID = errors.New("mini-raft: no pending message with the given id")
+
+// PendingMessage is the stable metadata of one captured outbound protocol
+// message held by a MessageController. ListPending returns value copies, so
+// the metadata is stable across calls and independent of later mutation.
+type PendingMessage struct {
+	ID              uint64
+	From            uint64
+	To              uint64
+	Type            MessageType
+	CaptureSequence uint64
+}
+
+// capturedMessage pairs the public metadata with the stable message snapshot.
+type capturedMessage struct {
+	meta PendingMessage
+	msg  Message
+}
+
+// nodeProvider is implemented by transports that can resolve their registered
+// nodes by ID; MessageController uses it to find injection targets.
+type nodeProvider interface {
+	Node(id uint64) *Node
+}
+
+// MessageController is the test-mode message-control seam around a Transport.
+//
+// It is active immediately after construction: every outbound Send is captured
+// as a stable snapshot and suppressed, so no message continues into the wrapped
+// transport's original send path until a test injects it. Capture happens
+// before the original send; the wrapped transport is never called for a
+// captured message.
+//
+// Controller operations (Inject, ClearPending) are serialized with opsMu;
+// outbound capture through Send may proceed concurrently. Pending message IDs
+// are scoped to this controller instance (pending_store_instance).
+type MessageController struct {
+	mu    sync.Mutex // guards the pending store and the node registry
+	opsMu sync.Mutex // serializes Inject and ClearPending
+
+	transport Transport
+	nodes     map[uint64]*Node
+	pending   map[uint64]capturedMessage
+	order     []uint64
+	sequence  uint64
+}
+
+// NewMessageController creates an active test-mode controller that captures
+// and suppresses outbound messages sent through it.
+func NewMessageController(transport Transport) *MessageController {
+	return &MessageController{
+		transport: transport,
+		nodes:     make(map[uint64]*Node),
+		pending:   make(map[uint64]capturedMessage),
+	}
+}
+
+// Register makes a node reachable by Inject. Nodes registered with the wrapped
+// transport (for example *MemoryTransport) are discovered automatically, so
+// explicit registration is optional.
+func (controller *MessageController) Register(node *Node) {
+	if node == nil {
+		return
+	}
+	controller.mu.Lock()
+	defer controller.mu.Unlock()
+	controller.nodes[node.ID()] = node
+}
+
+// Send captures a stable snapshot of the message and suppresses the original
+// send path. It returns nil because the message is intentionally stopped at
+// the seam.
+func (controller *MessageController) Send(message Message) error {
+	controller.mu.Lock()
+	controller.sequence++
+	id := controller.sequence
+	controller.pending[id] = capturedMessage{
+		meta: PendingMessage{
+			ID:              id,
+			From:            message.From,
+			To:              message.To,
+			Type:            message.Type,
+			CaptureSequence: id,
+		},
+		msg: message.Clone(),
+	}
+	controller.order = append(controller.order, id)
+	controller.mu.Unlock()
+	return nil
+}
+
+// ListPending returns stable metadata for all pending messages in capture
+// order.
+func (controller *MessageController) ListPending() []PendingMessage {
+	controller.mu.Lock()
+	defer controller.mu.Unlock()
+	result := make([]PendingMessage, 0, len(controller.order))
+	for _, id := range controller.order {
+		if captured, ok := controller.pending[id]; ok {
+			result = append(result, captured.meta)
+		}
+	}
+	return result
+}
+
+// ClearPending removes all pending messages.
+func (controller *MessageController) ClearPending() {
+	controller.opsMu.Lock()
+	defer controller.opsMu.Unlock()
+	controller.mu.Lock()
+	defer controller.mu.Unlock()
+	controller.pending = make(map[uint64]capturedMessage)
+	controller.order = nil
+}
+
+// Inject delivers the pending message identified by id through the recorded
+// target's normal protocol input boundary (Node.Step). The message is consumed
+// only after delivery succeeds; on error it remains pending.
+func (controller *MessageController) Inject(id uint64) error {
+	controller.opsMu.Lock()
+	defer controller.opsMu.Unlock()
+
+	controller.mu.Lock()
+	captured, ok := controller.pending[id]
+	controller.mu.Unlock()
+	if !ok {
+		return ErrUnknownMessageID
+	}
+
+	target := controller.lookupNode(captured.msg.To)
+	if target == nil {
+		return fmt.Errorf("%w: %d", ErrUnknownNode, captured.msg.To)
+	}
+	if err := target.Step(captured.msg); err != nil {
+		return err
+	}
+
+	controller.mu.Lock()
+	delete(controller.pending, id)
+	controller.mu.Unlock()
+	return nil
+}
+
+// lookupNode resolves a node by ID: first the controller's own registry, then
+// the wrapped transport's registry when the transport exposes one.
+func (controller *MessageController) lookupNode(id uint64) *Node {
+	controller.mu.Lock()
+	node := controller.nodes[id]
+	controller.mu.Unlock()
+	if node != nil {
+		return node
+	}
+	if provider, ok := controller.transport.(nodeProvider); ok {
+		return provider.Node(id)
+	}
+	if memory, ok := controller.transport.(*MemoryTransport); ok {
+		memory.mu.Lock()
+		node = memory.nodes[id]
+		memory.mu.Unlock()
+		return node
+	}
+	return nil
+}
diff --git a/message_controller_test.go b/message_controller_test.go
new file mode 100644
index 0000000..1aeedfc
