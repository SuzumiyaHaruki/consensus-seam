+// TestMessageControllerConcurrentInjectDeliversOnce verifies that two
+// concurrent Inject calls on the same handle deliver the message exactly once:
+// one call succeeds, the other is refused with ErrMessageNotPending, and the
+// target ingress receives a single request.
+func TestMessageControllerConcurrentInjectDeliversOnce(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+	ctl.SetControlled(true)
+
+	recv := make(chan receivedRPC, 32)
+	go respondLikeRaft(t, t2, recv)
+
+	errCh := make(chan error, 1)
+	go func() {
+		var resp AppendEntriesResponse
+		errCh <- w1.AppendEntries(ServerID("node2"), addr2, &AppendEntriesRequest{Term: 1}, &resp)
+	}()
+	p := waitPending(t, ctl, func(p []PendingMessage) bool { return len(p) == 1 }, 5*time.Second)
+	h := p[0].Handle
+
+	results := make(chan error, 2)
+	for i := 0; i < 2; i++ {
+		go func() { results <- ctl.Inject(h) }()
+	}
+	var success, refused int
+	for i := 0; i < 2; i++ {
+		switch err := <-results; {
+		case err == nil:
+			success++
+		case errors.Is(err, ErrMessageNotPending):
+			refused++
+		default:
+			t.Fatalf("unexpected inject error: %v", err)
+		}
+	}
+	if success != 1 || refused != 1 {
+		t.Fatalf("expected exactly one success and one ErrMessageNotPending, got %d success %d refused", success, refused)
+	}
+
+	// The target ingress must see exactly one request.
+	deadline := time.Now().Add(5 * time.Second)
+	delivered := 0
+	for delivered == 0 && time.Now().Before(deadline) {
+		select {
+		case rr := <-recv:
+			if _, ok := rr.cmd.(*AppendEntriesRequest); ok {
+				delivered++
+			}
+		default:
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+	// Catch a duplicate delivery from the refused concurrent Inject.
+	dupDeadline := time.Now().Add(250 * time.Millisecond)
+	for time.Now().Before(dupDeadline) {
+		select {
+		case rr := <-recv:
+			if _, ok := rr.cmd.(*AppendEntriesRequest); ok {
+				delivered++
+			}
+		case <-time.After(5 * time.Millisecond):
+		}
+	}
+	if delivered != 1 {
+		t.Fatalf("duplicate delivery: target ingress received %d requests", delivered)
+	}
+
+	// The single response is captured once and completes the original caller.
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject response: %v", err)
+	}
+	select {
+	case err := <-errCh:
+		if err != nil {
+			t.Fatalf("append entries call failed: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("caller never completed after response injection")
+	}
+}
