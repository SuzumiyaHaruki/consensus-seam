+func TestLifecycleController_PauseGateBlocksAndShutdownUnblocks(t *testing.T) {
+	// A minimal Raft used purely to exercise the pause gate without starting
+	// any goroutine.
+	r := &Raft{shutdownCh: make(chan struct{})}
+	// Provide a config value so lifecyclePause's TimeController lookup (which
+	// reads r.config().TimeController) does not hit an empty atomic.Value.
+	r.conf.Store(Config{})
+
+	r.lifecyclePause()
+	gateDone := make(chan bool, 1)
+	go func() {
+		gateDone <- r.lifecyclePauseGate()
+	}()
+
+	select {
+	case <-gateDone:
+		t.Fatalf("pause gate returned while paused")
+	case <-time.After(50 * time.Millisecond):
+	}
+
+	r.lifecycleResume()
+	select {
+	case ok := <-gateDone:
+		if !ok {
+			t.Fatalf("pause gate reported shutdown")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("pause gate did not return after resume")
+	}
+
+	// A paused gate also unblocks on shutdown.
+	r.lifecyclePause()
+	go func() {
+		gateDone <- r.lifecyclePauseGate()
+	}()
+	close(r.shutdownCh)
+	select {
+	case ok := <-gateDone:
+		if ok {
+			t.Fatalf("pause gate did not report shutdown")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("pause gate did not return on shutdown")
+	}
+}
+
+func TestLifecycleController_InvalidTransitionsAndErrors(t *testing.T) {
+	node, lc, cleanup := lifecycleTestEnv(t)
+	defer cleanup()
+
+	other, _, otherCleanup := lifecycleTestEnv(t)
+	defer otherCleanup()
+
+	if err := lc.Pause(other); !errors.Is(err, errLifecycleSubjectNotTracked) {
+		t.Fatalf("expected not-tracked error, got %v", err)
+	}
+	// Restart is only valid after stop or crash.
+	if err := lc.Restart(node); err == nil {
+		t.Fatalf("expected restart of a running subject to fail")
+	}
+	if err := lc.Stop(node); err != nil {
+		t.Fatalf("stop: %v", err)
+	}
+	// Pause and resume are invalid once the subject is stopped.
+	if err := lc.Pause(node); err == nil {
+		t.Fatalf("expected pause of a stopped subject to fail")
+	}
+	if err := lc.Resume(node); err == nil {
+		t.Fatalf("expected resume of a stopped subject to fail")
+	}
+	// Crash of a stopped subject is invalid.
+	if err := lc.Crash(node); err == nil {
+		t.Fatalf("expected crash of a stopped subject to fail")
+	}
+	// ErrLifecycleUnsupported is exported and classifiable with errors.Is.
+	if !errors.Is(ErrLifecycleUnsupported, ErrLifecycleUnsupported) {
+		t.Fatalf("ErrLifecycleUnsupported must be classifiable with errors.Is")
+	}
+}
+
+func TestLifecycleController_PauseHoldsEventsReceivedAfterPause(t *testing.T) {
+	// Regression: an event received after Pause returns must be held at the
+	// pause gate and must not be handled, consumed or emitted until Resume.
+	// The follower state loop is driven manually on a skipStartup node, so
+	// the loop is the only execution context; a TimeController keeps the
+	// heartbeat timer from firing on the real clock.
+	conf := inmemConfig(t)
+	conf.LocalID = ServerID("lifecycle-node")
+	conf.skipStartup = true
+	conf.TimeController = NewTimeController(50 * time.Millisecond)
+
+	logs := NewInmemStore()
+	stable := NewInmemStore()
+	snaps := NewInmemSnapshotStore()
+	fsm := &MockFSM{}
+	_, trans := NewInmemTransport(ServerAddress("lifecycle-node"))
+
+	node, err := NewRaft(conf, fsm, logs, stable, snaps, trans)
+	if err != nil {
+		t.Fatalf("err: %v", err)
+	}
+	lc := NewLifecycleController(node, func() (*Raft, error) {
+		return nil, errors.New("unused")
+	})
+
+	loopDone := make(chan struct{})
+	go func() {
+		defer close(loopDone)
+		node.runFollower()
+	}()
+
+	// Wait until the loop is live by having it reject one apply with
+	// ErrNotLeader; this proves the loop is blocked in its select.
+	probeDone := make(chan error, 1)
+	go func() { probeDone <- node.Apply([]byte("probe"), 0).Error() }()
+	select {
+	case err := <-probeDone:
+		if err != ErrNotLeader {
+			t.Fatalf("probe apply: expected ErrNotLeader, got %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("follower loop did not handle the probe apply")
+	}
+
+	if err := lc.Pause(node); err != nil {
+		t.Fatalf("pause: %v", err)
+	}
+
+	// An apply sent after Pause returns must not be handled while paused.
+	heldDone := make(chan error, 1)
+	go func() { heldDone <- node.Apply([]byte("held"), 0).Error() }()
+	select {
+	case err := <-heldDone:
+		t.Fatalf("apply received after Pause was handled while paused: %v", err)
+	case <-time.After(200 * time.Millisecond):
+	}
+
+	if err := lc.Resume(node); err != nil {
+		t.Fatalf("resume: %v", err)
+	}
+	select {
+	case err := <-heldDone:
+		if err != ErrNotLeader {
+			t.Fatalf("held apply after resume: expected ErrNotLeader, got %v", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatalf("held apply was not handled after Resume")
+	}
+
+	// Stop the loop and wait for it to exit.
+	if err := node.Shutdown().Error(); err != nil {
+		t.Fatalf("shutdown: %v", err)
+	}
+	select {
+	case <-loopDone:
+	case <-time.After(2 * time.Second):
+		t.Fatalf("follower loop did not exit after shutdown")
+	}
+}
+
+// TestLifecycleController_CrashWaitsForLeadershipTransfer is a regression for
+// the crash boundary: the leadership-transfer goroutines (the watcher started
+// in leaderLoop and the leadershipTransfer goroutine) must be tracked by the
+// target's goroutine group, so after Crash returns no abandoned context can
+// still respond to the transfer future or mutate the transfer-in-progress
+// flag.
+func TestLifecycleController_CrashWaitsForLeadershipTransfer(t *testing.T) {
+	conf := inmemConfig(t)
+	conf.LocalID = ServerID("crash-leader")
+	// A short transport timeout keeps the in-flight RPC waits bounded.
+	addr, trans := NewInmemTransportWithTimeout(ServerAddress("crash-leader"), 100*time.Millisecond)
+
+	logs := NewInmemStore()
+	stable := NewInmemStore()
+	snaps := NewInmemSnapshotStore()
+	fsm := &MockFSM{}
+
+	deadID := ServerID("dead-peer")
+	deadAddr := ServerAddress("dead-peer")
+	bootstrap := Configuration{
+		Servers: []Server{
+			{Suffrage: Voter, ID: conf.LocalID, Address: addr},
+			{Suffrage: Nonvoter, ID: deadID, Address: deadAddr},
+		},
+	}
+	if err := BootstrapCluster(conf, logs, stable, snaps, trans, bootstrap); err != nil {
+		t.Fatalf("bootstrap: %v", err)
+	}
+
+	node, err := NewRaft(conf, fsm, logs, stable, snaps, trans)
+	if err != nil {
+		t.Fatalf("new raft: %v", err)
+	}
+	// The dead peer accepts RPCs on its transport but nothing ever consumes
+	// its consumer channel, so the leader's replication RPCs are accepted but
+	// never answered and the transfer stays in flight.
+	_, deadTrans := NewInmemTransport(deadAddr)
+	trans.Connect(deadAddr, deadTrans)
+
+	lc := NewLifecycleController(node, func() (*Raft, error) {
+		return nil, errors.New("unused in this test")
+	})
+
+	// The single voter elects itself on the real clock.
+	deadline := time.Now().Add(2 * time.Second)
+	for node.State() != Leader {
+		if time.Now().After(deadline) {
+			t.Fatalf("node did not become leader, state=%v", node.State())
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// Start a leadership transfer to the dead peer and wait until it is in
+	// flight (the transfer-in-progress flag is set by the leader loop).
+	future := node.LeadershipTransferToServer(deadID, deadAddr)
+	deadline = time.Now().Add(2 * time.Second)
+	for !node.getLeadershipTransferInProgress() {
+		if time.Now().After(deadline) {
+			t.Fatalf("leadership transfer did not start")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	if err := lc.Crash(node); err != nil {
+		t.Fatalf("crash: %v", err)
+	}
+
+	// The transfer goroutines are tracked: by the time Crash returns the
+	// watcher has run its deferred clear, so no stale context remains.
+	if node.getLeadershipTransferInProgress() {
+		t.Fatalf("leadership transfer context still active after Crash returned")
+	}
+	// The transfer future is resolved by the tracked watcher before Crash
+	// returns, so Error() returns immediately afterwards.
+	errCh := make(chan error, 1)
+	go func() { errCh <- future.Error() }()
+	select {
+	case <-errCh:
+	case <-time.After(2 * time.Second):
+		t.Fatalf("transfer future was not resolved when Crash returned")
+	}
+}
