+// TestMessageControllerDropClearAndErrors covers Drop, Clear, and the
+// classification errors on invalid handles.
+func TestMessageControllerDropClearAndErrors(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+	ctl.SetControlled(true)
+
+	capture := func() MessageHandle {
+		t.Helper()
+		errCh := make(chan error, 1)
+		go func() {
+			var resp AppendEntriesResponse
+			errCh <- w1.AppendEntries(ServerID("node2"), addr2, &AppendEntriesRequest{Term: 1}, &resp)
+		}()
+		p := waitPending(t, ctl, func(p []PendingMessage) bool { return len(p) == 1 }, 5*time.Second)
+		return p[0].Handle
+	}
+
+	h := capture()
+	if err := ctl.Drop(h); err != nil {
+		t.Fatalf("drop failed: %v", err)
+	}
+	if got := len(ctl.Pending()); got != 0 {
+		t.Fatalf("drop left %d entries", got)
+	}
+	if err := ctl.Drop(h); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("drop of removed handle: %v", err)
+	}
+	if err := ctl.Inject(h); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("inject of removed handle: %v", err)
+	}
+
+	h1 := capture()
+	h2 := capture()
+	ctl.Clear()
+	if got := len(ctl.Pending()); got != 0 {
+		t.Fatalf("clear left %d entries", got)
+	}
+	if err := ctl.Inject(h1); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("inject after clear: %v", err)
+	}
+	if err := ctl.Drop(h2); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("drop after clear: %v", err)
+	}
+}
