+func TestMessageControllerUnit(t *testing.T) {
+	t.Run("capture fields, handle stability and deep copies", func(t *testing.T) {
+		c, rawA, _, addrB, _ := newCapturedPair(t)
+		c.SetControlled(true)
+		go sendAppendEntries(rawA, addrB, "hello")
+
+		h := waitForPending(t, c, func(pm PendingMessage) bool {
+			return pm.Kind == MessageKindAppendEntries
+		})
+
+		pending := c.Pending()
+		require.Len(t, pending, 1)
+		pm := pending[0]
+		require.Equal(t, h, pm.Handle)
+		require.Equal(t, ServerID("node-a"), pm.Source)
+		require.Equal(t, ServerID("node-b"), pm.Target)
+		require.Equal(t, MessageKindAppendEntries, pm.Kind)
+		ae, ok := pm.Message.(*AppendEntriesRequest)
+		require.True(t, ok)
+		require.Len(t, ae.Entries, 1)
+		require.Equal(t, []byte("hello"), ae.Entries[0].Data)
+
+		// The handle stays stable across Pending calls.
+		require.Equal(t, h, c.Pending()[0].Handle)
+
+		// Pending returns fresh deep copies: mutating one snapshot does not
+		// affect the controller's private copy or later snapshots.
+		c.Pending()[0].Message.(*AppendEntriesRequest).Entries[0].Data[0] = 'X'
+		require.Equal(t, byte('h'), c.Pending()[0].Message.(*AppendEntriesRequest).Entries[0].Data[0])
+	})
+
+	t.Run("drop preserves acceptance order and invalidates the handle", func(t *testing.T) {
+		c, rawA, _, addrB, _ := newCapturedPair(t)
+		c.SetControlled(true)
+
+		go sendAppendEntries(rawA, addrB, "first")
+		h1 := waitForPending(t, c, func(pm PendingMessage) bool {
+			if ae, ok := pm.Message.(*AppendEntriesRequest); ok && len(ae.Entries) == 1 {
+				return string(ae.Entries[0].Data) == "first"
+			}
+			return false
+		})
+		go sendAppendEntries(rawA, addrB, "second")
+		h2 := waitForPending(t, c, func(pm PendingMessage) bool {
+			if ae, ok := pm.Message.(*AppendEntriesRequest); ok && len(ae.Entries) == 1 {
+				return string(ae.Entries[0].Data) == "second"
+			}
+			return false
+		})
+		go sendAppendEntries(rawA, addrB, "third")
+		h3 := waitForPending(t, c, func(pm PendingMessage) bool {
+			if ae, ok := pm.Message.(*AppendEntriesRequest); ok && len(ae.Entries) == 1 {
+				return string(ae.Entries[0].Data) == "third"
+			}
+			return false
+		})
+
+		require.NoError(t, c.Drop(h2))
+		got := c.Pending()
+		require.Len(t, got, 2)
+		require.Equal(t, h1, got[0].Handle)
+		require.Equal(t, h3, got[1].Handle)
+
+		// Dropped handles are invalid for every operation.
+		require.ErrorIs(t, c.Drop(h2), ErrMessageNotPending)
+		require.ErrorIs(t, c.Inject(h2), ErrMessageNotPending)
+	})
+
+	t.Run("clear removes all entries", func(t *testing.T) {
+		c, rawA, _, addrB, _ := newCapturedPair(t)
+		c.SetControlled(true)
+		go sendAppendEntries(rawA, addrB, "x")
+		waitForPending(t, c, func(pm PendingMessage) bool { return pm.Kind == MessageKindAppendEntries })
+		c.Clear()
+		require.Empty(t, c.Pending())
+		require.ErrorIs(t, c.Inject(MessageHandle{id: 1}), ErrMessageNotPending)
+	})
+
+	t.Run("inject unknown handle", func(t *testing.T) {
+		c, _, _, _, _ := newCapturedPair(t)
+		require.ErrorIs(t, c.Inject(MessageHandle{id: 99}), ErrMessageNotPending)
+	})
+
+	t.Run("inject not accepted preserves the entry", func(t *testing.T) {
+		c, rawA, _, addrB, capB := newCapturedPair(t)
+		c.SetControlled(true)
+		go sendAppendEntries(rawA, addrB, "x")
+		h := waitForPending(t, c, func(pm PendingMessage) bool { return pm.Kind == MessageKindAppendEntries })
+
+		// Fill the target's consumer queue so the normal ingress refuses the
+		// message.
+		for i := 0; i < cap(capB.consumerCh); i++ {
+			capB.consumerCh <- RPC{Command: &AppendEntriesRequest{}}
+		}
+		require.ErrorIs(t, c.Inject(h), ErrMessageNotAccepted)
+		require.Len(t, c.Pending(), 1)
+
+		// Once the ingress can accept again, the same handle injects and is
+		// removed.
+		<-capB.consumerCh
+		require.NoError(t, c.Inject(h))
+		require.Empty(t, c.Pending())
+	})
+
+	t.Run("inject target unavailable preserves the entry", func(t *testing.T) {
+		c, rawA, _, addrB, capB := newCapturedPair(t)
+		c.SetControlled(true)
+		go sendAppendEntries(rawA, addrB, "x")
+		h := waitForPending(t, c, func(pm PendingMessage) bool { return pm.Kind == MessageKindAppendEntries })
+
+		// Shutting the target's decorator down makes the target unavailable.
+		require.NoError(t, capB.Close())
+		require.ErrorIs(t, c.Inject(h), ErrTargetUnavailable)
+		require.Len(t, c.Pending(), 1)
+	})
+
+	t.Run("pass-through by default", func(t *testing.T) {
+		c, rawA, _, addrB, _ := newCapturedPair(t)
+		// Capture is never enabled: messages must not be retained.
+		go sendAppendEntries(rawA, addrB, "x")
+		time.Sleep(100 * time.Millisecond)
+		require.Empty(t, c.Pending())
+	})
+}
