+// TestMessageControllerEndToEndRaft wires two real Raft nodes through wrapped
+// transports: with controlled mode on, no protocol message may be delivered
+// without Inject; once the test injects the captured traffic, the cluster
+// elects a leader and commits an application command through the same seam.
+func TestMessageControllerEndToEndRaft(t *testing.T) {
+	mkConf := func(id ServerID, hb, elect time.Duration) *Config {
+		conf := inmemConfig(t)
+		conf.HeartbeatTimeout = hb
+		conf.ElectionTimeout = elect
+		conf.LeaderLeaseTimeout = hb / 2
+		conf.CommitTimeout = 50 * time.Millisecond
+		conf.PreVoteDisabled = true
+		conf.LocalID = id
+		return conf
+	}
+	conf1 := mkConf(ServerID("node1"), 1*time.Second, 1*time.Second)
+	conf2 := mkConf(ServerID("node2"), 30*time.Second, 30*time.Second)
+
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 5*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 5*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, conf1.LocalID)
+	w2 := NewControlledTransport(t2, ctl, conf2.LocalID)
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+
+	store1 := NewInmemStore()
+	store2 := NewInmemStore()
+	fsm1 := &MockFSM{}
+	fsm2 := &MockFSM{}
+	snaps1 := NewInmemSnapshotStore()
+	snaps2 := NewInmemSnapshotStore()
+
+	configuration := Configuration{Servers: []Server{
+		{Suffrage: Voter, ID: conf1.LocalID, Address: addr1},
+		{Suffrage: Voter, ID: conf2.LocalID, Address: addr2},
+	}}
+	if err := BootstrapCluster(conf1, store1, store1, snaps1, w1, configuration); err != nil {
+		t.Fatalf("bootstrap node1: %v", err)
+	}
+	if err := BootstrapCluster(conf2, store2, store2, snaps2, w2, configuration); err != nil {
+		t.Fatalf("bootstrap node2: %v", err)
+	}
+
+	// Install control before any Raft goroutine can do protocol work.
+	ctl.SetControlled(true)
+
+	r1, err := NewRaft(conf1, fsm1, store1, store1, snaps1, w1)
+	if err != nil {
+		t.Fatalf("NewRaft node1: %v", err)
+	}
+	r2, err := NewRaft(conf2, fsm2, store2, store2, snaps2, w2)
+	if err != nil {
+		t.Fatalf("NewRaft node2: %v", err)
+	}
+	defer func() {
+		_ = r1.Shutdown().Error()
+		_ = r2.Shutdown().Error()
+	}()
+
+	// Phase 1: nothing may progress without injection. The candidate's vote
+	// request must be captured and nothing may have been delivered.
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		for _, pm := range p {
+			if pm.Kind == MessageKindRequestVoteRequest {
+				return true
+			}
+		}
+		return false
+	}, 15*time.Second)
+	if r1.State() == Leader || r2.State() == Leader {
+		t.Fatalf("leader elected without any message injection")
+	}
+	if _, leaderID := r2.LeaderWithID(); leaderID != "" {
+		t.Fatalf("node2 knows a leader without any message injection: %s", leaderID)
+	}
+
+	// Phase 2: inject all captured traffic until node1 wins the election.
+	deadline := time.Now().Add(30 * time.Second)
+	for r1.State() != Leader {
+		if time.Now().After(deadline) {
+			t.Fatalf("node1 never became leader; state=%s pending=%+v", r1.State(), ctl.Pending())
+		}
+		pumpController(t, ctl)
+	}
+
+	// Phase 3: apply a command; the replication traffic flows through the same
+	// capture/inject seam.
+	future := r1.Apply([]byte("hello"), 5*time.Second)
+	applied := make(chan error, 1)
+	go func() { applied <- future.Error() }()
+	deadline = time.Now().Add(30 * time.Second)
+	for {
+		select {
+		case err := <-applied:
+			if err != nil {
+				t.Fatalf("apply failed: %v", err)
+			}
+			goto APPLIED
+		default:
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("apply never completed; state=%s fsm=%v", r1.State(), fsm1.Logs())
+		}
+		pumpController(t, ctl)
+	}
+APPLIED:
+	found := false
+	for _, l := range fsm1.Logs() {
+		if bytes.Equal(l, []byte("hello")) {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("command not applied to leader FSM: %v", fsm1.Logs())
+	}
+}
