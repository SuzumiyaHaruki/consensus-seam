+// TestMessageControllerCaptureInjectRoundTrip drives one full
+// capture -> pending -> inject -> response-capture -> inject round trip
+// through the transport seam, including stream buffering for InstallSnapshot.
+func TestMessageControllerCaptureInjectRoundTrip(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 5*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 5*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+
+	recv := make(chan receivedRPC, 32)
+	go respondLikeRaft(t, t2, recv)
+
+	// While disabled the wrapper is a pure delegate: the call completes
+	// through the real transport and nothing is captured.
+	var passthruResp AppendEntriesResponse
+	if err := w1.AppendEntries(ServerID("node2"), addr2,
+		&AppendEntriesRequest{Term: 1}, &passthruResp); err != nil {
+		t.Fatalf("passthrough append entries failed: %v", err)
+	}
+	if !passthruResp.Success {
+		t.Fatalf("passthrough response not copied: %+v", passthruResp)
+	}
+	if got := len(ctl.Pending()); got != 0 {
+		t.Fatalf("passthrough captured %d entries", got)
+	}
+	// The passthrough RPC itself crossed the real transport; consume and
+	// verify it before the controlled phase.
+	rr := waitReceived(t, recv, 5*time.Second)
+	passthru := rr.cmd.(*AppendEntriesRequest)
+	if passthru.Term != 1 || len(passthru.Entries) != 0 {
+		t.Fatalf("unexpected passthrough rpc: %+v", passthru)
+	}
+
+	ctl.SetControlled(true)
+
+	// Capture an AppendEntries request in the background, exactly like the
+	// leader's replication goroutine would.
+	req := &AppendEntriesRequest{
+		Term:              2,
+		PrevLogEntry:      4,
+		PrevLogTerm:       2,
+		LeaderCommitIndex: 4,
+		Entries: []*Log{
+			{Index: 5, Term: 2, Data: []byte("hello"), Extensions: []byte("ext")},
+		},
+	}
+	errCh := make(chan error, 1)
+	respCh := make(chan AppendEntriesResponse, 1)
+	go func() {
+		var resp AppendEntriesResponse
+		errCh <- w1.AppendEntries(ServerID("node2"), addr2, req, &resp)
+		respCh <- resp
+	}()
+
+	p := waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesRequest
+	}, 5*time.Second)
+	if p[0].Source != ServerID("node1") || p[0].Target != ServerID("node2") {
+		t.Fatalf("unexpected routing: %+v", p[0])
+	}
+	if p[0].Message.AppendEntriesRequest == nil || len(p[0].Message.AppendEntriesRequest.Entries) != 1 {
+		t.Fatalf("typed content missing: %+v", p[0])
+	}
+	if got := p[0].Message.AppendEntriesRequest.Entries[0].Data; !bytes.Equal(got, []byte("hello")) {
+		t.Fatalf("captured payload mismatch: %q", got)
+	}
+
+	// Pending must return independent deep copies: mutating one snapshot must
+	// not affect the next, and must not affect what Inject delivers.
+	snap1 := ctl.Pending()
+	snap1[0].Message.AppendEntriesRequest.Entries[0].Data[0] = 'X'
+	snap1[0].Message.AppendEntriesRequest.Term = 999
+	snap2 := ctl.Pending()
+	if snap2[0].Message.AppendEntriesRequest.Entries[0].Data[0] != 'h' {
+		t.Fatalf("pending snapshots alias the controller copy")
+	}
+	if snap2[0].Message.AppendEntriesRequest.Term != 2 {
+		t.Fatalf("pending snapshots alias the controller copy (term)")
+	}
+
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject request: %v", err)
+	}
+	// The delivered command must be the controller's private copy: it still
+	// carries the original data even though the test mutated a Pending view.
+	select {
+	case rr := <-recv:
+		delivered := rr.cmd.(*AppendEntriesRequest)
+		if got := delivered.Entries[0].Data; !bytes.Equal(got, []byte("hello")) {
+			t.Fatalf("delivered payload was aliased or mutated: %q", got)
+		}
+		if delivered.Term != 2 {
+			t.Fatalf("delivered payload was aliased or mutated (term): %d", delivered.Term)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("request never reached the target ingress")
+	}
+
+	// The response is separately captured with reversed routing and a new
+	// handle, and the original caller stays blocked until it is injected.
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	if p[0].Source != ServerID("node2") || p[0].Target != ServerID("node1") {
+		t.Fatalf("response routing not reversed: %+v", p[0])
+	}
+	if p[0].Message.AppendEntriesResponse == nil || !p[0].Message.AppendEntriesResponse.Success {
+		t.Fatalf("response content missing: %+v", p[0])
+	}
+
+	select {
+	case err := <-errCh:
+		t.Fatalf("caller completed before the response was injected: %v", err)
+	default:
+	}
+
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject response: %v", err)
+	}
+	select {
+	case err := <-errCh:
+		if err != nil {
+			t.Fatalf("append entries call failed: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("caller never completed after response injection")
+	}
+	if resp := <-respCh; !resp.Success {
+		t.Fatalf("response not copied to caller: %+v", resp)
+	}
+	if err := ctl.Inject(p[0].Handle); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("injected handle stayed valid: %v", err)
+	}
+
+	// InstallSnapshot round trip: the stream is buffered at capture and
+	// replayed from the controller's private copy at injection.
+	snapReq := &InstallSnapshotRequest{Term: 2, LastLogIndex: 10, LastLogTerm: 2, Size: 13}
+	snapErrCh := make(chan error, 1)
+	snapRespCh := make(chan InstallSnapshotResponse, 1)
+	go func() {
+		var resp InstallSnapshotResponse
+		snapErrCh <- w1.InstallSnapshot(ServerID("node2"), addr2, snapReq, &resp, bytes.NewReader([]byte("snapshot-data")))
+		snapRespCh <- resp
+	}()
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindInstallSnapshotRequest
+	}, 5*time.Second)
+	if p[0].Message.InstallSnapshotRequest == nil {
+		t.Fatalf("snapshot request content missing")
+	}
+	if !bytes.Equal(p[0].Stream, []byte("snapshot-data")) {
+		t.Fatalf("pending snapshot omits the stream: %q", p[0].Stream)
+	}
+	// The Pending stream is an independent deep copy: mutating it must not
+	// affect what Inject replays from the controller's private buffer.
+	p[0].Stream[0] = 'X'
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject snapshot request: %v", err)
+	}
+	select {
+	case rr := <-recv:
+		if !bytes.Equal(rr.snap, []byte("snapshot-data")) {
+			t.Fatalf("snapshot stream corrupted: %q", rr.snap)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("snapshot never reached the target ingress")
+	}
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindInstallSnapshotResponse
+	}, 5*time.Second)
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject snapshot response: %v", err)
+	}
+	select {
+	case err := <-snapErrCh:
+		if err != nil {
+			t.Fatalf("install snapshot call failed: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("snapshot caller never completed")
+	}
+	if resp := <-snapRespCh; !resp.Success {
+		t.Fatalf("snapshot response not copied to caller: %+v", resp)
+	}
+
+	// Pipeline round trip: each pipelined AppendEntries is captured and its
+	// AppendFuture completes only when the captured response entry is injected.
+	pipeline, err := w1.AppendEntriesPipeline(ServerID("node2"), addr2)
+	if err != nil {
+		t.Fatalf("open pipeline: %v", err)
+	}
+	defer pipeline.Close()
+	pipeFuture, err := pipeline.AppendEntries(
+		&AppendEntriesRequest{Term: 3, Entries: []*Log{{Index: 6, Term: 3, Data: []byte("pipe")}}},
+		new(AppendEntriesResponse),
+	)
+	if err != nil {
+		t.Fatalf("pipeline append: %v", err)
+	}
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesRequest
+	}, 5*time.Second)
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject pipelined request: %v", err)
+	}
+	p = waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	if err := ctl.Inject(p[0].Handle); err != nil {
+		t.Fatalf("inject pipelined response: %v", err)
+	}
+	if err := pipeFuture.Error(); err != nil {
+		t.Fatalf("pipeline future failed: %v", err)
+	}
+	if !pipeFuture.Response().Success {
+		t.Fatalf("pipeline response not copied to future: %+v", pipeFuture.Response())
+	}
+
+	ctl.SetControlled(false)
+	w1.Close()
+	w2.Close()
+}
