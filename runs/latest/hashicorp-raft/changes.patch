+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+)
+
+// MessageHandle identifies one captured protocol message while it is pending
+// in a MessageController. It is a struct backed by an unexported uint64
+// identity that is stable while the message is pending and is never reused;
+// after Drop, Clear, or a successful Inject the handle is invalid and all
+// operations referring to it fail with ErrMessageNotPending.
+type MessageHandle struct {
+	id uint64
+}
+
+// MessageKind classifies a captured protocol message. The underlying type is
+// string so that kinds can be compared with plain string literals.
+type MessageKind string
+
+const (
+	// MessageKindAppendEntries identifies an AppendEntriesRequest.
+	MessageKindAppendEntries MessageKind = "AppendEntries"
+	// MessageKindAppendEntriesResponse identifies an AppendEntriesResponse.
+	MessageKindAppendEntriesResponse MessageKind = "AppendEntriesResponse"
+	// MessageKindRequestVote identifies a RequestVoteRequest.
+	MessageKindRequestVote MessageKind = "RequestVote"
+	// MessageKindRequestVoteResponse identifies a RequestVoteResponse.
+	MessageKindRequestVoteResponse MessageKind = "RequestVoteResponse"
+	// MessageKindRequestPreVote identifies a RequestPreVoteRequest.
+	MessageKindRequestPreVote MessageKind = "RequestPreVote"
+	// MessageKindRequestPreVoteResponse identifies a RequestPreVoteResponse.
+	MessageKindRequestPreVoteResponse MessageKind = "RequestPreVoteResponse"
+	// MessageKindInstallSnapshot identifies an InstallSnapshotRequest.
+	MessageKindInstallSnapshot MessageKind = "InstallSnapshot"
+	// MessageKindInstallSnapshotResponse identifies an InstallSnapshotResponse.
+	MessageKindInstallSnapshotResponse MessageKind = "InstallSnapshotResponse"
+	// MessageKindTimeoutNow identifies a TimeoutNowRequest.
+	MessageKindTimeoutNow MessageKind = "TimeoutNow"
+	// MessageKindTimeoutNowResponse identifies a TimeoutNowResponse.
+	MessageKindTimeoutNowResponse MessageKind = "TimeoutNowResponse"
+)
+
+var (
+	// ErrMessageNotPending is returned when an operation refers to a
+	// MessageHandle that is not currently pending in the MessageController
+	// (because it was never captured, was dropped, cleared, or already
+	// injected). It is classifiable with errors.Is.
+	ErrMessageNotPending = errors.New("message controller: message is not pending")
+	// ErrTargetUnavailable is returned by Inject when the captured message's
+	// target node is not attached to the controller, or its transport is no
+	// longer available (for example after the node was shut down). The entry
+	// is preserved.
+	ErrTargetUnavailable = errors.New("message controller: target is unavailable")
+	// ErrMessageNotAccepted is returned by Inject when the target's normal
+	// ingress did not accept the message (for example its consumer queue is
+	// full). The entry is preserved.
+	ErrMessageNotAccepted = errors.New("message controller: message was not accepted by target")
+)
+
+// PendingMessage is a test-visible snapshot of one captured protocol message.
+// Source and Target use the native ServerID identity type. Message carries the
+// deep-copied native command; because every request and response command in
+// the protocol implements WithRPCHeader, callers recover the concrete typed
+// command with a type switch (for example *AppendEntriesRequest).
+type PendingMessage struct {
+	// Handle is the stable identity of the pending entry.
+	Handle MessageHandle
+	// Source is the ServerID of the node that sent the message. For a
+	// request this is the sender recorded in the RPC header; for a response
+	// it is the responder.
+	Source ServerID
+	// Target is the ServerID of the node the message is directed at. For a
+	// request this is the node whose transport captured it; for a response
+	// it is the original requester.
+	Target ServerID
+	// Kind classifies the captured message.
+	Kind MessageKind
+	// Message is a fresh deep copy of the typed native command (request or
+	// response).
+	Message WithRPCHeader
+}
+
+// MessageController retains every in-boundary cross-node protocol message
+// before delivery while capture is enabled, and injects selected entries
+// through the normal protocol ingress of their real target. When capture is
+// disabled (the default) messages pass through untouched, so production
+// behavior is unchanged.
+//
+// One authoritative controller is attached to every CapturingTransport that
+// should be controlled; requests and their eventual protocol responses are
+// captured as separate pending entries with independent handles and reversed
+// routing.
+type MessageController struct {
+	mu         sync.Mutex
+	controlled bool
+	nextID     uint64
+	entries    map[MessageHandle]*pendingEntry
+	order      []MessageHandle
+	transports map[ServerID]*CapturingTransport
+}
+
+// pendingEntry is the controller-owned record for one captured message. A
+// request entry additionally owns the private RPC (with a swapped response
+// channel) used for injection, the preserved original response channel, and
+// the replayable snapshot stream. A response entry owns the private response
+// copy and the preserved original response channel of its request.
+type pendingEntry struct {
+	handle MessageHandle
+	kind   MessageKind
+	source ServerID
+	target ServerID
+
+	// Request side.
+	cmd       WithRPCHeader    // private deep copy of the request command
+	rpc       *RPC             // controller-owned request RPC (swapped RespChan)
+	captureCh chan RPCResponse // swapped channel that receives the protocol response
+	droppedCh chan struct{}    // closed when a pending request entry leaves the cache
+	doneCh    <-chan struct{}  // decorator shutdown signal
+
+	// Response side.
+	isResponse bool
+	resp       RPCResponse        // private deep copy of the response
+	preserved  chan<- RPCResponse // original response channel, used for normal delivery
+}
+
+// NewMessageController creates a MessageController that starts in pass-through
+// mode (capture disabled) and attaches the given transports. Capture must be
+// enabled with SetControlled(true) before the messages that should be
+// controlled are sent, and every CapturingTransport must be attached before
+// its node starts.
+func NewMessageController(transports ...*CapturingTransport) *MessageController {
+	c := &MessageController{
+		entries:    make(map[MessageHandle]*pendingEntry),
+		transports: make(map[ServerID]*CapturingTransport),
+	}
+	for _, t := range transports {
+		c.Attach(t)
+	}
+	return c
+}
+
+// Attach wires a CapturingTransport to this controller under its local
+// ServerID. Attach must be called before the node using the transport starts,
+// and before capture is enabled.
+func (c *MessageController) Attach(t *CapturingTransport) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	t.setController(c)
+	c.transports[t.localID] = t
+}
+
+// SetControlled enables or disables capture for every attached transport.
+// Capture is disabled by default: while disabled, all messages are forwarded
+// unchanged and nothing is retained, so ordinary production behavior is
+// preserved.
+func (c *MessageController) SetControlled(enabled bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.controlled = enabled
+}
+
+// isControlled reports whether capture is currently enabled.
+func (c *MessageController) isControlled() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.controlled
+}
+
+// capture is called by a CapturingTransport for every inbound RPC while
+// capture is enabled. It deep-copies the command, buffers any one-shot
+// snapshot stream, swaps the response channel so the eventual protocol
+// response is captured as a separate entry, and records a pending request
+// entry. On any copy or buffering failure it completes the original exchange
+// with an error through the preserved response channel instead of forwarding a
+// partially consumed original, and returns the error so the failure is
+// observable.
+func (c *MessageController) capture(t *CapturingTransport, rpc RPC) error {
+	cmd := deepCopyCommand(rpc.Command)
+	if cmd == nil {
+		err := fmt.Errorf("message controller: cannot capture unsupported command type %T", rpc.Command)
+		rpc.Respond(nil, err)
+		return err
+	}
+
+	kind := messageKindFor(cmd)
+	header := cmd.GetRPCHeader()
+	source := ServerID(header.ID)
+
+	// Buffer the one-shot InstallSnapshot stream so every delivery can replay
+	// it independently of the original reader.
+	var stream *bytes.Reader
+	if rpc.Reader != nil {
+		data, err := io.ReadAll(rpc.Reader)
+		if err != nil {
+			err = fmt.Errorf("message controller: failed to buffer snapshot stream: %w", err)
+			rpc.Respond(nil, err)
+			return err
+		}
+		stream = bytes.NewReader(data)
+	}
+
+	// Swap the response channel: the protocol response will be written to the
+	// capture channel by the normal responder and recorded as a separate
+	// pending entry; the preserved channel completes the original caller only
+	// when the response entry is injected.
+	captureCh := make(chan RPCResponse, 1)
+	entry := &pendingEntry{
+		kind:      kind,
+		source:    source,
+		target:    t.localID,
+		cmd:       cmd,
+		rpc:       &RPC{Command: cmd, Reader: stream, RespChan: captureCh},
+		captureCh: captureCh,
+		droppedCh: make(chan struct{}),
+		doneCh:    t.doneCh,
+		preserved: rpc.RespChan,
+	}
+
+	c.mu.Lock()
+	c.addEntryLocked(entry)
+	c.mu.Unlock()
+
+	// The response watcher outlives the request entry: it stays alive after a
+	// successful Inject so the eventual protocol response is recorded too, and
+	// exits if the entry is dropped/cleared or the decorator shuts down.
+	go c.watchResponse(entry)
+	return nil
+}
+
+// watchResponse records the protocol response for an injected request as a
+// separate pending entry with reversed routing and a new handle.
+func (c *MessageController) watchResponse(e *pendingEntry) {
+	select {
+	case resp := <-e.captureCh:
+		c.recordResponse(e, resp)
+	case <-e.droppedCh:
+	case <-e.doneCh:
+	}
+}
+
+// recordResponse adds a pending response entry for the given request entry.
+func (c *MessageController) recordResponse(e *pendingEntry, resp RPCResponse) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	var cmd WithRPCHeader
+	if resp.Response != nil {
+		cmd = deepCopyCommand(resp.Response)
+	}
+	c.addEntryLocked(&pendingEntry{
+		kind:       responseKindFor(e.kind),
+		source:     e.target,
+		target:     e.source,
+		isResponse: true,
+		resp:       RPCResponse{Response: cmd, Error: resp.Error},
+		preserved:  e.preserved,
+	})
+}
+
+// Pending returns fresh deep copies of all pending entries in controller
+// acceptance order. Each call produces independent snapshots; the controller
+// keeps its own private copies for injection.
+func (c *MessageController) Pending() []PendingMessage {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	out := make([]PendingMessage, 0, len(c.order))
+	for _, h := range c.order {
+		e, ok := c.entries[h]
+		if !ok {
+			continue
+		}
+		var msg WithRPCHeader
+		if e.isResponse {
+			msg = deepCopyCommand(e.resp.Response)
+		} else {
+			msg = deepCopyCommand(e.cmd)
+		}
+		out = append(out, PendingMessage{
+			Handle:  h,
+			Source:  e.source,
+			Target:  e.target,
+			Kind:    e.kind,
+			Message: msg,
+		})
+	}
+	return out
+}
+
+// Drop removes the pending entry identified by h from the controller and
+// releases its resources. The relative order of the remaining entries is
+// preserved. The original sender of a dropped request is left to its own
+// transport timeout; the controller never fabricates a response. Dropping an
+// unknown handle returns ErrMessageNotPending.
+func (c *MessageController) Drop(h MessageHandle) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	e, ok := c.entries[h]
+	if !ok {
+		return ErrMessageNotPending
+	}
+	c.removeLocked(h)
+	if !e.isResponse {
+		close(e.droppedCh)
+	}
+	return nil
+}
+
+// Clear removes every pending entry from the controller, releasing resources
+// and invalidating all outstanding handles.
+func (c *MessageController) Clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	for _, e := range c.entries {
+		if !e.isResponse {
+			close(e.droppedCh)
+		}
+	}
+	c.entries = make(map[MessageHandle]*pendingEntry)
+	c.order = nil
+}
+
+// Inject delivers the pending entry identified by h through the normal
+// protocol ingress of its real captured target: a request is enqueued into the
+// target node's consumer channel (Raft.processRPC), and a response is sent
+// into the preserved original response channel so the synchronous caller,
+// channel, or pipeline future completes normally. Injection succeeds as soon
+// as the ingress accepts the message; it does not wait for processing, commit,
+// or quiescence. Confirmed acceptance removes the entry and invalidates the
+// handle; an invalid handle, an unavailable target, or explicit
+// non-acceptance preserves the entry and returns a classified error.
+func (c *MessageController) Inject(h MessageHandle) error {
+	c.mu.Lock()
+
+	e, ok := c.entries[h]
+	if !ok {
+		c.mu.Unlock()
+		return ErrMessageNotPending
+	}
+
+	if e.isResponse {
+		select {
+		case e.preserved <- e.resp:
+			c.removeLocked(h)
+			c.mu.Unlock()
+			return nil
+		default:
+			c.mu.Unlock()
+			return ErrMessageNotAccepted
+		}
+	}
+
+	t := c.transports[e.target]
+	if t == nil {
+		c.mu.Unlock()
+		return ErrTargetUnavailable
+	}
+	select {
+	case <-t.doneCh:
+		c.mu.Unlock()
+		return ErrTargetUnavailable
+	default:
+	}
+	select {
+	case t.consumerCh <- *e.rpc:
+		c.removeLocked(h)
+		c.mu.Unlock()
+		return nil
+	default:
+		c.mu.Unlock()
+		return ErrMessageNotAccepted
+	}
+}
+
+func (c *MessageController) addEntryLocked(e *pendingEntry) MessageHandle {
+	c.nextID++
+	h := MessageHandle{id: c.nextID}
+	e.handle = h
+	c.entries[h] = e
+	c.order = append(c.order, h)
+	return h
+}
+
+func (c *MessageController) removeLocked(h MessageHandle) {
+	delete(c.entries, h)
+	for i, x := range c.order {
+		if x == h {
+			c.order = append(c.order[:i], c.order[i+1:]...)
+			return
+		}
+	}
+}
+
+// CapturingTransport is a Transport decorator that intercepts every inbound
+// logical cross-node protocol message delivered through the wrapped
+// transport's Consumer channel. While its MessageController has capture
+// enabled, each RPC is retained as a pending entry before delivery; otherwise
+// every RPC is forwarded unchanged, preserving production behavior. The
+// decorator is the only consumer of the wrapped channel and must be passed to
+// NewRaft in place of the raw transport.
+//
+// Peer wiring (InmemTransport.Connect) must be performed on the raw transports
+// underneath the decorators, because senders route directly to the raw
+// consumer channel of the receiving node.
+type CapturingTransport struct {
+	mu         sync.Mutex
+	controller *MessageController
+
+	trans      Transport
+	localID    ServerID
+	consumerCh chan RPC
+	doneCh     chan struct{}
+	closeOnce  sync.Once
+}
+
+// NewCapturingTransport wraps trans so that inbound RPCs can be captured by a
+// MessageController. localID is the ServerID of the node that owns the
+// transport and becomes the Target of every request captured at this node.
+func NewCapturingTransport(trans Transport, localID ServerID) *CapturingTransport {
+	t := &CapturingTransport{
+		trans:      trans,
+		localID:    localID,
+		consumerCh: make(chan RPC, 16),
+		doneCh:     make(chan struct{}),
+	}
+	go t.serve()
+	return t
+}
+
+// serve drains the wrapped transport's consumer channel. It is the sole
+// consumer of that channel, so no protocol message can bypass the controller
+// while capture is enabled.
+func (t *CapturingTransport) serve() {
+	in := t.trans.Consumer()
+	for {
+		select {
+		case rpc, ok := <-in:
+			if !ok {
+				return
+			}
+			t.handleRPC(rpc)
+		case <-t.doneCh:
+			return
+		}
+	}
+}
+
+func (t *CapturingTransport) handleRPC(rpc RPC) {
+	c := t.getController()
+	if c == nil || !c.isControlled() {
+		// Pass-through: deliver the original RPC unchanged.
+		select {
+		case t.consumerCh <- rpc:
+		case <-t.doneCh:
+		}
+		return
+	}
+	_ = c.capture(t, rpc)
+}
+
+func (t *CapturingTransport) getController() *MessageController {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.controller
+}
+
+func (t *CapturingTransport) setController(c *MessageController) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.controller = c
+}
+
+// Consumer implements Transport.
+func (t *CapturingTransport) Consumer() <-chan RPC {
+	return t.consumerCh
+}
+
+// LocalAddr implements Transport.
+func (t *CapturingTransport) LocalAddr() ServerAddress {
+	return t.trans.LocalAddr()
+}
+
+// AppendEntriesPipeline implements Transport.
+func (t *CapturingTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {
+	return t.trans.AppendEntriesPipeline(id, target)
+}
+
+// AppendEntries implements Transport.
+func (t *CapturingTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {
+	return t.trans.AppendEntries(id, target, args, resp)
+}
+
+// RequestVote implements Transport.
+func (t *CapturingTransport) RequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error {
+	return t.trans.RequestVote(id, target, args, resp)
+}
+
+// InstallSnapshot implements Transport.
+func (t *CapturingTransport) InstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error {
+	return t.trans.InstallSnapshot(id, target, args, resp, data)
+}
+
+// EncodePeer implements Transport.
+func (t *CapturingTransport) EncodePeer(id ServerID, addr ServerAddress) []byte {
+	return t.trans.EncodePeer(id, addr)
+}
+
+// DecodePeer implements Transport.
+func (t *CapturingTransport) DecodePeer(buf []byte) ServerAddress {
+	return t.trans.DecodePeer(buf)
+}
+
+// SetHeartbeatHandler implements Transport. It delegates to the wrapped
+// transport; the in-boundary InmemTransport ignores it, so all heartbeats
+// still flow through the consumer channel and are captured.
+func (t *CapturingTransport) SetHeartbeatHandler(cb func(rpc RPC)) {
+	t.trans.SetHeartbeatHandler(cb)
+}
+
+// TimeoutNow implements Transport.
+func (t *CapturingTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {
+	return t.trans.TimeoutNow(id, target, args, resp)
+}
+
+// RequestPreVote implements WithPreVote. The decorator always advertises
+// pre-vote support and delegates to the wrapped transport; the transports in
+// this module all support RequestPreVote.
+func (t *CapturingTransport) RequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error {
+	if pv, ok := t.trans.(WithPreVote); ok {
+		return pv.RequestPreVote(id, target, args, resp)
+	}
+	return fmt.Errorf("capturing transport: wrapped transport does not support RequestPreVote")
+}
+
+// Connect implements WithPeers.
+func (t *CapturingTransport) Connect(peer ServerAddress, trans Transport) {
+	if wp, ok := t.trans.(WithPeers); ok {
+		wp.Connect(peer, trans)
+	}
+}
+
+// Disconnect implements WithPeers.
+func (t *CapturingTransport) Disconnect(peer ServerAddress) {
+	if wp, ok := t.trans.(WithPeers); ok {
+		wp.Disconnect(peer)
+	}
+}
+
+// DisconnectAll implements WithPeers.
+func (t *CapturingTransport) DisconnectAll() {
+	if wp, ok := t.trans.(WithPeers); ok {
+		wp.DisconnectAll()
+	}
+}
+
+// Close implements WithClose: it stops the capture goroutine and closes the
+// wrapped transport if it supports WithClose.
+func (t *CapturingTransport) Close() error {
+	t.closeOnce.Do(func() { close(t.doneCh) })
+	if wc, ok := t.trans.(WithClose); ok {
+		return wc.Close()
+	}
+	return nil
+}
+
+var (
+	_ Transport         = (*CapturingTransport)(nil)
+	_ WithPreVote       = (*CapturingTransport)(nil)
+	_ WithPeers         = (*CapturingTransport)(nil)
+	_ WithClose         = (*CapturingTransport)(nil)
+	_ LoopbackTransport = (*CapturingTransport)(nil)
+)
+
+// messageKindFor maps a native command to its MessageKind.
+func messageKindFor(cmd interface{}) MessageKind {
+	switch cmd.(type) {
+	case *AppendEntriesRequest:
+		return MessageKindAppendEntries
+	case *AppendEntriesResponse:
+		return MessageKindAppendEntriesResponse
+	case *RequestVoteRequest:
+		return MessageKindRequestVote
+	case *RequestVoteResponse:
+		return MessageKindRequestVoteResponse
+	case *RequestPreVoteRequest:
+		return MessageKindRequestPreVote
+	case *RequestPreVoteResponse:
+		return MessageKindRequestPreVoteResponse
+	case *InstallSnapshotRequest:
+		return MessageKindInstallSnapshot
+	case *InstallSnapshotResponse:
+		return MessageKindInstallSnapshotResponse
+	case *TimeoutNowRequest:
+		return MessageKindTimeoutNow
+	case *TimeoutNowResponse:
+		return MessageKindTimeoutNowResponse
+	}
+	return ""
+}
+
+// responseKindFor maps a request MessageKind to its response MessageKind.
+func responseKindFor(k MessageKind) MessageKind {
+	switch k {
+	case MessageKindAppendEntries:
+		return MessageKindAppendEntriesResponse
+	case MessageKindRequestVote:
+		return MessageKindRequestVoteResponse
+	case MessageKindRequestPreVote:
+		return MessageKindRequestPreVoteResponse
+	case MessageKindInstallSnapshot:
+		return MessageKindInstallSnapshotResponse
+	case MessageKindTimeoutNow:
+		return MessageKindTimeoutNowResponse
+	}
+	return ""
+}
+
+// deepCopyCommand returns a fresh deep copy of a native protocol command, or
+// nil if the command type is not modeled by the controller. Byte slices,
+// nested log entries, and the RPC header are copied so the copy shares no
+// mutable state with the original.
+func deepCopyCommand(cmd interface{}) WithRPCHeader {
+	switch c := cmd.(type) {
+	case *AppendEntriesRequest:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		out.Leader = append([]byte(nil), c.Leader...)
+		out.Entries = deepCopyLogs(c.Entries)
+		return &out
+	case *AppendEntriesResponse:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	case *RequestVoteRequest:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		out.Candidate = append([]byte(nil), c.Candidate...)
+		return &out
+	case *RequestVoteResponse:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		out.Peers = append([]byte(nil), c.Peers...)
+		return &out
+	case *RequestPreVoteRequest:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	case *RequestPreVoteResponse:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	case *InstallSnapshotRequest:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		out.Leader = append([]byte(nil), c.Leader...)
+		out.Peers = append([]byte(nil), c.Peers...)
+		out.Configuration = append([]byte(nil), c.Configuration...)
+		return &out
+	case *InstallSnapshotResponse:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	case *TimeoutNowRequest:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	case *TimeoutNowResponse:
+		out := *c
+		out.ID = append([]byte(nil), c.ID...)
+		out.Addr = append([]byte(nil), c.Addr...)
+		return &out
+	}
+	return nil
+}
+
+// deepCopyLogs deep-copies a slice of log entries including their data and
+// extension payloads.
+func deepCopyLogs(in []*Log) []*Log {
+	if in == nil {
+		return nil
+	}
+	out := make([]*Log, len(in))
+	for i, l := range in {
+		if l == nil {
+			continue
+		}
+		cp := *l
+		cp.Data = append([]byte(nil), l.Data...)
+		cp.Extensions = append([]byte(nil), l.Extensions...)
+		out[i] = &cp
+	}
+	return out
+}
