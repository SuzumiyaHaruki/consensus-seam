--- /dev/null
+++ b/random_controller.go
@@ -0,0 +1,118 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"math/rand"
+	"sync"
+	"time"
+)
+
+// RandomChoice is one recorded random selection made by a controlled *Raft
+// node. The recorded Value is the final semantic result of the choice (the
+// selected staggering duration), never raw random bits.
+type RandomChoice struct {
+	// Owner is the ServerID of the node that made the choice. Attribution is
+	// always recorded, so an aggregated controller wired to several nodes
+	// still attributes every choice to the concrete node that drew it.
+	Owner ServerID
+	// Name is a stable semantic name of the choice: "heartbeat", "election",
+	// "commit", "heartbeat_interval", or "snapshot".
+	Name string
+	// Value is the selected value: the random extra duration in [0, base)
+	// that was added to the base timeout of the named timer. The base itself
+	// is configuration input, not a random choice.
+	Value time.Duration
+}
+
+// RandomController makes the hidden non-cryptographic random choices of one or
+// more *Raft nodes deterministic and observable. Every randomized protocol
+// timeout (heartbeat, election, commit, heartbeat-interval and
+// snapshot-interval staggering drawn by randomTimeout) is served through the
+// controller wired to the node, so the same seed and draw order reproduce the
+// same sequence while repeated choices still vary.
+//
+// A controller is inactive by default: nodes only draw through it when it is
+// installed via Config.RandomController before NewRaft is called. When no
+// controller is installed, the package default (crypto-seeded math/rand)
+// staggering is used unchanged, so ordinary production behavior is preserved.
+type RandomController struct {
+	mu      sync.Mutex
+	rng     *rand.Rand
+	owners  []ServerID
+	choices []RandomChoice
+}
+
+// NewRandomController creates a RandomController seeded with seed. The
+// optional owners list restricts recording to draws made by the listed nodes;
+// with no owners every draw served by the controller is recorded. Draws by
+// nodes that are not listed are still served from the controller's sequence
+// (so the reproducible draw order is unchanged) but are not appended to the
+// recorded history. Every recorded choice carries the concrete ServerID of
+// the node that made it.
+func NewRandomController(seed int64, owners ...ServerID) *RandomController {
+	return &RandomController{
+		rng:    rand.New(rand.NewSource(seed)),
+		owners: append([]ServerID(nil), owners...),
+	}
+}
+
+// Choices returns a deep-copied ordered history of every recorded choice, in
+// draw order. Each call produces an independent snapshot; mutating the result
+// never affects the controller or later snapshots.
+func (c *RandomController) Choices() []RandomChoice {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	out := make([]RandomChoice, len(c.choices))
+	copy(out, c.choices)
+	return out
+}
+
+// draw performs one random draw for the given node and records it when the
+// node is within the controller's owner set. The returned extra is in
+// [0, minVal) and mirrors the package default staggering (rand.Int63() %
+// minVal), so the legal domain is unchanged.
+func (c *RandomController) draw(owner ServerID, name string, minVal time.Duration) time.Duration {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	extra := time.Duration(c.rng.Int63()) % minVal
+	if c.records(owner) {
+		c.choices = append(c.choices, RandomChoice{Owner: owner, Name: name, Value: extra})
+	}
+	return extra
+}
+
+// records reports whether draws by owner are recorded.
+func (c *RandomController) records(owner ServerID) bool {
+	if len(c.owners) == 0 {
+		return true
+	}
+	for _, o := range c.owners {
+		if o == owner {
+			return true
+		}
+	}
+	return false
+}
+
+// randomTimeout draws a staggered timeout for this node. When the node has a
+// RandomController installed (via Config.RandomController) the draw is served
+// by the controller, which records it for later inspection; otherwise the
+// package default randomTimeout behavior is used, so production behavior is
+// unchanged. The timer itself is always armed through the node's protocol
+// clock as a rearmable periodic timer (r.timeAfterRearmable), so a
+// TimeController installed via
+// Config.TimeController keeps the timer virtual as well.
+func (r *Raft) randomTimeout(name string, minVal time.Duration) <-chan time.Time {
+	if minVal == 0 {
+		return nil
+	}
+	if rc := r.config().RandomController; rc != nil {
+		extra := rc.draw(r.localID, name, minVal)
+		return r.timeAfterRearmable(minVal + extra)
+	}
+	return r.timeAfterRearmable(minVal + randomExtra(minVal))
+}
