+// TestMessageControllerInjectTargetUnavailable verifies that an unavailable
+// target preserves the entry and its handle, and that reconnecting restores
+// delivery.
+func TestMessageControllerInjectTargetUnavailable(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+	ctl.SetControlled(true)
+
+	errCh := make(chan error, 1)
+	go func() {
+		var resp AppendEntriesResponse
+		errCh <- w1.AppendEntries(ServerID("node2"), addr2, &AppendEntriesRequest{Term: 1}, &resp)
+	}()
+	p := waitPending(t, ctl, func(p []PendingMessage) bool { return len(p) == 1 }, 5*time.Second)
+	h := p[0].Handle
+
+	w1.Disconnect(addr2)
+	if err := ctl.Inject(h); !errors.Is(err, ErrTargetUnavailable) {
+		t.Fatalf("expected ErrTargetUnavailable, got %v", err)
+	}
+	p = ctl.Pending()
+	if len(p) != 1 || p[0].Handle != h {
+		t.Fatalf("entry was not preserved after failed inject: %+v", p)
+	}
+
+	// Reconnect and deliver: acceptance removes the entry and invalidates the
+	// handle.
+	w1.Connect(addr2, w2)
+	if err := ctl.Inject(h); err != nil {
+		t.Fatalf("inject after reconnect: %v", err)
+	}
+	if got := len(ctl.Pending()); got != 0 {
+		t.Fatalf("accepted entry still pending: %+v", ctl.Pending())
+	}
+	if err := ctl.Inject(h); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("handle stayed valid after acceptance: %v", err)
+	}
+}
