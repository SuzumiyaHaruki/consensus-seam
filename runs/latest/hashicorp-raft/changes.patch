+// newCapturedPair wires a controller and a capturing transport around two raw
+// in-memory transports connected in both directions. The controller starts in
+// pass-through mode; individual tests enable capture with SetControlled(true).
+func newCapturedPair(t *testing.T) (*MessageController, *InmemTransport, *InmemTransport, ServerAddress, *CapturingTransport) {
+	t.Helper()
+	addrA, rawA := NewInmemTransport(NewInmemAddr())
+	addrB, rawB := NewInmemTransport(NewInmemAddr())
+	rawA.Connect(addrB, rawB)
+	rawB.Connect(addrA, rawA)
+
+	controller := NewMessageController()
+	capB := NewCapturingTransport(rawB, ServerID("node-b"))
+	controller.Attach(capB)
+	t.Cleanup(func() { _ = capB.Close() })
+	return controller, rawA, rawB, addrB, capB
+}
+
+func sendAppendEntries(rawA *InmemTransport, addrB ServerAddress, data string) {
+	args := &AppendEntriesRequest{
+		RPCHeader: RPCHeader{ID: []byte("node-a"), Addr: []byte(addrB)},
+		Term:      1,
+		Entries:   []*Log{{Index: 2, Term: 1, Type: LogCommand, Data: []byte(data)}},
+	}
+	var resp AppendEntriesResponse
+	_ = rawA.AppendEntries("node-a", addrB, args, &resp)
+}
+
+func waitUntil(t *testing.T, cond func() bool, timeout time.Duration) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("condition not met within %v", timeout)
+}
+
+// waitForPending polls Pending() until match returns true and returns the last
+// matching handle.
+func waitForPending(t *testing.T, c *MessageController, match func(PendingMessage) bool) MessageHandle {
+	t.Helper()
+	var h MessageHandle
+	waitUntil(t, func() bool {
+		found := false
+		for _, pm := range c.Pending() {
+			if match(pm) {
+				h = pm.Handle
+				found = true
+			}
+		}
+		return found
+	}, 5*time.Second)
+	return h
+}
+
+func waitFuture(t *testing.T, f Future, timeout time.Duration) error {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- f.Error() }()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(timeout):
+		t.Fatalf("future did not complete within %v", timeout)
+		return nil
+	}
+}
