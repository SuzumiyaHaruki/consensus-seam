diff --git a/lifecycle_control.go b/lifecycle_control.go
new file mode 100644
index 0000000..db70d9b
--- /dev/null
+++ b/lifecycle_control.go
@@ -0,0 +1,408 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+)
+
+// ErrLifecycleUnsupported is returned by a LifecycleController operation that
+// cannot be implemented for the target without changing core protocol,
+// persistence, state-transition, or ordering semantics. It is a plain sentinel
+// so callers can classify failures with errors.Is.
+var ErrLifecycleUnsupported = errors.New("raft: lifecycle operation unsupported")
+
+// LifecycleStatus is the recorded lifecycle state of one node managed by a
+// LifecycleController.
+type LifecycleStatus int
+
+const (
+	// LifecycleRunning means the node has a live runtime that is processing
+	// protocol work.
+	LifecycleRunning LifecycleStatus = iota
+	// LifecyclePaused means the node's runtime is alive but its main
+	// protocol loops are blocked by the pause gate.
+	LifecyclePaused
+	// LifecycleStopped means the node was shut down through the target's
+	// normal shutdown path.
+	LifecycleStopped
+	// LifecycleCrashed means the node's runtime was discarded abruptly
+	// without an extra protocol-state flush.
+	LifecycleCrashed
+)
+
+func (s LifecycleStatus) String() string {
+	switch s {
+	case LifecycleRunning:
+		return "running"
+	case LifecyclePaused:
+		return "paused"
+	case LifecycleStopped:
+		return "stopped"
+	case LifecycleCrashed:
+		return "crashed"
+	default:
+		return "unknown"
+	}
+}
+
+// managedNode is one node managed by a LifecycleController: the live runtime
+// binding plus the construction parameters needed to rebuild the runtime on
+// Restart through the target's normal recovery.
+type managedNode struct {
+	id     ServerID
+	raft   *Raft
+	conf   Config
+	fsm    FSM
+	logs   LogStore
+	stable StableStore
+	snaps  SnapshotStore
+	trans  Transport
+	status LifecycleStatus
+}
+
+// LifecycleController manages the lifecycle of in-process Raft nodes: it can
+// temporarily pause and resume a running runtime, stop a node with the
+// target's normal shutdown, crash a node abruptly, and restart it through the
+// target's normal recovery using the same identity, configuration, and durable
+// stores. The controller is inert until nodes are registered: registering a
+// node never changes its behavior, and production behavior is unchanged when
+// no controller is used.
+//
+// Wiring: create the controller, construct each node with NewRaft as usual,
+// then register it so Restart can rebuild the runtime:
+//
+//	lc := raft.NewLifecycleController()
+//	r, _ := raft.NewRaft(conf, fsm, store, store, snaps, trans)
+//	_ = lc.Register(r)
+//	_ = lc.Pause("node-1")
+//	_ = lc.Resume("node-1")
+//	_ = lc.Stop("node-1")
+//	_ = lc.Restart("node-1")
+//	r2 := lc.Raft("node-1") // the fresh runtime
+//
+// Pause and Resume are implemented with a narrow, default-disabled pause gate
+// in the node's main protocol loops (a core hook): while paused, the loops
+// block before selecting, so no RPC is handled, no protocol timer action is
+// processed, and no new leadership or commit decision is made, while the same
+// runtime and its volatile state are retained. Stop, Crash, and Restart are
+// facades over the target's own Shutdown and NewRaft behavior; no protocol,
+// persistence, state-transition, or ordering semantics are changed. All
+// methods are safe for concurrent use.
+type LifecycleController struct {
+	mu    sync.Mutex
+	nodes map[ServerID]*managedNode
+}
+
+// NewLifecycleController creates an empty controller and registers every node
+// passed to it. Nodes may also be registered later with Register.
+func NewLifecycleController(nodes ...*Raft) *LifecycleController {
+	lc := &LifecycleController{nodes: make(map[ServerID]*managedNode)}
+	for _, n := range nodes {
+		_ = lc.Register(n)
+	}
+	return lc
+}
+
+// Register binds node to this controller. Registration records the node's
+// identity, runtime, and construction parameters (configuration, FSM, log and
+// stable stores, snapshot store, and transport) so that a later Restart can
+// rebuild the runtime through NewRaft with the same identity and durable
+// state. Registering an ID that is already bound replaces the binding; this is
+// how a consumer re-registers a node after building a fresh runtime with a
+// fresh transport wrapper. Register returns an error for a nil node or for a
+// node whose configuration was never stored (a zero-value or manually
+// constructed *Raft), so registration can never panic.
+func (lc *LifecycleController) Register(node *Raft) error {
+	if node == nil {
+		return errors.New("raft: cannot register a nil node with LifecycleController")
+	}
+	conf, ok := node.conf.Load().(Config)
+	if !ok {
+		return errors.New("raft: cannot register a node without a stored configuration")
+	}
+	n := &managedNode{
+		id:     node.localID,
+		raft:   node,
+		conf:   conf,
+		fsm:    node.fsm,
+		logs:   node.logs,
+		stable: node.stable,
+		snaps:  node.snapshots,
+		trans:  node.trans,
+		status: LifecycleRunning,
+	}
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	lc.nodes[node.localID] = n
+	return nil
+}
+
+// Raft returns the runtime currently bound to the registered node id, or nil
+// if the node is not registered or its runtime has been discarded by Stop or
+// Crash. After a successful Restart it returns the fresh runtime.
+func (lc *LifecycleController) Raft(id ServerID) *Raft {
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		return nil
+	}
+	return n.raft
+}
+
+// Status returns the recorded lifecycle status of the registered node id.
+func (lc *LifecycleController) Status(id ServerID) (LifecycleStatus, error) {
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		return 0, fmt.Errorf("raft: node %s is not registered with LifecycleController", id)
+	}
+	return n.status, nil
+}
+
+// Pause temporarily blocks the node's main protocol loops. The same runtime
+// and its volatile state are retained: while paused the node does not handle
+// inbound protocol messages, does not act on protocol timers, does not make
+// new leadership, commit, or apply decisions, and emits no protocol output:
+// the per-peer replication, heartbeat, pipeline, FSM-applier, and snapshot
+// loops are gated by the same default-disabled pause gate, so no AppendEntries,
+// RequestVote, snapshot, or apply work is performed while paused. The node
+// does not progress.
+// Pause waits until the node's main loop has reached a pause boundary, so when
+// it returns the node is quiescent (an operation already in flight at the time
+// of the call completes first). Pause returns an error if the node is not
+// registered or is not running.
+func (lc *LifecycleController) Pause(id ServerID) error {
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		return fmt.Errorf("raft: node %s is not registered with LifecycleController", id)
+	}
+	if n.status != LifecycleRunning {
+		return fmt.Errorf("raft: cannot pause node %s in state %s", id, n.status)
+	}
+	n.raft.setLifecyclePaused(true)
+	n.status = LifecyclePaused
+	return nil
+}
+
+// Resume unblocks the node's main protocol loops after Pause and continues
+// the same runtime. Resume returns an error if the node is not paused.
+func (lc *LifecycleController) Resume(id ServerID) error {
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		return fmt.Errorf("raft: node %s is not registered with LifecycleController", id)
+	}
+	if n.status != LifecyclePaused {
+		return fmt.Errorf("raft: cannot resume node %s in state %s", id, n.status)
+	}
+	n.raft.setLifecyclePaused(false)
+	n.status = LifecycleRunning
+	return nil
+}
+
+// Stop shuts the node down through the target's normal shutdown path
+// (Raft.Shutdown, which is documented as not graceful: it performs no extra
+// protocol-state flush) and waits for all tracked protocol goroutines to
+// exit. Durable state (term, log, snapshots, configuration) is retained by the
+// caller-owned stores and can be recovered by a later Restart. The runtime
+// binding is discarded. Stop returns an error if the node is not registered or
+// is not running or paused.
+func (lc *LifecycleController) Stop(id ServerID) error {
+	return lc.terminate(id, LifecycleStopped)
+}
+
+// Crash abruptly discards the node's runtime: it stops all activity without an
+// extra protocol-state flush and waits for all tracked protocol goroutines to
+// exit, including the auxiliary plain-go goroutines (the leadership transfer,
+// its timeout watcher, and the log-store metrics emitter), so after Crash
+// returns no execution context of the old runtime can process protocol work,
+// emit protocol output (such as a TimeoutNow request), or mutate volatile
+// state, the application state machine, or durable storage. Only state
+// already durable under the target's semantics (term, log, snapshots,
+// configuration) is retained. The runtime binding is discarded. Crash returns
+// an error if the node is not registered or is not running or paused.
+func (lc *LifecycleController) Crash(id ServerID) error {
+	return lc.terminate(id, LifecycleCrashed)
+}
+
+// terminate implements Stop and Crash. The target's Shutdown is both the
+// normal-stop and the abrupt-stop primitive (it is documented as not
+// graceful), so both operations use the same target path; the controller only
+// records which one was requested so that Restart knows the recovery
+// semantics the consumer expects.
+func (lc *LifecycleController) terminate(id ServerID, status LifecycleStatus) error {
+	verb := "stop"
+	if status == LifecycleCrashed {
+		verb = "crash"
+	}
+	lc.mu.Lock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		lc.mu.Unlock()
+		return fmt.Errorf("raft: node %s is not registered with LifecycleController", id)
+	}
+	if n.status != LifecycleRunning && n.status != LifecyclePaused {
+		lc.mu.Unlock()
+		return fmt.Errorf("raft: cannot %s node %s in state %s", verb, id, n.status)
+	}
+	r := n.raft
+	lc.mu.Unlock()
+
+	if err := r.Shutdown().Error(); err != nil {
+		return fmt.Errorf("raft: shutdown of node %s failed: %w", id, err)
+	}
+	// Wait for the auxiliary plain-go goroutines that are not part of the
+	// tracked protocol group. Every blocking point they can reach is aborted
+	// by the shutdown signal (shutdownCh, leftLeaderLoop, stopCh) or by the
+	// transport close performed by the shutdown future, so this wait is
+	// bounded and guarantees that no abandoned execution context of the old
+	// runtime survives Stop or Crash.
+	r.waitAux()
+
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	// Only discard the binding if it is still the runtime we shut down.
+	if cur, ok := lc.nodes[id]; ok && cur == n {
+		n.raft = nil
+		n.status = status
+	}
+	return nil
+}
+
+// Restart rebuilds the node's runtime through the target's normal recovery:
+// it calls NewRaft with the registered identity, configuration, FSM, and
+// durable stores. After a Stop the fresh runtime recovers the target's normal
+// post-stop state; after a Crash it recovers the pre-crash durable state with
+// a fresh runtime. The old runtime binding is replaced, stale timers and hooks
+// belong to the discarded runtime, and post-restart catch-up is left to the
+// protocol. Restart returns an error if the node is not registered or is still
+// running or paused.
+func (lc *LifecycleController) Restart(id ServerID) error {
+	lc.mu.Lock()
+	n, ok := lc.nodes[id]
+	if !ok {
+		lc.mu.Unlock()
+		return fmt.Errorf("raft: node %s is not registered with LifecycleController", id)
+	}
+	if n.status != LifecycleStopped && n.status != LifecycleCrashed {
+		lc.mu.Unlock()
+		return fmt.Errorf("raft: cannot restart node %s in state %s", id, n.status)
+	}
+	conf := n.conf
+	fsm, logs, stable, snaps := n.fsm, n.logs, n.stable, n.snaps
+	trans := n.trans
+	lc.mu.Unlock()
+
+	// In a controlled deployment the node's transport is a
+	// ControlledTransport wrapper; the old wrapper was closed with the old
+	// runtime, so the fresh runtime gets a fresh wrapper over the same
+	// underlying transport and message controller so capture and injection
+	// keep working after the restart. Pending messages captured before the
+	// stop/crash are re-bound to the fresh wrapper so their handles remain
+	// injectable after the restart (a closed-owner entry would otherwise be
+	// refused deterministically by Inject).
+	if ct, ok := trans.(*ControlledTransport); ok {
+		fresh := NewControlledTransport(ct.base, ct.controller, ct.id)
+		ct.controller.rebindOwner(ct, fresh)
+		trans = fresh
+	}
+
+	r, err := NewRaft(&conf, fsm, logs, stable, snaps, trans)
+	if err != nil {
+		return fmt.Errorf("raft: restart of node %s failed: %w", id, err)
+	}
+
+	lc.mu.Lock()
+	defer lc.mu.Unlock()
+	if cur, ok := lc.nodes[id]; ok && cur == n {
+		n.raft = r
+		n.trans = trans
+		n.conf = conf
+		n.status = LifecycleRunning
+	}
+	return nil
+}
+
+// setLifecyclePaused flips the node's pause gate. This is a narrow,
+// default-disabled test hook backing LifecycleController.Pause/Resume: while
+// the gate is set, the node's main protocol loops block before selecting so
+// no inbound message is handled, no protocol timer action is processed, and
+// no new leadership or commit decision is made. The runtime and its volatile
+// state are retained. Production behavior is unchanged while the gate is
+// never set.
+//
+// Setting the gate wakes an idle main loop through pauseNotifyCh and waits
+// until the loop acknowledges that it has reached a pause boundary, so when
+// this method returns the node is quiescent. The wait is aborted if the node
+// shuts down while pausing.
+func (r *Raft) setLifecyclePaused(paused bool) {
+	r.pausedMu.Lock()
+	if r.paused.Load() == paused {
+		r.pausedMu.Unlock()
+		return
+	}
+	r.paused.Store(paused)
+	if paused {
+		r.pausedCh = make(chan struct{})
+		r.pausedAckCh = make(chan struct{}, 1)
+		select {
+		case r.pauseNotifyCh <- struct{}{}:
+		default:
+		}
+		ack := r.pausedAckCh
+		r.pausedMu.Unlock()
+
+		select {
+		case <-ack:
+		case <-r.shutdownCh:
+		}
+		return
+	}
+	if r.pausedCh != nil {
+		close(r.pausedCh)
+	}
+	r.pausedCh = nil
+	r.pausedAckCh = nil
+	// Drain any stale wake-up so resumed loops do not spin on it.
+	select {
+	case <-r.pauseNotifyCh:
+	default:
+	}
+	r.pausedMu.Unlock()
+}
+
+// waitWhilePaused blocks the calling protocol loop while the pause gate is
+// set. It returns false if the node shuts down while waiting, in which case
+// the caller must exit its loop.
+func (r *Raft) waitWhilePaused() bool {
+	for r.paused.Load() {
+		r.pausedMu.Lock()
+		ch := r.pausedCh
+		ack := r.pausedAckCh
+		r.pausedMu.Unlock()
+		if ch == nil {
+			return true
+		}
+		if ack != nil {
+			select {
+			case ack <- struct{}{}:
+			default:
+			}
+		}
+		select {
+		case <-ch:
+		case <-r.shutdownCh:
+			return false
+		}
+	}
+	return true
+}
