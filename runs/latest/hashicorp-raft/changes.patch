+	go func() {
+		args := &AppendEntriesRequest{RPCHeader: RPCHeader{ID: []byte("node-a")}, Term: 1}
+		var resp AppendEntriesResponse
+		err := rawA.AppendEntries("node-a", addrB, args, &resp)
+		if err == nil && resp.Success && resp.Term == 1 {
+			sendCh <- nil
+			return
+		}
+		sendCh <- fmt.Errorf("unexpected send result: err=%v resp=%+v", err, resp)
+	}()
+
+	reqHandle := waitForPending(t, c, func(pm PendingMessage) bool {
+		return pm.Kind == MessageKindAppendEntries
+	})
+
+	// Simulate the normal responder writing the protocol response into the
+	// swapped response channel (raft's processRPC -> rpc.Respond).
+	c.mu.Lock()
+	entry := c.entries[reqHandle]
+	c.mu.Unlock()
+	require.NotNil(t, entry)
+	entry.captureCh <- RPCResponse{
+		Response: &AppendEntriesResponse{RPCHeader: RPCHeader{ID: []byte("node-b")}, Term: 1, Success: true},
+	}
+
+	// The response is captured as a separate entry with a new handle and
+	// reversed routing.
+	respHandle := waitForPending(t, c, func(pm PendingMessage) bool {
+		return pm.Kind == MessageKindAppendEntriesResponse &&
+			pm.Source == ServerID("node-b") && pm.Target == ServerID("node-a")
+	})
+	require.NotEqual(t, reqHandle, respHandle)
+
+	// Injecting the response completes the original synchronous caller.
+	require.NoError(t, c.Inject(respHandle))
+	select {
+	case err := <-sendCh:
+		require.NoError(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("original sender did not complete after response injection")
+	}
+
+	// The response handle is invalid after a successful inject.
+	require.ErrorIs(t, c.Inject(respHandle), ErrMessageNotPending)
+
+	// The request entry was never injected and remains pending; dropping it
+	// releases its resources.
+	require.NoError(t, c.Drop(reqHandle))
+	require.Empty(t, c.Pending())
+}
+
+func TestMessageControllerInstallSnapshotBuffering(t *testing.T) {
+	c, rawA, _, addrB, _ := newCapturedPair(t)
+	c.SetControlled(true)
+
+	data := []byte("snapshot-payload-0123456789")
+	reader := bytes.NewReader(data)
+	go func() {
+		args := &InstallSnapshotRequest{RPCHeader: RPCHeader{ID: []byte("node-a")}, Term: 1, Size: int64(len(data))}
+		var resp InstallSnapshotResponse
+		_ = rawA.InstallSnapshot("node-a", addrB, args, &resp, reader)
+	}()
+
+	h := waitForPending(t, c, func(pm PendingMessage) bool {
+		return pm.Kind == MessageKindInstallSnapshot
+	})
+	require.Len(t, c.Pending(), 1)
+	require.Equal(t, MessageKindInstallSnapshot, c.Pending()[0].Kind)
+
+	// The one-shot original stream must be fully consumed at capture so the
+	// controller owns an independently replayable copy.
+	require.Zero(t, reader.Len())
+	require.Equal(t, int64(len(data)), reader.Size())
+
+	c.mu.Lock()
+	entry := c.entries[h]
+	c.mu.Unlock()
+	require.NotNil(t, entry)
+	require.NotNil(t, entry.rpc.Reader)
+	replayed, err := io.ReadAll(entry.rpc.Reader)
+	require.NoError(t, err)
+	require.Equal(t, data, replayed)
+}
+
+func TestMessageControllerEndToEnd(t *testing.T) {
+	addrA, rawA := NewInmemTransport(NewInmemAddr())
+	addrB, rawB := NewInmemTransport(NewInmemAddr())
+	rawA.Connect(addrB, rawB)
+	rawB.Connect(addrA, rawA)
+
+	controller := NewMessageController()
+	capA := NewCapturingTransport(rawA, ServerID("node-a"))
+	capB := NewCapturingTransport(rawB, ServerID("node-b"))
+	controller.Attach(capA)
+	controller.Attach(capB)
+
+	confA := inmemConfig(t)
+	confA.LocalID = ServerID("node-a")
+	confB := inmemConfig(t)
+	confB.LocalID = ServerID("node-b")
+	// Keep node-b from campaigning on its own so the captured exchange stays
+	// the only path for node-a to commit.
+	confB.HeartbeatTimeout = 5 * time.Second
+	confB.ElectionTimeout = 5 * time.Second
+	confB.LeaderLeaseTimeout = 5 * time.Second
+
+	nodeA, err := NewRaft(confA, &MockFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), capA)
+	require.NoError(t, err)
+	nodeB, err := NewRaft(confB, &MockFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), capB)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		controller.Clear()
+		_ = nodeA.Shutdown().Error()
+		_ = nodeB.Shutdown().Error()
+	})
+
+	config := Configuration{Servers: []Server{
+		{Suffrage: Voter, ID: ServerID("node-a"), Address: addrA},
+		{Suffrage: Voter, ID: ServerID("node-b"), Address: addrB},
+	}}
+	require.NoError(t, nodeA.BootstrapCluster(config).Error())
+	require.NoError(t, nodeB.BootstrapCluster(config).Error())
+
+	waitUntil(t, func() bool { return nodeA.State() == Leader }, 10*time.Second)
+
+	// Phase 1: capture disabled (the default) - production behavior is
+	// unchanged and nothing is retained.
+	f1 := nodeA.Apply([]byte("phase-one"), 0)
+	require.NoError(t, waitFuture(t, f1, 10*time.Second))
+	require.Empty(t, controller.Pending())
+
+	// Phase 2: controlled mode - the Apply can only commit after the captured
+	// AppendEntries and its response are injected through the normal ingress.
+	controller.SetControlled(true)
+	f2 := nodeA.Apply([]byte("phase-two"), 0)
+
+	reqHandle := waitForPending(t, controller, func(pm PendingMessage) bool {
+		if pm.Kind != MessageKindAppendEntries || pm.Target != ServerID("node-b") {
+			return false
+		}
+		ae, ok := pm.Message.(*AppendEntriesRequest)
+		return ok && len(ae.Entries) > 0
+	})
+	require.NoError(t, controller.Inject(reqHandle))
+
+	respHandle := waitForPending(t, controller, func(pm PendingMessage) bool {
+		return pm.Kind == MessageKindAppendEntriesResponse &&
+			pm.Source == ServerID("node-b") && pm.Target == ServerID("node-a")
+	})
+	require.NoError(t, controller.Inject(respHandle))
+
+	require.NoError(t, waitFuture(t, f2, 15*time.Second))
+}
