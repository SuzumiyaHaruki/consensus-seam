+// TestTimeControllerRegister verifies the optional node registry rejects nil
+// and duplicate registrations.
+func TestTimeControllerRegister(t *testing.T) {
+	tc := NewTimeController(time.Millisecond)
+	if err := tc.Register(nil); err == nil {
+		t.Fatalf("expected error registering nil node")
+	}
+	if err := tc.Register(&Raft{localID: ServerID("node-1")}); err != nil {
+		t.Fatalf("unexpected registration error: %v", err)
+	}
+	if err := tc.Register(&Raft{localID: ServerID("node-1")}); err == nil {
+		t.Fatalf("expected duplicate registration error")
+	}
+}
+
+// TestTimeControllerSkipsPausedAndStoppedNodes verifies the lifecycle-aware
+// step exclusion: while a node is paused, Advance delivers no steps to it
+// (its due timers are held, so no timer action or election can start), and
+// after Resume the held timers fire on later Advances and drive the election.
+// It also verifies that Advance after Stop discards the stale timers of the
+// discarded runtime without delivering them or hanging.
+func TestTimeControllerSkipsPausedAndStoppedNodes(t *testing.T) {
+	tc, r := controlledTestNode(t, time.Millisecond)
+	lc := NewLifecycleController(r)
+
+	if err := lc.Pause(ServerID("node-1")); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+	// Advance far past the heartbeat and election timeouts: a paused node
+	// must not receive any of these steps.
+	if err := tc.Advance(500); err != nil {
+		t.Fatalf("Advance failed: %v", err)
+	}
+	if got := r.State(); got != Follower {
+		t.Fatalf("paused node received steps: expected Follower, got %v", got)
+	}
+
+	if err := lc.Resume(ServerID("node-1")); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+	// The held heartbeat timer fires on later Advances and starts the
+	// election, which completes once the election timer is stepped to.
+	deadline := time.Now().Add(5 * time.Second)
+	for r.State() != Leader && time.Now().Before(deadline) {
+		if err := tc.Advance(25); err != nil {
+			t.Fatalf("Advance failed: %v", err)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if got := r.State(); got != Leader {
+		t.Fatalf("expected Leader after resume and Advance, got %v", got)
+	}
+
+	// After Stop the runtime is discarded: Advance drops its stale timers
+	// instead of delivering them, and must not hang or panic.
+	if err := lc.Stop(ServerID("node-1")); err != nil {
+		t.Fatalf("Stop failed: %v", err)
+	}
+	if err := tc.Advance(100); err != nil {
+		t.Fatalf("Advance after Stop failed: %v", err)
+	}
+}
+
+func assertTimerFired(t *testing.T, ch <-chan time.Time) {
+	t.Helper()
+	select {
+	case <-ch:
+	default:
+		t.Fatalf("timer did not fire")
+	}
+}
+
+func assertTimerNotFired(t *testing.T, ch <-chan time.Time) {
+	t.Helper()
+	select {
+	case <-ch:
+		t.Fatalf("timer fired unexpectedly")
+	default:
+	}
+}
