diff --git a/time_controller.go b/time_controller.go
new file mode 100644
index 0000000..c82b2ab
--- /dev/null
+++ b/time_controller.go
@@ -0,0 +1,358 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"container/heap"
+	"runtime"
+	"sync"
+	"time"
+)
+
+// TimeController manually advances protocol time for one or more *Raft nodes.
+// While a node has a TimeController installed (via Config.TimeController
+// before NewRaft), every in-boundary protocol timer of that node - the
+// heartbeat, election, commit, heartbeat-interval, leader-lease and
+// snapshot-interval timers, replication backoff waits, and in-boundary
+// InmemTransport RPC send/command/pipeline timeouts - and every protocol clock
+// read (last-contact updates and lease checks) is served from the
+// controller's shared virtual clock instead of the real clock. Protocol time
+// then progresses only when Advance is called: each step advances every
+// attached running subject by one configured unit.
+//
+// A controller is inactive by default: nodes without Config.TimeController use
+// the real clock exactly as before, so ordinary production behavior is
+// unchanged. Install the controller before calling NewRaft so no uncontrolled
+// timer can be armed; the controller is not reloadable at runtime.
+type TimeController struct {
+	mu       sync.Mutex
+	step     time.Duration
+	now      time.Time
+	nextSeq  uint64
+	timers   timerHeap
+	subjects map[*Raft]struct{}
+	// regs counts, per subject, every timer registration served by this
+	// controller. Advance uses it to observe that a subject has made progress
+	// (consumed a delivered timer and re-armed) between steps.
+	regs map[*Raft]uint64
+}
+
+// timeTimer is one virtual timer registered on the shared clock. It belongs to
+// the subject that armed it; timers of subjects that are no longer running are
+// never delivered as steps.
+type timeTimer struct {
+	deadline time.Time
+	seq      uint64
+	ch       chan time.Time
+	subject  *Raft
+	// rearmable marks periodic protocol timers (heartbeat, election, commit,
+	// heartbeat-interval, snapshot and leader-lease timers) whose consuming
+	// goroutine always registers a replacement timer after consuming them.
+	// One-shot waits (backoff, transfer timeouts) are not rearmable.
+	rearmable bool
+	// transport marks an in-boundary InmemTransport RPC timeout timer. Unlike
+	// protocol timers these are resolved (delivered immediately) when their
+	// subject detaches, so goroutines blocked in a transport RPC wait can
+	// complete while the node stops instead of being stranded forever.
+	transport bool
+}
+
+// NewTimeController creates a TimeController whose virtual clock advances by
+// step for every Advance(1) call. step must be positive; a non-positive value
+// falls back to 1 millisecond. Subjects are attached by NewRaft when
+// Config.TimeController is set, so the controller is constructed before the
+// node and then wired through the configuration.
+func NewTimeController(step time.Duration) *TimeController {
+	if step <= 0 {
+		step = time.Millisecond
+	}
+	return &TimeController{
+		step:     step,
+		subjects: make(map[*Raft]struct{}),
+		regs:     make(map[*Raft]uint64),
+	}
+}
+
+// Advance advances the shared virtual clock by steps units, one unit at a
+// time. After every unit, all timers of running subjects whose deadline has
+// been reached are delivered through their channels in deadline order (stable
+// registration order for equal deadlines). Between steps, Advance yields to
+// the protocol goroutines until every delivered timer has been received by
+// its subject and every timer re-armed in reaction to an earlier step has
+// been registered, so each step exposes exactly the same boundary as a
+// separate Advance(1) call and Advance(n) never skips intermediate reactive
+// re-arms. Advance returns after the boundary of the final step has closed;
+// it does not wait for the protocol goroutines to finish processing the
+// delivered events, for resulting messages, or for state transitions.
+func (c *TimeController) Advance(steps uint64) error {
+	for i := uint64(0); i < steps; i++ {
+		delivered := c.stepOnce()
+		c.settle(delivered)
+	}
+	return nil
+}
+
+// stepOnce advances the clock by one unit and delivers every timer that became
+// due, returning the delivered timers so the caller can wait for their
+// consumers before the next step. Must not be called with c.mu held by the
+// caller.
+func (c *TimeController) stepOnce() []*timeTimer {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.now = c.now.Add(c.step)
+	var delivered []*timeTimer
+	for len(c.timers) > 0 {
+		t := c.timers[0]
+		if t.deadline.After(c.now) {
+			break
+		}
+		heap.Pop(&c.timers)
+		if _, ok := c.subjects[t.subject]; !ok {
+			// The owning subject is no longer running: it receives no steps.
+			continue
+		}
+		select {
+		case t.ch <- t.deadline:
+			delivered = append(delivered, t)
+		default:
+			// The channel is already full, which cannot happen in practice:
+			// every timeAfter call creates a fresh channel with a single
+			// buffered slot and only the controller sends on it.
+		}
+	}
+	return delivered
+}
+
+// settle yields to the protocol goroutines after a step until the timers
+// delivered at that step have been received by their subjects and any timer
+// re-armed in reaction has been registered on the shared clock. This is what
+// gives every step of Advance(n) the same boundary as a separate Advance(1)
+// call: a re-armed timer is registered with a deadline computed against the
+// step's virtual time before the next step advances the clock.
+//
+// The wait is bounded so Advance can never stall: a consumer that is blocked
+// on another virtual timer (for example a replicate goroutine inside a
+// transport RPC call whose timeout is due at a later step) or that consumed a
+// one-shot timer without re-arming simply stops being waited for, and its
+// re-arm - if any - is registered whenever it runs, with a deadline computed
+// against the virtual time at that moment, exactly as with separate
+// Advance(1) calls.
+func (c *TimeController) settle(delivered []*timeTimer) {
+	if len(delivered) == 0 {
+		return
+	}
+
+	c.mu.Lock()
+	// Registration snapshot per subject taken after the step's deliveries: a
+	// re-arm that already happened (a fast consumer) is registered with the
+	// correct deadline and needs no further waiting.
+	snap := make(map[*Raft]uint64, len(delivered))
+	for _, t := range delivered {
+		if _, ok := snap[t.subject]; !ok {
+			snap[t.subject] = c.regs[t.subject]
+		}
+	}
+	c.mu.Unlock()
+
+	// A delivered timer is settled once its channel has been drained (the
+	// subject received it) and, for rearmable timers, the subject has
+	// registered at least one new timer since the delivery (the re-arm). The
+	// yield loop gives the consuming goroutines a chance to run; the
+	// iteration budget keeps consumers blocked on later virtual timers,
+	// one-shot consumers that never re-arm, and detached or paused subjects
+	// from stalling Advance.
+	remaining := delivered
+	for budget := 0; len(remaining) > 0 && budget < settleYieldBudget; budget++ {
+		runtime.Gosched()
+		c.mu.Lock()
+		still := remaining[:0]
+		for _, t := range remaining {
+			if len(t.ch) == 0 && (!t.rearmable || c.regs[t.subject] > snap[t.subject]) {
+				continue // received, and any re-arm has been registered
+			}
+			still = append(still, t)
+		}
+		c.mu.Unlock()
+		remaining = still
+	}
+}
+
+// settleYieldBudget bounds the scheduler-yield loop of one settle call, so a
+// step whose delivered timers are consumed by goroutines blocked elsewhere
+// costs at most a few hundred yields (~tens of microseconds) instead of
+// stalling Advance.
+const settleYieldBudget = 512
+
+// current returns the current virtual time.
+func (c *TimeController) current() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+// attach registers r as a running controlled subject. NewRaft calls this when
+// Config.TimeController is set, before the node starts its goroutines.
+func (c *TimeController) attach(r *Raft) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.subjects[r] = struct{}{}
+}
+
+// pause removes r from the set of running controlled subjects without
+// discarding its timers. A paused subject then receives no time steps until
+// resume re-attaches it, at which point its pending timers are delivered again
+// once Advance passes their deadlines. LifecycleController.Pause calls this
+// when the node has a TimeController installed; unlike detach, the timers are
+// kept so protocol timeout behavior after resume is unchanged.
+func (c *TimeController) pause(r *Raft) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	delete(c.subjects, r)
+}
+
+// resume re-attaches r so its pending timers are delivered by Advance again.
+// See pause.
+func (c *TimeController) resume(r *Raft) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.subjects[r] = struct{}{}
+}
+
+// detach marks r as stopped. Every protocol timer armed by r is discarded (the
+// stopped subject receives no further steps); in-flight transport RPC timeout
+// timers are delivered immediately so blocked transport RPC waits resolve.
+// Shutdown calls this when a controlled node stops.
+func (c *TimeController) detach(r *Raft) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	delete(c.subjects, r)
+	kept := c.timers[:0]
+	for _, t := range c.timers {
+		if t.subject != r {
+			kept = append(kept, t)
+			continue
+		}
+		if t.transport {
+			select {
+			case t.ch <- t.deadline:
+			default:
+			}
+		}
+	}
+	c.timers = kept
+	heap.Init(&c.timers)
+}
+
+// after registers a virtual one-shot timer owned by subject r that delivers
+// one value when Advance has advanced the clock past now+d. The returned
+// channel is buffered so delivery never blocks the advancing goroutine.
+func (c *TimeController) after(r *Raft, d time.Duration) <-chan time.Time {
+	return c.addTimer(r, d, false, false)
+}
+
+// afterRearmable registers a virtual periodic protocol timer owned by subject
+// r - one whose consuming goroutine always registers a replacement timer
+// after consuming it (see timeTimer.rearmable).
+func (c *TimeController) afterRearmable(r *Raft, d time.Duration) <-chan time.Time {
+	return c.addTimer(r, d, false, true)
+}
+
+// addTimer is the shared implementation of after and of the transport timeout
+// hook returned by afterFor.
+func (c *TimeController) addTimer(r *Raft, d time.Duration, transport, rearmable bool) <-chan time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.nextSeq++
+	c.regs[r]++
+	t := &timeTimer{
+		deadline:  c.now.Add(d),
+		seq:       c.nextSeq,
+		ch:        make(chan time.Time, 1),
+		subject:   r,
+		rearmable: rearmable,
+		transport: transport,
+	}
+	heap.Push(&c.timers, t)
+	return t.ch
+}
+
+// afterFor returns a closure that registers transport timers on c attributed
+// to r. NewRaft wires the node's in-boundary InmemTransport to it so RPC
+// timeouts advance only through Advance while the node is controlled.
+func (c *TimeController) afterFor(r *Raft) func(time.Duration) <-chan time.Time {
+	return func(d time.Duration) <-chan time.Time {
+		return c.addTimer(r, d, true, false)
+	}
+}
+
+// timeAfter returns a channel that receives one value when this node's
+// protocol time reaches d from now. With a TimeController installed the timer
+// is registered on the controller's virtual clock and fires only as Advance
+// progresses; otherwise time.After is used, so production behavior is
+// unchanged.
+func (r *Raft) timeAfter(d time.Duration) <-chan time.Time {
+	if tc := r.config().TimeController; tc != nil {
+		return tc.after(r, d)
+	}
+	return time.After(d)
+}
+
+// timeAfterRearmable arms a periodic protocol timer on the node's protocol
+// clock (see TimeController.afterRearmable). With a TimeController installed
+// the timer is marked rearmable so Advance can wait for its replacement when
+// it fires; otherwise time.After is used and production behavior is unchanged.
+func (r *Raft) timeAfterRearmable(d time.Duration) <-chan time.Time {
+	if tc := r.config().TimeController; tc != nil {
+		return tc.afterRearmable(r, d)
+	}
+	return time.After(d)
+}
+
+// timeNow returns this node's current protocol time: the controller's virtual
+// clock when a TimeController is installed, the real clock otherwise.
+func (r *Raft) timeNow() time.Time {
+	if tc := r.config().TimeController; tc != nil {
+		return tc.current()
+	}
+	return time.Now()
+}
+
+// controlledInmemTransport unwraps trans to find an *InmemTransport whose RPC
+// timeouts can be wired to a virtual clock, following CapturingTransport
+// decorators. It returns nil for out-of-boundary transports such as
+// NetworkTransport, whose socket timeouts are outside the protocol plane.
+func controlledInmemTransport(trans Transport) *InmemTransport {
+	switch t := trans.(type) {
+	case *InmemTransport:
+		return t
+	case *CapturingTransport:
+		return controlledInmemTransport(t.trans)
+	}
+	return nil
+}
+
+// timerHeap is a min-heap of virtual timers ordered by deadline, with stable
+// registration order for equal deadlines.
+type timerHeap []*timeTimer
+
+func (h timerHeap) Len() int { return len(h) }
+
+func (h timerHeap) Less(i, j int) bool {
+	if h[i].deadline.Equal(h[j].deadline) {
+		return h[i].seq < h[j].seq
+	}
+	return h[i].deadline.Before(h[j].deadline)
+}
+
+func (h timerHeap) Swap(i, j int) { h[i], h[j] = h[j], h[i] }
+
+func (h *timerHeap) Push(x interface{}) { *h = append(*h, x.(*timeTimer)) }
+
+func (h *timerHeap) Pop() interface{} {
+	old := *h
+	n := len(old)
+	x := old[n-1]
+	*h = old[:n-1]
+	return x
+}
diff --git a/time_controller_test.go b/time_controller_test.go
new file mode 100644
index 0000000..6abd650
--- /dev/null
+++ b/time_controller_test.go
@@ -0,0 +1,294 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// newTimeTestSubject returns a bare *Raft wired to tc through its config, the
+// same way NewRaft wires a node before starting its goroutines. It is enough
+// for the protocol-clock accessors (timeAfter/timeNow) and does not start any
+// protocol work.
+func newTimeTestSubject(t *testing.T, tc *TimeController) *Raft {
+	t.Helper()
+	r := &Raft{}
+	r.conf.Store(Config{TimeController: tc})
+	tc.attach(r)
+	t.Cleanup(func() { tc.detach(r) })
+	return r
+}
+
+func TestTimeControllerUnit(t *testing.T) {
+	t.Run("time does not progress without Advance", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+
+		ch := r.timeAfter(1 * time.Millisecond)
+		select {
+		case <-ch:
+			t.Fatal("timer fired before any Advance")
+		default:
+		}
+
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-ch:
+		default:
+			t.Fatal("timer did not fire after one step")
+		}
+	})
+
+	t.Run("each step delivers only the timers due for that unit", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+
+		early := r.timeAfter(1 * time.Millisecond)
+		late := r.timeAfter(3 * time.Millisecond)
+
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-early:
+		default:
+			t.Fatal("1ms timer did not fire on its step")
+		}
+		select {
+		case <-late:
+			t.Fatal("3ms timer fired before its deadline")
+		default:
+		}
+
+		require.NoError(t, tc.Advance(2))
+		select {
+		case <-late:
+		default:
+			t.Fatal("3ms timer did not fire after the remaining steps")
+		}
+	})
+
+	t.Run("Advance(n) exposes per-step boundaries including re-armed timers", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+
+		first := r.timeAfter(2 * time.Millisecond)
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-first:
+			t.Fatal("2ms timer fired one step early")
+		default:
+		}
+
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-first:
+		default:
+			t.Fatal("2ms timer did not fire on its step")
+		}
+
+		// A timer armed in reaction to the previous step only becomes due
+		// through a further Advance(1); Advance(n) does not skip that boundary.
+		rearmed := r.timeAfter(1 * time.Millisecond)
+		require.NoError(t, tc.Advance(2))
+		select {
+		case <-rearmed:
+		default:
+			t.Fatal("re-armed timer did not fire through its own step boundary")
+		}
+	})
+
+	t.Run("detached subjects receive no steps", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+
+		ch := r.timeAfter(1 * time.Millisecond)
+		tc.detach(r)
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-ch:
+			t.Fatal("detached subject's timer was delivered")
+		default:
+		}
+	})
+
+	t.Run("transport timeout hook advances only through the controller", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+		_, trans := NewInmemTransport(NewInmemAddr())
+		trans.setAfter(tc.afterFor(r))
+
+		timeoutCh := trans.after(1 * time.Millisecond)
+		select {
+		case <-timeoutCh:
+			t.Fatal("transport timeout fired before any Advance")
+		default:
+		}
+		require.NoError(t, tc.Advance(1))
+		select {
+		case <-timeoutCh:
+		default:
+			t.Fatal("transport timeout did not fire after one step")
+		}
+	})
+}
+
+// TestTimeControllerNodeWiring verifies that a controller installed through
+// Config.TimeController before NewRaft is attached to the fresh node and its
+// in-boundary InmemTransport before any goroutine starts, and that Shutdown
+// detaches the node so it receives no further steps.
+func TestTimeControllerNodeWiring(t *testing.T) {
+	tc := NewTimeController(time.Millisecond)
+
+	_, trans := NewInmemTransport(NewInmemAddr())
+	conf := inmemConfig(t)
+	conf.LocalID = ServerID("node-a")
+	conf.TimeController = tc
+	conf.skipStartup = true
+
+	node, err := NewRaft(conf, &MockFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), trans)
+	require.NoError(t, err)
+
+	// The node's protocol clock and its transport timeouts are both served by
+	// the virtual clock: neither fires until Advance progresses.
+	nodeCh := node.timeAfter(1 * time.Millisecond)
+	transCh := trans.after(1 * time.Millisecond)
+	select {
+	case <-nodeCh:
+		t.Fatal("node timer fired before Advance")
+	case <-transCh:
+		t.Fatal("transport timeout fired before Advance")
+	default:
+	}
+	require.NoError(t, tc.Advance(1))
+	select {
+	case <-nodeCh:
+	default:
+		t.Fatal("node timer did not fire after Advance")
+	}
+	select {
+	case <-transCh:
+	default:
+		t.Fatal("transport timeout did not fire after Advance")
+	}
+
+	// Shutdown detaches the node: timers armed afterwards are never delivered.
+	require.NoError(t, node.Shutdown().Error())
+	late := node.timeAfter(1 * time.Millisecond)
+	require.NoError(t, tc.Advance(1))
+	select {
+	case <-late:
+		t.Fatal("shutdown node's timer was delivered")
+	default:
+	}
+	require.Equal(t, Shutdown, node.State())
+}
+
+// TestTimeControllerAdvanceReactiveReArming is a regression for the Advance
+// step-boundary guarantee: a timer re-armed in reaction to step i's delivery
+// must be registered before step i+1 advances the clock, so a single
+// Advance(n) exposes the same boundaries as n separate Advance(1) calls and
+// never skips intermediate reactive re-arms.
+func TestTimeControllerAdvanceReactiveReArming(t *testing.T) {
+	t.Run("synthetic consumer re-arms in reaction to every delivery", func(t *testing.T) {
+		tc := NewTimeController(time.Millisecond)
+		r := newTimeTestSubject(t, tc)
+
+		var deliveries int32
+		done := make(chan struct{})
+		consumerDone := make(chan struct{})
+		armed := make(chan struct{})
+		go func() {
+			defer close(consumerDone)
+			ch := r.timeAfter(1 * time.Millisecond)
+			close(armed) // the initial timer is registered
+			for {
+				select {
+				case <-ch:
+					atomic.AddInt32(&deliveries, 1)
+					// Re-arm in reaction to the delivery, exactly like the
+					// protocol loops do for their periodic timers.
+					ch = r.timeAfter(1 * time.Millisecond)
+				case <-done:
+					return
+				}
+			}
+		}()
+		<-armed
+
+		// One Advance(2) must deliver twice: the re-arm from the first
+		// delivery is registered before the second step, and both deliveries
+		// are consumed before Advance returns.
+		require.NoError(t, tc.Advance(2))
+		require.Equal(t, int32(2), atomic.LoadInt32(&deliveries))
+
+		// The re-arm from the second delivery fires through a further step,
+		// proving the boundary of the final step is closed as well.
+		require.NoError(t, tc.Advance(1))
+		require.Equal(t, int32(3), atomic.LoadInt32(&deliveries))
+
+		close(done)
+		select {
+		case <-consumerDone:
+		case <-time.After(2 * time.Second):
+			t.Fatal("consumer did not exit")
+		}
+	})
+
+	t.Run("follower heartbeat re-arms across one Advance call", func(t *testing.T) {
+		// The reviewer scenario: a follower whose heartbeat timeout is one
+		// step must receive one heartbeat delivery per step of a single
+		// Advance(n). The RandomController records one "heartbeat" draw per
+		// timer arming, so the draw count is the delivery count plus the
+		// initial arming, and the settle guarantees the re-arm draws are
+		// recorded before Advance returns. The minimum configurable heartbeat
+		// is 5ms, so one step is 5ms.
+		const step = 5 * time.Millisecond
+		tc := NewTimeController(step)
+		rc := NewRandomController(42)
+		conf := inmemConfig(t)
+		conf.LocalID = ServerID("time-node")
+		conf.skipStartup = true
+		conf.TimeController = tc
+		conf.RandomController = rc
+		conf.HeartbeatTimeout = step
+		conf.LeaderLeaseTimeout = step // must not exceed HeartbeatTimeout (ValidateConfig)
+
+		_, trans := NewInmemTransport(ServerAddress("time-node"))
+		node, err := NewRaft(conf, &MockFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), trans)
+		require.NoError(t, err)
+
+		loopDone := make(chan struct{})
+		go func() {
+			defer close(loopDone)
+			node.runFollower()
+		}()
+
+		// Wait until the follower has armed its initial heartbeat timer.
+		deadline := time.Now().Add(2 * time.Second)
+		for len(rc.Choices()) < 1 {
+			if time.Now().After(deadline) {
+				t.Fatal("follower did not arm its heartbeat timer")
+			}
+			time.Sleep(5 * time.Millisecond)
+		}
+
+		require.NoError(t, tc.Advance(4))
+		// Initial arming plus one re-arm per delivered heartbeat: with
+		// per-step boundaries a one-step heartbeat is delivered at least
+		// twice in four steps (each re-armed deadline lands within two
+		// steps), so at least three draws must be recorded by the time
+		// Advance returns.
+		require.GreaterOrEqual(t, len(rc.Choices()), 3)
+
+		require.NoError(t, node.Shutdown().Error())
+		select {
+		case <-loopDone:
+		case <-time.After(2 * time.Second):
+			t.Fatal("follower loop did not exit after shutdown")
+		}
+	})
+}
diff --git a/util.go b/util.go
index 09c7742..d338179 100644
--- a/util.go
+++ b/util.go
@@ -35,8 +35,15 @@ func randomTimeout(minVal time.Duration) <-chan time.Time {
 	if minVal == 0 {
 		return nil
 	}
-	extra := time.Duration(rand.Int63()) % minVal
-	return time.After(minVal + extra)
+	return time.After(minVal + randomExtra(minVal))
+}
+
+// randomExtra returns the random staggering extra for a timeout of minVal,
+// in [0, minVal), mirroring the historic randomTimeout behavior. It is split
+// out so controlled nodes can draw the same staggering through their
+// RandomController/TimeController while keeping the package default intact.
+func randomExtra(minVal time.Duration) time.Duration {
+	return time.Duration(rand.Int63()) % minVal
 }
 
