+func TestLifecycleController_StopWhilePaused(t *testing.T) {
+	node, lc, cleanup := lifecycleTestEnv(t)
+	defer cleanup()
+
+	if err := lc.Pause(node); err != nil {
+		t.Fatalf("pause: %v", err)
+	}
+	// Shutdown must unblock every pause gate so the runtime terminates.
+	if err := lc.Stop(node); err != nil {
+		t.Fatalf("stop while paused: %v", err)
+	}
+	if err := lc.Restart(node); err != nil {
+		t.Fatalf("restart after stop: %v", err)
+	}
+	if lc.Node() == node {
+		t.Fatalf("expected a fresh runtime")
+	}
+}
+
+func TestLifecycleController_CrashRestart(t *testing.T) {
+	node, lc, cleanup := lifecycleTestEnv(t)
+	defer cleanup()
+
+	if err := lc.Crash(node); err != nil {
+		t.Fatalf("crash: %v", err)
+	}
+	if state := node.State(); state != Shutdown {
+		t.Fatalf("expected terminated runtime, got %v", state)
+	}
+	if err := lc.Crash(node); err != nil {
+		t.Fatalf("second crash: %v", err)
+	}
+
+	// Restart after a crash recovers pre-crash durable state with a fresh runtime.
+	if err := lc.Restart(node); err != nil {
+		t.Fatalf("restart after crash: %v", err)
+	}
+	node2 := lc.Node()
+	if node2 == node {
+		t.Fatalf("expected a fresh runtime after crash restart")
+	}
+	if node2.localID != node.localID {
+		t.Fatalf("identity changed: %q != %q", node2.localID, node.localID)
+	}
+	if err := lc.Stop(node2); err != nil {
+		t.Fatalf("stop fresh runtime: %v", err)
+	}
+}
