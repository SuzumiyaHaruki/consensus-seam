@@ -0,0 +1,119 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRandomControllerUnit(t *testing.T) {
+	t.Run("same seed reproduces the same draw sequence", func(t *testing.T) {
+		a := NewRandomController(42)
+		b := NewRandomController(42)
+		for i := 0; i < 8; i++ {
+			da := a.draw(ServerID("node-a"), "heartbeat", 100*time.Millisecond)
+			db := b.draw(ServerID("node-a"), "heartbeat", 100*time.Millisecond)
+			require.Equal(t, da, db)
+		}
+		ca, cb := a.Choices(), b.Choices()
+		require.Len(t, ca, 8)
+		require.Len(t, cb, 8)
+		for i := range ca {
+			require.Equal(t, ca[i], cb[i])
+		}
+	})
+
+	t.Run("draws stay in the legal domain and vary", func(t *testing.T) {
+		c := NewRandomController(7)
+		const minVal = 100 * time.Millisecond
+		first := c.draw(ServerID("node-a"), "election", minVal)
+		second := c.draw(ServerID("node-a"), "election", minVal)
+		require.GreaterOrEqual(t, first, time.Duration(0))
+		require.Less(t, first, minVal)
+		require.GreaterOrEqual(t, second, time.Duration(0))
+		require.Less(t, second, minVal)
+		// Repeated decisions draw the next value instead of reusing one.
+		require.NotEqual(t, first, second)
+	})
+
+	t.Run("Choices returns independent deep copies", func(t *testing.T) {
+		c := NewRandomController(1)
+		c.draw(ServerID("node-a"), "heartbeat", 50*time.Millisecond)
+		got := c.Choices()
+		require.Len(t, got, 1)
+		require.Equal(t, ServerID("node-a"), got[0].Owner)
+		require.Equal(t, "heartbeat", got[0].Name)
+
+		// Mutating a returned snapshot never affects the controller or later
+		// snapshots.
+		got[0].Value = 123
+		require.NotEqual(t, time.Duration(123), c.Choices()[0].Value)
+	})
+
+	t.Run("owners restrict recording", func(t *testing.T) {
+		c := NewRandomController(1, ServerID("node-a"))
+		c.draw(ServerID("node-a"), "heartbeat", 50*time.Millisecond)
+		c.draw(ServerID("node-b"), "heartbeat", 50*time.Millisecond)
+		got := c.Choices()
+		require.Len(t, got, 1)
+		require.Equal(t, ServerID("node-a"), got[0].Owner)
+	})
+}
+
+// waitForRandomChoices polls the controller until choices with every wanted
+// name are recorded, so the wiring test does not depend on exact goroutine
+// timing.
+func waitForRandomChoices(t *testing.T, c *RandomController, wanted []string, timeout time.Duration) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		seen := make(map[string]bool)
+		for _, ch := range c.Choices() {
+			seen[ch.Name] = true
+		}
+		ok := true
+		for _, name := range wanted {
+			if !seen[name] {
+				ok = false
+				break
+			}
+		}
+		if ok {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("expected recorded choices %v within %v; got %v", wanted, timeout, c.Choices())
+}
+
+// TestRandomControllerNodeWiring verifies that a controller installed through
+// Config.RandomController before NewRaft serves the node's randomized timeout
+// draws: every recorded choice is attributed to the node and uses a stable
+// semantic name.
+func TestRandomControllerNodeWiring(t *testing.T) {
+	addr, trans := NewInmemTransport(NewInmemAddr())
+	conf := inmemConfig(t)
+	conf.LocalID = ServerID("node-a")
+	rc := NewRandomController(1234)
+	conf.RandomController = rc
+
+	node, err := NewRaft(conf, &MockFSM{}, NewInmemStore(), NewInmemStore(), NewInmemSnapshotStore(), trans)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = node.Shutdown().Error() })
+
+	config := Configuration{Servers: []Server{{Suffrage: Voter, ID: ServerID("node-a"), Address: addr}}}
+	require.NoError(t, node.BootstrapCluster(config).Error())
+
+	// Entering the follower state draws the first heartbeat immediately, and
+	// the single-node cluster elects itself, which draws election timeouts.
+	waitForRandomChoices(t, rc, []string{"heartbeat", "election"}, 10*time.Second)
+
+	for _, ch := range rc.Choices() {
+		require.Equal(t, ServerID("node-a"), ch.Owner)
+		require.GreaterOrEqual(t, ch.Value, time.Duration(0))
+	}
+}
