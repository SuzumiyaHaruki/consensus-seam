+++ b/message_controller_test.go
@@ -0,0 +1,825 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"testing"
+	"time"
+)
+
+// waitPending polls the controller until pred holds over the pending snapshot
+// or the deadline passes.
+func waitPending(t *testing.T, ctl *MessageController, pred func([]PendingMessage) bool, timeout time.Duration) []PendingMessage {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		p := ctl.Pending()
+		if pred(p) {
+			return p
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for pending messages; last state: %+v", ctl.Pending())
+	return nil
+}
+
+// pumpController injects every pending message until the cache is empty. It
+// models a test policy of delivering all captured traffic.
+func pumpController(t *testing.T, ctl *MessageController) {
+	t.Helper()
+	for {
+		pending := ctl.Pending()
+		if len(pending) == 0 {
+			time.Sleep(5 * time.Millisecond)
+			return
+		}
+		for _, pm := range pending {
+			if err := ctl.Inject(pm.Handle); err != nil {
+				t.Fatalf("inject %s: %v", pm.Kind, err)
+			}
+		}
+	}
+}
+
+// respondLikeRaft answers every RPC the way a Raft node's main loop would,
+// mirroring processRPC: each request gets a typed response on rpc.RespChan.
+func respondLikeRaft(t *testing.T, trans *InmemTransport, recv chan<- receivedRPC) {
+	t.Helper()
+	for rpc := range trans.Consumer() {
+		var snap []byte
+		switch cmd := rpc.Command.(type) {
+		case *AppendEntriesRequest:
+			rpc.Respond(&AppendEntriesResponse{Term: cmd.Term, Success: true}, nil)
+		case *RequestVoteRequest:
+			rpc.Respond(&RequestVoteResponse{Term: cmd.Term, Granted: true}, nil)
+		case *RequestPreVoteRequest:
+			rpc.Respond(&RequestPreVoteResponse{Term: cmd.Term, Granted: true}, nil)
+		case *InstallSnapshotRequest:
+			snap, _ = io.ReadAll(rpc.Reader)
+			rpc.Respond(&InstallSnapshotResponse{Term: cmd.Term, Success: true}, nil)
+		case *TimeoutNowRequest:
+			rpc.Respond(&TimeoutNowResponse{}, nil)
+		default:
+			rpc.Respond(nil, fmt.Errorf("unexpected command %T", rpc.Command))
+		}
+		if recv != nil {
+			recv <- receivedRPC{cmd: rpc.Command, snap: snap}
+		}
+	}
+}
+
+type receivedRPC struct {
+	cmd  interface{}
+	snap []byte
+}
+
+// waitReceived returns the next RPC reported by the simulated receiver.
+func waitReceived(t *testing.T, recv <-chan receivedRPC, timeout time.Duration) receivedRPC {
+	t.Helper()
+	select {
+	case rr := <-recv:
+		return rr
+	case <-time.After(timeout):
+		t.Fatalf("timed out waiting for a delivered RPC")
+		return receivedRPC{}
+	}
+}
