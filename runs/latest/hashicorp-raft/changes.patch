diff --git a/lifecycle_controller.go b/lifecycle_controller.go
new file mode 100644
index 0000000..34773fa
--- /dev/null
+++ b/lifecycle_controller.go
@@ -0,0 +1,357 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+)
+
+// ErrLifecycleUnsupported is returned by a LifecycleController operation that
+// cannot be implemented for the controlled target without changing core
+// protocol, persistence, state-transition or ordering semantics. It is
+// classifiable with errors.Is.
+var ErrLifecycleUnsupported = errors.New("lifecycle controller: operation is not supported by the target")
+
+var (
+	// errLifecycleSubjectNotTracked is returned when a LifecycleController
+	// method is called with a target that is not the subject this controller
+	// owns.
+	errLifecycleSubjectNotTracked = errors.New("lifecycle controller: subject is not tracked by this controller")
+	// errLifecycleInvalidTransition is returned when a LifecycleController
+	// operation is not valid in the subject's current lifecycle phase (for
+	// example pausing a stopped subject or restarting a running one).
+	errLifecycleInvalidTransition = errors.New("lifecycle controller: invalid state transition")
+)
+
+// RestartFunc rebuilds a controlled subject after it was stopped or crashed.
+// The function must construct a fresh *Raft with the same LocalID and
+// configuration over the same durable stores used by the original node (and,
+// for in-memory transports, a freshly connected transport), exactly like the
+// original construction - normally by calling NewRaft with the same Config,
+// FSM, LogStore, StableStore and SnapshotStore. NewRaft is the target's
+// normal recovery entrypoint and replays durable state; the seam itself does
+// not implement protocol catch-up.
+type RestartFunc func() (*Raft, error)
+
+// lifecyclePhase records which lifecycle operation last affected the
+// controlled subject, so Restart can report whether it recovers from a normal
+// stop or from a crash.
+type lifecyclePhase uint8
+
+const (
+	phaseRunning lifecyclePhase = iota
+	phasePaused
+	phaseStopped
+	phaseCrashed
+)
+
+func (p lifecyclePhase) String() string {
+	switch p {
+	case phaseRunning:
+		return "running"
+	case phasePaused:
+		return "paused"
+	case phaseStopped:
+		return "stopped"
+	case phaseCrashed:
+		return "crashed"
+	default:
+		return "unknown"
+	}
+}
+
+// LifecycleController drives the lifecycle of one *Raft node: temporary
+// pause/resume of a running runtime with all volatile state retained, normal
+// stop, abrupt crash, and recovery through a fresh runtime over the same
+// durable stores.
+//
+// The controller is inactive by default: it performs no work until one of its
+// methods is called, so nodes that are never attached to a controller behave
+// exactly as before.
+//
+// Stop and Crash both terminate the runtime through the target's own
+// termination primitives. The target's normal stop is itself abrupt -
+// Raft.Shutdown is documented as "not a graceful operation" and Raft persists
+// term, vote and log entries eagerly, so no protocol state is flushed at
+// shutdown. In-flight transport RPC waits are resolved by closing the
+// transport, which is cleanup rather than a persistence flush. Every
+// goroutine that can respond to a future or mutate protocol state is tracked
+// by the target's goroutine group - including the leadership-transfer
+// watcher and the leadershipTransfer goroutine, which are registered through
+// r.goFunc - so when Stop or Crash returns no abandoned execution context
+// remains that could emit output or mutate state afterwards. The controller
+// records which operation was used so Restart can report the correct recovery
+// basis; the durable state retained by Stop and by Crash is identical.
+//
+// Pause and Resume are implemented as narrow, default-disabled pause gates in
+// the follower/candidate/leader state loops and the replication, snapshot and
+// FSM goroutines (see lifecyclePauseGate). When no controller pauses a node
+// the gates never block and behavior is unchanged. The gate is checked at the
+// top of every loop iteration and again after every select receive, before
+// the received event is handled, so once Pause has set the paused flag no
+// protocol event received afterwards can be handled, consumed or emitted
+// until Resume: an event received while paused is held at the gate in the
+// receiving goroutine and processed only after Resume (or dropped when the
+// node is shut down while held). Only an event whose receive and gate check
+// both completed before Pause set the paused flag - an operation already in
+// flight at that moment - may complete its handling concurrently with Pause
+// returning; this is the linearization point of the pause.
+type LifecycleController struct {
+	mu      sync.Mutex
+	node    *Raft
+	restart RestartFunc
+	phase   lifecyclePhase
+}
+
+// NewLifecycleController creates a LifecycleController for node. restart must
+// rebuild the node with the same identity, configuration and durable stores
+// (see RestartFunc); it is used by Restart and should be provided even when
+// only Pause, Stop or Crash are used.
+func NewLifecycleController(node *Raft, restart RestartFunc) *LifecycleController {
+	return &LifecycleController{
+		node:    node,
+		restart: restart,
+		phase:   phaseRunning,
+	}
+}
+
+// Node returns the subject currently controlled by this controller - the
+// original node, or the fresh runtime created by the most recent Restart.
+func (c *LifecycleController) Node() *Raft {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.node
+}
+
+// Pause suspends protocol activity of the running target without stopping it:
+// the same runtime and all volatile state are retained, but no protocol
+// messages are handled, no protocol timers are consumed and no protocol
+// output is produced until Resume is called. Every state loop and
+// replication, snapshot and FSM goroutine re-checks the pause gate after each
+// select receive, before handling the received event, so a message or timer
+// event that arrives after Pause returns is held at the gate rather than
+// processed; an event whose handling already started before the paused flag
+// was set completes normally (linearization point). A subject that is already
+// paused stays paused; a stopped or crashed subject cannot be paused.
+//
+// Change scope: core_hook. The pause gate is a narrow, default-disabled seam
+// in the state loops and the replication, snapshot and FSM goroutines; no
+// protocol, persistence, state-transition or ordering semantics change.
+func (c *LifecycleController) Pause(target *Raft) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if target != c.node {
+		return errLifecycleSubjectNotTracked
+	}
+	switch c.phase {
+	case phasePaused:
+		return nil
+	case phaseRunning:
+		target.lifecyclePause()
+		c.phase = phasePaused
+		return nil
+	default:
+		return fmt.Errorf("%w: cannot pause a %s subject", errLifecycleInvalidTransition, c.phase)
+	}
+}
+
+// Resume continues a paused target on the same runtime, restoring message
+// handling, protocol time progress and protocol output. A subject that is
+// already running stays running; a stopped or crashed subject cannot be
+// resumed.
+//
+// Change scope: core_hook (same narrow pause gate as Pause).
+func (c *LifecycleController) Resume(target *Raft) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if target != c.node {
+		return errLifecycleSubjectNotTracked
+	}
+	switch c.phase {
+	case phaseRunning:
+		return nil
+	case phasePaused:
+		target.lifecycleResume()
+		c.phase = phaseRunning
+		return nil
+	default:
+		return fmt.Errorf("%w: cannot resume a %s subject", errLifecycleInvalidTransition, c.phase)
+	}
+}
+
+// Stop performs a normal shutdown of the target using Raft.Shutdown, waits
+// until every background goroutine has exited, and permits the target-defined
+// cleanup (the transport is closed when it implements WithClose). Durable
+// stores retain all state needed for a later Restart. A subject that is
+// already stopped stays stopped.
+//
+// Change scope: facade_only - wraps the target's existing public stop path.
+// The underlying stop path is a core_hook of the target: every goroutine that
+// can respond to a future or mutate protocol state (including the
+// leadership-transfer goroutines) is registered with the target's goroutine
+// group, so Shutdown's future waits for all of them.
+func (c *LifecycleController) Stop(target *Raft) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if target != c.node {
+		return errLifecycleSubjectNotTracked
+	}
+	switch c.phase {
+	case phaseStopped:
+		return nil
+	case phaseRunning, phasePaused:
+		if err := target.Shutdown().Error(); err != nil {
+			return err
+		}
+		c.phase = phaseStopped
+		return nil
+	default:
+		return fmt.Errorf("%w: cannot stop a %s subject", errLifecycleInvalidTransition, c.phase)
+	}
+}
+
+// Crash abruptly terminates the target's runtime and discards it together
+// with all volatile state; only state already durable under the target's
+// semantics survives, so a later Restart recovers pre-crash durable state
+// with a fresh runtime. No protocol state is flushed at crash time: Raft
+// persists term, vote and log entries eagerly, and the transport close that
+// resolves in-flight RPC waits is cleanup, not persistence. The target's
+// goroutine group covers every context that can respond to a future or
+// mutate protocol state (including the leadership-transfer goroutines, which
+// are registered through r.goFunc), so after Crash returns no abandoned
+// execution context can process work, emit output or mutate state. A subject
+// that is already crashed stays crashed.
+//
+// Change scope: core_hook - Crash uses the target's own stop path (which is
+// abrupt and performs no shutdown-time persistence flush) and relies on the
+// goroutine-group tracking of the leadership-transfer goroutines so that the
+// stop future waits for every context; the controller records the operation
+// to distinguish crash recovery from stop recovery.
+func (c *LifecycleController) Crash(target *Raft) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if target != c.node {
+		return errLifecycleSubjectNotTracked
+	}
+	switch c.phase {
+	case phaseCrashed:
+		return nil
+	case phaseRunning, phasePaused:
+		if err := target.Shutdown().Error(); err != nil {
+			return err
+		}
+		c.phase = phaseCrashed
+		return nil
+	default:
+		return fmt.Errorf("%w: cannot crash a %s subject", errLifecycleInvalidTransition, c.phase)
+	}
+}
+
+// Restart rebuilds the controlled subject with a fresh runtime through the
+// target's normal recovery path - the restart function supplied to
+// NewLifecycleController, normally NewRaft over the same durable stores. After
+// a Stop the fresh runtime recovers the target's normal post-stop state; after
+// a Crash it recovers pre-crash durable state. The seam does not implement
+// protocol catch-up. Because the shared Config carries the deterministic
+// control hooks, every controller wired through it (TimeController,
+// RandomController, MessageController) controls the fresh subject after a
+// successful Restart, and no stale hook from the old runtime acts.
+//
+// Change scope: facade_only - wraps the target's existing public construction
+// path with an identity check.
+func (c *LifecycleController) Restart(target *Raft) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if target != c.node {
+		return errLifecycleSubjectNotTracked
+	}
+	switch c.phase {
+	case phaseStopped, phaseCrashed:
+	default:
+		return fmt.Errorf("%w: cannot restart a %s subject", errLifecycleInvalidTransition, c.phase)
+	}
+	if c.restart == nil {
+		return fmt.Errorf("%w: no restart function configured", errLifecycleInvalidTransition)
+	}
+	previous := c.node.localID
+	node, err := c.restart()
+	if err != nil {
+		return fmt.Errorf("lifecycle controller: restart failed: %w", err)
+	}
+	if node == nil {
+		return errors.New("lifecycle controller: restart function returned a nil node")
+	}
+	if node.localID != previous {
+		return fmt.Errorf("lifecycle controller: restarted subject has identity %q, want %q", node.localID, previous)
+	}
+	c.node = node
+	c.phase = phaseRunning
+	return nil
+}
+
+// lifecyclePause suspends protocol activity of r until lifecycleResume (or a
+// shutdown) is called. See LifecycleController.Pause.
+func (r *Raft) lifecyclePause() {
+	r.pauseMu.Lock()
+	defer r.pauseMu.Unlock()
+	if r.paused {
+		return
+	}
+	r.paused = true
+	r.resumeCh = make(chan struct{})
+	// A paused subject receives no time steps from its TimeController; its
+	// timers stay registered and are delivered again once it resumes.
+	if tc := r.config().TimeController; tc != nil {
+		tc.pause(r)
+	}
+}
+
+// lifecycleResume resumes protocol activity of r after lifecyclePause. See
+// LifecycleController.Resume.
+func (r *Raft) lifecycleResume() {
+	r.pauseMu.Lock()
+	defer r.pauseMu.Unlock()
+	if !r.paused {
+		return
+	}
+	r.paused = false
+	close(r.resumeCh)
+	r.resumeCh = nil
+	if tc := r.config().TimeController; tc != nil {
+		tc.resume(r)
+	}
+}
+
+// lifecyclePauseGate blocks the calling goroutine while r is paused and
+// returns false when a shutdown was requested while blocked. It is called at
+// the top of every state loop and of the replication, snapshot and FSM
+// goroutines and again immediately after every select receive, before the
+// received event is handled; when no controller paused the node it returns
+// immediately, so production behavior is unchanged.
+//
+// The post-receive check is what makes Pause airtight: a goroutine that has
+// already passed the top-of-loop gate and is blocked in its select when Pause
+// sets the paused flag will receive an event only after the flag is set and
+// then blocks here holding the event, so the event is never handled, consumed
+// or emitted while paused. When r is paused, the calling goroutine holds any
+// received value in its own frame until the node resumes (lifecycleResume
+// closes resumeCh) or shuts down (shutdownCh is closed), at which point the
+// held event is either processed or dropped.
+func (r *Raft) lifecyclePauseGate() bool {
+	r.pauseMu.Lock()
+	for r.paused {
+		ch := r.resumeCh
+		r.pauseMu.Unlock()
+		select {
+		case <-ch:
+		case <-r.shutdownCh:
+			return false
+		}
+		r.pauseMu.Lock()
+	}
+	r.pauseMu.Unlock()
+	return true
+}
