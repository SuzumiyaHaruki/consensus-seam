new file mode 100644
index 0000000..8530ba6
--- /dev/null
+++ b/random_controller.go
@@ -0,0 +1,114 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"math/rand"
+	"sync"
+	"time"
+)
+
+// RandomChoice is one recorded hidden, non-cryptographic protocol draw made by
+// a controlled node. Name is a stable semantic label, Owner is the concrete
+// ServerID of the node that performed the draw, and Value is the final
+// semantic result: the selected timer duration, already within the protocol's
+// legal domain [minVal, 2*minVal).
+type RandomChoice struct {
+	// Name is the stable semantic name of the choice.
+	Name string
+	// Owner is the ServerID of the node that made the draw.
+	Owner ServerID
+	// Value is the selected duration in the target's legal domain.
+	Value time.Duration
+}
+
+// Stable semantic names for the protocol draws recorded by RandomController.
+const (
+	// RandomChoiceElectionTimeout is the candidate election timer jitter draw.
+	RandomChoiceElectionTimeout = "election_timeout"
+	// RandomChoiceHeartbeatTimeout is the follower heartbeat timer jitter draw.
+	RandomChoiceHeartbeatTimeout = "heartbeat_timeout"
+	// RandomChoiceCommitTimeout is the leader commit/replicate timer jitter draw.
+	RandomChoiceCommitTimeout = "commit_timeout"
+	// RandomChoiceHeartbeatInterval is the leader heartbeat interval jitter draw.
+	RandomChoiceHeartbeatInterval = "heartbeat_interval"
+	// RandomChoiceSnapshotInterval is the snapshot loop timer jitter draw.
+	RandomChoiceSnapshotInterval = "snapshot_interval"
+)
+
+// RandomController makes the hidden non-cryptographic protocol draws of one
+// Raft node reproducible and observable. Each controller is dedicated to a
+// single owner (a concrete ServerID) and owns its own deterministic source:
+// the same seed and the same draw order reproduce the same sequence, and
+// every draw consumes the next value from that source so repeated decisions
+// keep varying. The target's legal domain and its production algorithm are
+// unchanged.
+//
+// A RandomController is inert until it is installed: set Config.Random on the
+// node's Config before calling NewRaft so every in-scope draw of that node is
+// routed through this controller from the start. When no controller is
+// installed the node keeps using the package's normal global random source
+// and production behavior is unchanged.
+type RandomController struct {
+	mu      sync.Mutex
+	seed    int64
+	owner   ServerID
+	rng     *rand.Rand
+	choices []RandomChoice
+}
+
+// NewRandomController creates a deterministic controller for the node
+// identified by owner, seeded with seed. Install it through Config.Random
+// before NewRaft starts the node's goroutines.
+func NewRandomController(seed int64, owner ServerID) *RandomController {
+	return &RandomController{
+		seed:  seed,
+		owner: owner,
+		rng:   rand.New(rand.NewSource(seed)),
+	}
+}
+
+// Choices returns an ordered, deep-copied history of every draw made so far.
+// The returned slice and its elements never alias the controller's internal
+// history: mutating the result cannot affect later calls.
+func (c *RandomController) Choices() []RandomChoice {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]RandomChoice, len(c.choices))
+	copy(out, c.choices)
+	return out
+}
+
+// draw performs one protocol draw for the named choice using the same
+// algorithm as production (a uniform offset in [0, minVal)) and records the
+// final selected duration. It returns the offset so the caller can arm the
+// timer exactly as before.
+func (c *RandomController) draw(name string, minVal time.Duration) time.Duration {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	extra := time.Duration(c.rng.Int63()) % minVal
+	c.choices = append(c.choices, RandomChoice{
+		Name:  name,
+		Owner: c.owner,
+		Value: minVal + extra,
+	})
+	return extra
+}
+
+// randomTimeoutFor arms one protocol timer, routing the hidden jitter draw
+// through the node's RandomController when one is installed. Without a
+// controller the behavior is identical to the package-level randomTimeout
+// (the global source), so production defaults are unchanged.
+func (r *Raft) randomTimeoutFor(name string, minVal time.Duration) <-chan time.Time {
+	if minVal == 0 {
+		return nil
+	}
+	var extra time.Duration
+	if rc := r.random; rc != nil {
+		extra = rc.draw(name, minVal)
+	} else {
+		extra = time.Duration(rand.Int63()) % minVal
+	}
+	return r.clock.After(minVal + extra)
+}
