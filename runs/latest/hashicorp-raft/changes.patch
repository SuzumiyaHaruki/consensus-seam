diff --git a/time_controller.go b/time_controller.go
new file mode 100644
index 0000000..b5e41bb
--- /dev/null
+++ b/time_controller.go
@@ -0,0 +1,268 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"container/heap"
+	"errors"
+	"sync"
+	"time"
+)
+
+// Clock is the time source used by a Raft node's protocol loops. A node uses
+// the real wall clock unless a Clock is installed through Config.Clock before
+// NewRaft starts the node's goroutines.
+type Clock interface {
+	// Now returns the current time of this clock.
+	Now() time.Time
+
+	// After waits for the duration to elapse and then sends the current time
+	// on the returned channel. It is equivalent to time.After for the real
+	// clock. Each returned channel fires at most once, at the first boundary
+	// at which the clock has reached the requested deadline.
+	After(d time.Duration) <-chan time.Time
+}
+
+// realClock is the default Clock: it delegates to the wall clock so that
+// production behavior is unchanged when no controller is installed.
+type realClock struct{}
+
+func (realClock) Now() time.Time { return time.Now() }
+
+func (realClock) After(d time.Duration) <-chan time.Time { return time.After(d) }
+
+// nodeClock attributes every timer armed through it to one Raft node. NewRaft
+// wraps a TimeController-owned virtual clock with a nodeClock when it installs
+// Config.Clock, so the wrapper is invisible to consumers: Now and After behave
+// exactly as on the underlying shared clock. The attribution lets the shared
+// virtual clock exclude nodes that must not receive time steps: timers of a
+// paused node are held until the node resumes, and timers of a stopped or
+// crashed runtime are discarded when they come due instead of being delivered.
+type nodeClock struct {
+	vc *virtualClock
+	r  *Raft
+}
+
+func (n *nodeClock) Now() time.Time { return n.vc.Now() }
+
+func (n *nodeClock) After(d time.Duration) <-chan time.Time {
+	return n.vc.after(d, n)
+}
+
+// TimeController is a system-level controller for protocol time. It owns one
+// shared virtual clock with a fixed step unit. Every node whose Config.Clock
+// is set to the controller's shared clock before NewRaft is part of the
+// controlled system: in controlled mode protocol time does not progress on its
+// own, and TimeController.Advance is the only way to move it.
+//
+// Wiring: create the controller first, install its clock in each controlled
+// node's Config, then construct the nodes:
+//
+//	tc := raft.NewTimeController(10 * time.Millisecond)
+//	conf.Clock = tc.Clock() // must be set before NewRaft starts goroutines
+//	r, _ := raft.NewRaft(conf, fsm, store, store, snaps, trans)
+//	_ = tc.Register(r)      // optional bookkeeping of the controlled node
+//
+// One Advance step advances the shared virtual clock by one unit for every
+// node sharing the clock, then submits every timer whose deadline is reached
+// at that boundary through the node's normal timer channels. Advance(n) is
+// equivalent to n separate Advance(1) calls: timers re-armed in reaction to
+// earlier steps fire at later steps, and no timer is skipped or fired twice.
+// Advance returns once the due events have been submitted; it does not wait
+// for the events to be processed, for resulting messages or state
+// transitions, or for commits. Step delivery is lifecycle-aware: a timer
+// belonging to a paused node is held (it fires only after the node resumes,
+// on a later Advance), and a timer belonging to a stopped or crashed runtime
+// is discarded when it comes due, so paused, stopped, and crashed nodes do
+// not receive steps. A timer armed directly on the shared clock (without a
+// node) is never gated and fires exactly like before.
+//
+// When no TimeController is installed (Config.Clock is nil) nodes keep using
+// the real wall clock and production behavior is unchanged.
+type TimeController struct {
+	clock *virtualClock
+
+	mu    sync.Mutex
+	nodes map[ServerID]*Raft
+}
+
+// NewTimeController creates a TimeController whose shared virtual clock
+// advances in unit-sized steps. unit must be positive; it is the target-
+// defined duration of one Advance step. Nodes created later with the
+// controller's clock installed via Config.Clock are controlled automatically;
+// already-created nodes may be passed here or registered later with Register.
+func NewTimeController(unit time.Duration, nodes ...*Raft) *TimeController {
+	if unit <= 0 {
+		panic("raft: NewTimeController requires a positive step unit")
+	}
+	tc := &TimeController{
+		clock: newVirtualClock(unit),
+		nodes: make(map[ServerID]*Raft),
+	}
+	for _, n := range nodes {
+		_ = tc.Register(n)
+	}
+	return tc
+}
+
+// Clock returns the controller's shared virtual clock. Install it in each
+// controlled node's Config.Clock before calling NewRaft so that control is in
+// place before the node can start protocol goroutines, timers, or callbacks.
+func (tc *TimeController) Clock() Clock { return tc.clock }
+
+// Register records node as a controlled node of this controller. It is
+// required only for bookkeeping (for example when a node is restarted and a
+// fresh runtime is bound to the same controller); time control itself comes
+// from the shared clock installed via Config.Clock. Register returns an error
+// if node is nil or if the node's ServerID is already registered.
+func (tc *TimeController) Register(node *Raft) error {
+	if node == nil {
+		return errors.New("raft: cannot register a nil node with TimeController")
+	}
+	tc.mu.Lock()
+	defer tc.mu.Unlock()
+	id := node.localID
+	if _, ok := tc.nodes[id]; ok {
+		return errors.New("raft: node " + string(id) + " is already registered with TimeController")
+	}
+	tc.nodes[id] = node
+	return nil
+}
+
+// Advance advances the shared virtual clock by steps units, one unit at a
+// time. After each unit the clock submits every timer whose deadline has been
+// reached at that boundary, in deadline order (and, for equal deadlines, in
+// the order the timers were armed), through the normal timer channels. A
+// timer that belongs to a paused node is held and re-evaluated at later
+// boundaries, and a timer that belongs to a stopped or crashed runtime is
+// discarded when it comes due, so paused, stopped, and crashed nodes do not
+// receive steps; the shared clock itself advances for every node sharing it.
+// Advance never waits for the submitted events to be processed.
+func (tc *TimeController) Advance(steps uint64) error {
+	tc.clock.advance(steps)
+	return nil
+}
+
+// virtualClock is the shared, manually advanced clock owned by a
+// TimeController. It starts at a fixed epoch (time.Unix(0, 0)) so that
+// reproducible tests observe deterministic LastContact and timer values.
+type virtualClock struct {
+	mu     sync.Mutex
+	now    time.Time
+	unit   time.Duration
+	timers virtualTimerHeap
+	seq    uint64
+}
+
+func newVirtualClock(unit time.Duration) *virtualClock {
+	return &virtualClock{now: time.Unix(0, 0), unit: unit}
+}
+
+func (c *virtualClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+// After arms a timer that fires at the first step boundary at which the
+// clock has reached now+d. A non-positive duration arms at the current
+// boundary, so it fires on the next Advance step. The returned channel is
+// buffered and receives exactly one value.
+func (c *virtualClock) After(d time.Duration) <-chan time.Time {
+	return c.after(d, nil)
+}
+
+// after arms a timer and optionally attributes it to the given node clock.
+// An unattributed timer (nc == nil) is never gated by lifecycle state.
+func (c *virtualClock) after(d time.Duration, nc *nodeClock) <-chan time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	ch := make(chan time.Time, 1)
+	t := &virtualTimer{deadline: c.now.Add(d), seq: c.seq, ch: ch, nc: nc}
+	c.seq++
+	heap.Push(&c.timers, t)
+	return ch
+}
+
+// advance moves the clock forward by steps units. Each unit is a separate
+// boundary: the clock moves one unit, then all timers due at that boundary
+// are submitted (popped and delivered). Timers armed concurrently by node
+// goroutines while advance runs are included from the step at which their
+// deadline is reached. A due timer that belongs to a paused node is held and
+// re-evaluated at later boundaries (it fires only once the node resumes); a
+// due timer that belongs to a stopped or crashed runtime is discarded so no
+// stale timer of a discarded runtime is ever delivered.
+func (c *virtualClock) advance(steps uint64) {
+	for i := uint64(0); i < steps; i++ {
+		c.mu.Lock()
+		c.now = c.now.Add(c.unit)
+		var fire []*virtualTimer
+		var held []*virtualTimer
+		for c.timers.Len() > 0 {
+			t := c.timers[0]
+			if t.deadline.After(c.now) {
+				break
+			}
+			heap.Pop(&c.timers)
+			if t.nc == nil {
+				fire = append(fire, t)
+				continue
+			}
+			switch {
+			case t.nc.r.getState() == Shutdown:
+				// The owning runtime is stopped or crashed: discard the
+				// stale timer. A restarted runtime arms fresh timers through
+				// its own node clock.
+			case t.nc.r.paused.Load():
+				// Paused nodes do not receive steps: hold the timer and
+				// re-evaluate it at a later boundary.
+				held = append(held, t)
+			default:
+				fire = append(fire, t)
+			}
+		}
+		for _, t := range held {
+			heap.Push(&c.timers, t)
+		}
+		c.mu.Unlock()
+
+		// Deliver outside the lock: each channel is buffered and fires
+		// exactly once, so these sends never block.
+		for _, t := range fire {
+			t.ch <- t.deadline
+		}
+	}
+}
+
+// virtualTimer is one pending After request in the shared virtual clock.
+type virtualTimer struct {
+	deadline time.Time
+	seq      uint64
+	ch       chan time.Time
+	nc       *nodeClock // non-nil when the timer is attributed to one node
+}
+
+// virtualTimerHeap orders pending timers by (deadline, arm order).
+type virtualTimerHeap []*virtualTimer
+
+func (h virtualTimerHeap) Len() int { return len(h) }
+
+func (h virtualTimerHeap) Less(i, j int) bool {
+	if h[i].deadline.Equal(h[j].deadline) {
+		return h[i].seq < h[j].seq
+	}
+	return h[i].deadline.Before(h[j].deadline)
+}
+
+func (h virtualTimerHeap) Swap(i, j int) { h[i], h[j] = h[j], h[i] }
+
+func (h *virtualTimerHeap) Push(x interface{}) { *h = append(*h, x.(*virtualTimer)) }
+
+func (h *virtualTimerHeap) Pop() interface{} {
+	old := *h
+	n := len(old)
+	x := old[n-1]
+	*h = old[:n-1]
+	return x
+}
diff --git a/time_controller_test.go b/time_controller_test.go
new file mode 100644
index 0000000..b10f7ab
--- /dev/null
+++ b/time_controller_test.go
@@ -0,0 +1,229 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"testing"
+	"time"
+)
+
+// controlledTestNode builds one bootstrapped single-voter node whose protocol
+// time is fully controlled by a TimeController with the given step unit. The
+// configured timeouts are tiny so that any real-time progress would be
+// observable within milliseconds; only Advance may move protocol time.
+func controlledTestNode(t *testing.T, unit time.Duration) (*TimeController, *Raft) {
+	t.Helper()
+	conf := DefaultConfig()
+	conf.HeartbeatTimeout = 10 * time.Millisecond
+	conf.ElectionTimeout = 10 * time.Millisecond
+	conf.CommitTimeout = 5 * time.Millisecond
+	conf.LeaderLeaseTimeout = 5 * time.Millisecond
+	conf.SnapshotInterval = 5 * time.Millisecond
+	conf.LocalID = ServerID("node-1")
+	conf.Logger = newTestLogger(t)
+
+	tc := NewTimeController(unit)
+	conf.Clock = tc.Clock()
+
+	store := NewInmemStore()
+	snaps := NewInmemSnapshotStore()
+	addr, trans := NewInmemTransport(ServerAddress("10.0.0.1:0"))
+	if err := BootstrapCluster(conf, store, store, snaps, trans, Configuration{
+		Servers: []Server{{Suffrage: Voter, ID: conf.LocalID, Address: addr}},
+	}); err != nil {
+		t.Fatalf("BootstrapCluster failed: %v", err)
+	}
+	r, err := NewRaft(conf, &MockFSM{}, store, store, snaps, trans)
+	if err != nil {
+		t.Fatalf("NewRaft failed: %v", err)
+	}
+	t.Cleanup(func() { _ = r.Shutdown().Error() })
+	return tc, r
+}
+
+// TestTimeControllerNoProgressWithoutAdvance verifies that in controlled mode
+// protocol time does not progress on its own: with timeouts of a few
+// milliseconds the node would start an election within tens of milliseconds of
+// real time, but without Advance it must remain a follower.
+func TestTimeControllerNoProgressWithoutAdvance(t *testing.T) {
+	tc, r := controlledTestNode(t, time.Millisecond)
+	_ = tc
+
+	time.Sleep(200 * time.Millisecond)
+	if got := r.State(); got != Follower {
+		t.Fatalf("expected Follower without Advance, got %v", got)
+	}
+}
+
+// TestTimeControllerAdvanceDrivesElection verifies that Advance is the only
+// way protocol time moves: stepping past the heartbeat and election timeouts
+// (each up to 2x the configured value because of jitter) lets the node run an
+// election and become leader.
+func TestTimeControllerAdvanceDrivesElection(t *testing.T) {
+	tc, r := controlledTestNode(t, time.Millisecond)
+
+	deadline := time.Now().Add(5 * time.Second)
+	for r.State() != Leader && time.Now().Before(deadline) {
+		if err := tc.Advance(25); err != nil {
+			t.Fatalf("Advance failed: %v", err)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if got := r.State(); got != Leader {
+		t.Fatalf("expected Leader after Advance, got %v", got)
+	}
+}
+
+// TestTimeControllerClockSteps verifies the step boundaries of the shared
+// virtual clock: timers fire exactly at the step at which the clock reaches
+// their deadline, in arm order, and each timer fires exactly once.
+func TestTimeControllerClockSteps(t *testing.T) {
+	tc := NewTimeController(10 * time.Millisecond)
+	clk := tc.Clock()
+
+	ch3 := clk.After(30 * time.Millisecond) // due at step 3
+	ch7 := clk.After(70 * time.Millisecond) // due at step 7
+
+	if err := tc.Advance(2); err != nil {
+		t.Fatalf("Advance failed: %v", err)
+	}
+	assertTimerNotFired(t, ch3)
+	assertTimerNotFired(t, ch7)
+
+	if err := tc.Advance(1); err != nil { // step 3 boundary
+		t.Fatalf("Advance failed: %v", err)
+	}
+	assertTimerFired(t, ch3)
+	assertTimerNotFired(t, ch7)
+
+	if err := tc.Advance(4); err != nil { // steps 4..7
+		t.Fatalf("Advance failed: %v", err)
+	}
+	assertTimerFired(t, ch7)
+
+	// Timers fire exactly once: further steps do not refire them.
+	if err := tc.Advance(1); err != nil {
+		t.Fatalf("Advance failed: %v", err)
+	}
+	assertTimerNotFired(t, ch3)
+	assertTimerNotFired(t, ch7)
+}
+
+// TestTimeControllerReArmedTimer verifies that a timer re-armed in reaction to
+// an earlier step fires at a later step boundary, exactly as it would across
+// separate Advance(1) calls.
+func TestTimeControllerReArmedTimer(t *testing.T) {
+	tc := NewTimeController(10 * time.Millisecond)
+	clk := tc.Clock()
+
+	first := clk.After(20 * time.Millisecond) // fires at step 2
+	rearmed := make(chan struct{})
+	go func() {
+		<-first
+		second := clk.After(20 * time.Millisecond) // deadline: now+20ms
+		<-second
+		close(rearmed)
+	}()
+
+	if err := tc.Advance(2); err != nil {
+		t.Fatalf("Advance failed: %v", err)
+	}
+
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		select {
+		case <-rearmed:
+			return
+		default:
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("re-armed timer never fired")
+		}
+		if err := tc.Advance(1); err != nil {
+			t.Fatalf("Advance failed: %v", err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
