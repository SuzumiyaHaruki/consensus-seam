+
+// lifecycleTestNode builds one bootstrapped single-voter node with small
+// timeouts so protocol progress is observable within milliseconds of real
+// time. The caller owns shutdown of the returned node.
+func lifecycleTestNode(t *testing.T, id ServerID) (*Raft, *InmemStore, *InmemTransport) {
+	t.Helper()
+	conf := DefaultConfig()
+	conf.HeartbeatTimeout = 50 * time.Millisecond
+	conf.ElectionTimeout = 50 * time.Millisecond
+	conf.CommitTimeout = 5 * time.Millisecond
+	conf.LeaderLeaseTimeout = 50 * time.Millisecond
+	conf.LocalID = id
+	conf.Logger = newTestLogger(t)
+
+	store := NewInmemStore()
+	snaps := NewInmemSnapshotStore()
+	addr, trans := NewInmemTransport(ServerAddress(string(id)))
+	if err := BootstrapCluster(conf, store, store, snaps, trans, Configuration{
+		Servers: []Server{{Suffrage: Voter, ID: id, Address: addr}},
+	}); err != nil {
+		t.Fatalf("BootstrapCluster failed: %v", err)
+	}
+	r, err := NewRaft(conf, &MockFSM{}, store, store, snaps, trans)
+	if err != nil {
+		t.Fatalf("NewRaft failed: %v", err)
+	}
+	return r, store, trans
+}
+
+func waitForRaftState(t *testing.T, r *Raft, want RaftState, timeout time.Duration) {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		if r.State() == want {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for state %v, got %v", want, r.State())
+}
+
+// TestLifecycleControllerPauseBlocksProtocolProgress verifies that a paused
+// node does not progress at all: with 50ms heartbeat and election timeouts a
+// running node starts an election and becomes leader within a few hundred
+// milliseconds, while a paused node must remain a follower with no commit
+// progress, and resumes into leadership once unpaused.
+func TestLifecycleControllerPauseBlocksProtocolProgress(t *testing.T) {
+	r, _, _ := lifecycleTestNode(t, ServerID("node-1"))
+	lc := NewLifecycleController(r)
+	defer func() { _ = r.Shutdown().Error() }()
+
+	if err := lc.Pause("node-1"); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+	st, err := lc.Status("node-1")
+	if err != nil || st != LifecyclePaused {
+		t.Fatalf("expected LifecyclePaused, got %v (%v)", st, err)
+	}
+
+	time.Sleep(400 * time.Millisecond)
+	if got := r.State(); got != Follower {
+		t.Fatalf("expected Follower while paused, got %v", got)
+	}
+	if got := r.CommitIndex(); got != 0 {
+		t.Fatalf("expected no commit progress while paused, commit index %d", got)
+	}
+
+	if err := lc.Resume("node-1"); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+	st, err = lc.Status("node-1")
+	if err != nil || st != LifecycleRunning {
+		t.Fatalf("expected LifecycleRunning after resume, got %v (%v)", st, err)
+	}
+	waitForRaftState(t, r, Leader, 5*time.Second)
+}
+
+// TestLifecycleControllerPauseBlocksApply verifies that a paused leader makes
+// no commit or apply decisions: an Apply enqueued while paused must not
+// complete, and must complete normally after Resume.
+func TestLifecycleControllerPauseBlocksApply(t *testing.T) {
+	r, _, _ := lifecycleTestNode(t, ServerID("node-1"))
+	lc := NewLifecycleController(r)
+	defer func() { _ = r.Shutdown().Error() }()
+	waitForRaftState(t, r, Leader, 5*time.Second)
+
+	if err := lc.Pause("node-1"); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+	applied := make(chan error, 1)
+	go func() { applied <- r.Apply([]byte("paused-apply"), 0).Error() }()
+
+	select {
+	case err := <-applied:
+		t.Fatalf("Apply completed while paused: %v", err)
+	case <-time.After(300 * time.Millisecond):
+	}
+
+	if err := lc.Resume("node-1"); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+	select {
+	case err := <-applied:
+		if err != nil {
+			t.Fatalf("Apply failed after resume: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("Apply did not complete after resume")
+	}
+}
+
+// TestLifecycleControllerStopRestart verifies normal stop and recovery: Stop
+// runs the target's normal shutdown and discards the runtime binding, and
+// Restart builds a fresh runtime on the same identity and durable stores that
+// can elect itself leader again while the old runtime stays shut down.
+func TestLifecycleControllerStopRestart(t *testing.T) {
+	r, _, _ := lifecycleTestNode(t, ServerID("node-1"))
+	lc := NewLifecycleController(r)
+
+	if err := lc.Stop("node-1"); err != nil {
+		t.Fatalf("Stop failed: %v", err)
+	}
+	if got := r.State(); got != Shutdown {
+		t.Fatalf("expected Shutdown after Stop, got %v", got)
+	}
+	if got := lc.Raft("node-1"); got != nil {
+		t.Fatalf("expected runtime binding discarded after Stop, got %v", got)
+	}
+	st, err := lc.Status("node-1")
+	if err != nil || st != LifecycleStopped {
+		t.Fatalf("expected LifecycleStopped, got %v (%v)", st, err)
+	}
+
+	if err := lc.Restart("node-1"); err != nil {
+		t.Fatalf("Restart failed: %v", err)
+	}
+	r2 := lc.Raft("node-1")
+	if r2 == nil || r2 == r {
+		t.Fatalf("expected a fresh runtime after Restart")
+	}
+	if got := r.State(); got != Shutdown {
+		t.Fatalf("old runtime must stay shut down after Restart, got %v", got)
+	}
+	defer func() { _ = r2.Shutdown().Error() }()
+
+	// The fresh runtime recovers the durable bootstrap configuration and can
+	// elect itself leader again without any peers.
+	waitForRaftState(t, r2, Leader, 5*time.Second)
+}
+
+// TestLifecycleControllerCrashRestartKeepsDurableState verifies abrupt crash
+// and recovery: Crash discards the runtime without an extra protocol-state
+// flush, and Restart recovers the pre-crash durable state (term and log) with
+// a fresh runtime.
+func TestLifecycleControllerCrashRestartKeepsDurableState(t *testing.T) {
+	r, _, _ := lifecycleTestNode(t, ServerID("node-1"))
+	lc := NewLifecycleController(r)
+	waitForRaftState(t, r, Leader, 5*time.Second)
+
+	future := r.Apply([]byte("cmd-1"), 0)
+	if err := future.Error(); err != nil {
+		t.Fatalf("Apply failed: %v", err)
+	}
+	appliedIndex := future.Index()
+	termAtApply := r.CurrentTerm()
+
+	if err := lc.Crash("node-1"); err != nil {
+		t.Fatalf("Crash failed: %v", err)
+	}
+	if got := r.State(); got != Shutdown {
+		t.Fatalf("expected Shutdown after Crash, got %v", got)
+	}
+	if got := lc.Raft("node-1"); got != nil {
+		t.Fatalf("expected runtime binding discarded after Crash")
+	}
+	st, err := lc.Status("node-1")
+	if err != nil || st != LifecycleCrashed {
+		t.Fatalf("expected LifecycleCrashed, got %v (%v)", st, err)
+	}
+
+	if err := lc.Restart("node-1"); err != nil {
+		t.Fatalf("Restart failed: %v", err)
+	}
+	r2 := lc.Raft("node-1")
+	if r2 == nil {
+		t.Fatalf("expected a fresh runtime after Restart")
+	}
+	defer func() { _ = r2.Shutdown().Error() }()
+
+	// Durable state survives the crash: the fresh runtime sees the same term
+	// and the same log entries and can elect itself leader again.
+	if got := r2.CurrentTerm(); got < termAtApply {
+		t.Fatalf("term regressed across crash: got %d, want >= %d", got, termAtApply)
+	}
+	if got := r2.LastIndex(); got < appliedIndex {
+		t.Fatalf("durable log lost across crash: last index %d, want >= %d", got, appliedIndex)
+	}
+	waitForRaftState(t, r2, Leader, 5*time.Second)
+}
+
+// TestLifecycleControllerErrors verifies the error paths: unknown nodes, nil
+// registration, invalid state transitions, and ErrLifecycleUnsupported
+// classifiability.
+func TestLifecycleControllerErrors(t *testing.T) {
+	lc := NewLifecycleController()
+	if err := lc.Register(nil); err == nil {
+		t.Fatalf("expected error registering a nil node")
+	}
+	if err := lc.Stop(ServerID("missing")); err == nil {
+		t.Fatalf("expected error stopping an unregistered node")
+	}
+	if err := lc.Crash(ServerID("missing")); err == nil {
+		t.Fatalf("expected error crashing an unregistered node")
+	}
+	if err := lc.Restart(ServerID("missing")); err == nil {
+		t.Fatalf("expected error restarting an unregistered node")
+	}
+	if _, err := lc.Status(ServerID("missing")); err == nil {
+		t.Fatalf("expected error querying an unregistered node")
+	}
+	if got := lc.Raft(ServerID("missing")); got != nil {
+		t.Fatalf("expected nil runtime for an unregistered node")
+	}
+	if !errors.Is(fmt.Errorf("wrapped: %w", ErrLifecycleUnsupported), ErrLifecycleUnsupported) {
+		t.Fatalf("ErrLifecycleUnsupported must classify with errors.Is")
+	}
+
+	r, _, _ := lifecycleTestNode(t, ServerID("node-2"))
+	if err := lc.Register(r); err != nil {
+		t.Fatalf("Register failed: %v", err)
+	}
+	defer func() { _ = r.Shutdown().Error() }()
+
+	if err := lc.Restart("node-2"); err == nil {
+		t.Fatalf("expected error restarting a running node")
+	}
+	if err := lc.Pause("node-2"); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+	if err := lc.Pause("node-2"); err == nil {
+		t.Fatalf("expected error pausing a paused node")
+	}
+	if err := lc.Resume("node-2"); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+	if err := lc.Resume("node-2"); err == nil {
+		t.Fatalf("expected error resuming a running node")
+	}
+	if err := lc.Stop("node-2"); err != nil {
+		t.Fatalf("Stop failed: %v", err)
+	}
+	if err := lc.Stop("node-2"); err == nil {
+		t.Fatalf("expected error stopping a stopped node")
+	}
+	if err := lc.Pause("node-2"); err == nil {
+		t.Fatalf("expected error pausing a stopped node")
+	}
+	if err := lc.Restart("node-2"); err != nil {
+		t.Fatalf("Restart failed: %v", err)
+	}
+	r2 := lc.Raft("node-2")
+	if r2 == nil || r2 == r {
+		t.Fatalf("expected a fresh runtime after Restart")
+	}
+	defer func() { _ = r2.Shutdown().Error() }()
+}
+
+// TestLifecycleControllerRegisterReplacesBinding verifies that re-registering
+// an already registered ID replaces the binding.
+func TestLifecycleControllerRegisterReplacesBinding(t *testing.T) {
+	lc := NewLifecycleController()
+	r1, _, _ := lifecycleTestNode(t, ServerID("node-3"))
+	r2, _, _ := lifecycleTestNode(t, ServerID("node-3"))
+	defer func() { _ = r1.Shutdown().Error() }()
+	defer func() { _ = r2.Shutdown().Error() }()
+	if err := lc.Register(r1); err != nil {
+		t.Fatalf("Register failed: %v", err)
+	}
+	if err := lc.Register(r2); err != nil {
+		t.Fatalf("Register replace failed: %v", err)
+	}
+	if got := lc.Raft("node-3"); got != r2 {
+		t.Fatalf("expected the latest registration to win")
+	}
+}
+
+// TestLifecycleControllerRestartRejoinsCluster verifies that a restarted
+// follower rejoins a live cluster: after Stop and Restart (with the in-memory
+// routes restored, as required after the target's shutdown closes the
+// transport), the fresh runtime learns the leader's commit index and catches
+// its log up to an entry committed after the restart.
+func TestLifecycleControllerRestartRejoinsCluster(t *testing.T) {
+	ids := []ServerID{"n1", "n2", "n3"}
+	servers := make([]Server, len(ids))
+	for i, id := range ids {
+		servers[i] = Server{Suffrage: Voter, ID: id, Address: ServerAddress(string(id))}
+	}
+
+	var rafts []*Raft
+	var transports []*InmemTransport
+	lc := NewLifecycleController()
+	for _, id := range ids {
+		conf := DefaultConfig()
+		conf.HeartbeatTimeout = 50 * time.Millisecond
+		conf.ElectionTimeout = 50 * time.Millisecond
+		conf.CommitTimeout = 5 * time.Millisecond
+		conf.LeaderLeaseTimeout = 50 * time.Millisecond
+		conf.LocalID = id
+		conf.Logger = newTestLogger(t)
+
+		store := NewInmemStore()
+		snaps := NewInmemSnapshotStore()
+		_, trans := NewInmemTransport(ServerAddress(string(id)))
+		if err := BootstrapCluster(conf, store, store, snaps, trans, Configuration{Servers: servers}); err != nil {
+			t.Fatalf("BootstrapCluster failed: %v", err)
+		}
+		r, err := NewRaft(conf, &MockFSM{}, store, store, snaps, trans)
+		if err != nil {
+			t.Fatalf("NewRaft failed: %v", err)
+		}
+		rafts = append(rafts, r)
+		transports = append(transports, trans)
+		if err := lc.Register(r); err != nil {
+			t.Fatalf("Register failed: %v", err)
+		}
+	}
+	for i := range transports {
+		for j := range transports {
+			if i != j {
+				transports[i].Connect(transports[j].LocalAddr(), transports[j])
+			}
+		}
+	}
+	stopAll := func() {
+		for _, r := range rafts {
+			_ = r.Shutdown().Error()
+		}
+		if r2 := lc.Raft(ids[1]); r2 != nil && r2 != rafts[1] {
+			_ = r2.Shutdown().Error()
+		}
+	}
+	t.Cleanup(stopAll)
+
+	// Elect a leader, then stop and restart one follower.
+	leader := waitForAnyLeader(t, rafts, 10*time.Second)
+	followerIdx := -1
+	for i, r := range rafts {
+		if r != leader {
+			followerIdx = i
+			break
+		}
+	}
+	if followerIdx == -1 {
+		t.Fatalf("no follower found")
+	}
+	followerID := ids[followerIdx]
+	if err := lc.Stop(followerID); err != nil {
+		t.Fatalf("Stop failed: %v", err)
+	}
+	if err := lc.Restart(followerID); err != nil {
+		t.Fatalf("Restart failed: %v", err)
+	}
+	restarted := lc.Raft(followerID)
+	if restarted == nil || restarted == rafts[followerIdx] {
+		t.Fatalf("expected a fresh runtime after Restart")
+	}
+
+	// The target's shutdown closed the follower's transport (wiping its
+	// routing table); restore the in-process topology.
+	for i := range transports {
+		if i == followerIdx {
+			continue
+		}
+		transports[i].Connect(transports[followerIdx].LocalAddr(), transports[followerIdx])
+		transports[followerIdx].Connect(transports[i].LocalAddr(), transports[i])
+	}
+
+	// Commit an entry after the restart; the restarted follower must catch
+	// its durable log up to it.
+	future := leader.Apply([]byte("rejoin"), 0)
+	if err := future.Error(); err != nil {
+		t.Fatalf("Apply failed: %v", err)
+	}
+	appliedIndex := future.Index()
+
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		if restarted.LastIndex() >= appliedIndex {
+			return
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	t.Fatalf("restarted follower did not rejoin: state=%v lastIndex=%d appliedIndex=%d",
+		restarted.State(), restarted.LastIndex(), appliedIndex)
+}
+
+// TestLifecycleControllerPauseStopsProtocolOutput verifies that a paused node
+// emits no protocol output at all: with the leader paused, the follower stops
+// receiving heartbeats and starts an election within a couple of heartbeat
+// timeouts (it leaves the follower state), and once the leader resumes the
+// cluster re-establishes leadership.
+func TestLifecycleControllerPauseStopsProtocolOutput(t *testing.T) {
+	ids := []ServerID{"p1", "p2"}
+	servers := []Server{
+		{Suffrage: Voter, ID: ids[0], Address: ServerAddress(string(ids[0]))},
+		{Suffrage: Voter, ID: ids[1], Address: ServerAddress(string(ids[1]))},
+	}
+	var rafts []*Raft
+	var transports []*InmemTransport
+	for _, id := range ids {
+		conf := DefaultConfig()
+		conf.HeartbeatTimeout = 50 * time.Millisecond
+		conf.ElectionTimeout = 50 * time.Millisecond
+		conf.CommitTimeout = 5 * time.Millisecond
+		conf.LeaderLeaseTimeout = 50 * time.Millisecond
+		conf.LocalID = id
+		conf.Logger = newTestLogger(t)
+		store := NewInmemStore()
+		snaps := NewInmemSnapshotStore()
+		_, trans := NewInmemTransport(ServerAddress(string(id)))
+		if err := BootstrapCluster(conf, store, store, snaps, trans, Configuration{Servers: servers}); err != nil {
+			t.Fatalf("BootstrapCluster %s: %v", id, err)
+		}
+		r, err := NewRaft(conf, &MockFSM{}, store, store, snaps, trans)
+		if err != nil {
+			t.Fatalf("NewRaft %s: %v", id, err)
+		}
+		rafts = append(rafts, r)
+		transports = append(transports, trans)
+	}
+	t.Cleanup(func() {
+		for _, r := range rafts {
+			_ = r.Shutdown().Error()
+		}
+	})
+	for i := range transports {
+		for j := range transports {
+			if i != j {
+				transports[i].Connect(ServerAddress(string(ids[j])), transports[j])
+			}
+		}
+	}
+
+	leader := waitForAnyLeader(t, rafts, 10*time.Second)
+	follower := rafts[0]
+	if leader == rafts[0] {
+		follower = rafts[1]
+	}
+
+	lc := NewLifecycleController(leader)
+	if err := lc.Pause(leader.localID); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+
+	// Without leader heartbeats the follower times out and starts elections:
+	// the paused leader emits no protocol output.
+	deadline := time.Now().Add(3 * time.Second)
+	for follower.State() == Follower && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if got := follower.State(); got == Follower {
+		t.Fatalf("follower never timed out while the leader was paused (heartbeats still flowing)")
+	}
+
+	if err := lc.Resume(leader.localID); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+	// The cluster re-establishes a leader shortly after resume.
+	deadline = time.Now().Add(5 * time.Second)
+	for (rafts[0].State() != Leader && rafts[1].State() != Leader) && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if rafts[0].State() != Leader && rafts[1].State() != Leader {
+		t.Fatalf("no leader after resume: p1=%s p2=%s", rafts[0].State(), rafts[1].State())
+	}
+}
+
+// TestLifecycleControllerCrashDuringInflightTransfer verifies that Crash
+// completes while a leadership transfer is in flight in a controlled
+// deployment: the transfer's TimeoutNow request is captured by the message
+// controller and the sender blocks on it, and Crash aborts the transfer
+// (through the shutdown signal and the transport close), waits for the
+// auxiliary transfer goroutines to exit, and returns without hanging. The
+// captured TimeoutNow entry stays pending and can still be dropped.
+func TestLifecycleControllerCrashDuringInflightTransfer(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+
+	mkConf := func(id ServerID, hb, elect time.Duration) *Config {
+		conf := inmemConfig(t)
+		conf.HeartbeatTimeout = hb
+		conf.ElectionTimeout = elect
+		conf.LeaderLeaseTimeout = hb / 2
+		conf.CommitTimeout = 50 * time.Millisecond
+		conf.PreVoteDisabled = true
+		conf.LocalID = id
+		return conf
+	}
+	conf1 := mkConf(ServerID("node1"), 1*time.Second, 1*time.Second)
+	conf2 := mkConf(ServerID("node2"), 30*time.Second, 30*time.Second)
+
+	_, t1 := NewInmemTransportWithTimeout(addr1, 5*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 5*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, conf1.LocalID)
+	w2 := NewControlledTransport(t2, ctl, conf2.LocalID)
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+
+	store1 := NewInmemStore()
+	store2 := NewInmemStore()
+	snaps1 := NewInmemSnapshotStore()
+	snaps2 := NewInmemSnapshotStore()
+	configuration := Configuration{Servers: []Server{
+		{Suffrage: Voter, ID: conf1.LocalID, Address: addr1},
+		{Suffrage: Voter, ID: conf2.LocalID, Address: addr2},
+	}}
+	if err := BootstrapCluster(conf1, store1, store1, snaps1, w1, configuration); err != nil {
+		t.Fatalf("bootstrap node1: %v", err)
+	}
+	if err := BootstrapCluster(conf2, store2, store2, snaps2, w2, configuration); err != nil {
+		t.Fatalf("bootstrap node2: %v", err)
+	}
+	ctl.SetControlled(true)
+
+	r1, err := NewRaft(conf1, &MockFSM{}, store1, store1, snaps1, w1)
+	if err != nil {
+		t.Fatalf("NewRaft node1: %v", err)
+	}
+	r2, err := NewRaft(conf2, &MockFSM{}, store2, store2, snaps2, w2)
+	if err != nil {
+		t.Fatalf("NewRaft node2: %v", err)
+	}
+	t.Cleanup(func() {
+		_ = r1.Shutdown().Error()
+		_ = r2.Shutdown().Error()
+	})
+
+	// Drive node1 to leadership purely through capture and injection.
+	deadline := time.Now().Add(30 * time.Second)
+	for r1.State() != Leader {
+		if time.Now().After(deadline) {
+			t.Fatalf("node1 never became leader; state=%s pending=%+v", r1.State(), ctl.Pending())
+		}
+		pumpController(t, ctl)
+	}
+	// Drain the remaining captured traffic so the transfer starts cleanly.
+	deadline = time.Now().Add(15 * time.Second)
+	for {
+		if len(ctl.Pending()) == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			break
+		}
+		pumpController(t, ctl)
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// Start a leadership transfer; its TimeoutNow request is captured and the
+	// sender blocks on the controller continuation.
+	transferFuture := r1.LeadershipTransferToServer(conf2.LocalID, addr2)
+	_ = transferFuture
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		for _, pm := range p {
+			if pm.Kind == MessageKindTimeoutNowRequest {
+				return true
+			}
+		}
+		return false
+	}, 15*time.Second)
+
+	lc := NewLifecycleController(r1)
+	crashDone := make(chan error, 1)
+	go func() { crashDone <- lc.Crash(conf1.LocalID) }()
+	select {
+	case err := <-crashDone:
+		if err != nil {
+			t.Fatalf("Crash failed: %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatalf("Crash hung while a leadership transfer was in flight")
+	}
+	if got := r1.State(); got != Shutdown {
+		t.Fatalf("expected Shutdown after Crash, got %v", got)
+	}
+
+	// The captured TimeoutNow entry survives the lifecycle change as a
+	// pending message; the tester can still manage it.
+	found := false
+	for _, pm := range ctl.Pending() {
+		if pm.Kind == MessageKindTimeoutNowRequest {
+			found = true
+			if err := ctl.Drop(pm.Handle); err != nil {
+				t.Fatalf("Drop of preserved TimeoutNow entry failed: %v", err)
+			}
+		}
+	}
+	if !found {
+		t.Fatalf("captured TimeoutNow entry was lost across Crash")
+	}
+}
+
+// TestLifecycleControllerPauseBlocksInboundHandling verifies that a paused
+// node does not handle inbound protocol messages: AppendEntries delivered to a
+// paused follower are not processed (the follower's commit index does not
+// advance and the leader's Apply does not complete while the pause lasts), and
+// after Resume the same normal ingress path processes the captured traffic and
+// the cluster recovers.
+func TestLifecycleControllerPauseBlocksInboundHandling(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+
+	mkConf := func(id ServerID) *Config {
+		conf := inmemConfig(t)
+		conf.HeartbeatTimeout = 500 * time.Millisecond
+		conf.ElectionTimeout = 1 * time.Second
+		conf.LeaderLeaseTimeout = 400 * time.Millisecond
+		conf.CommitTimeout = 50 * time.Millisecond
+		conf.PreVoteDisabled = true
+		conf.LocalID = id
+		return conf
+	}
+	conf1 := mkConf(ServerID("node1"))
+	conf2 := mkConf(ServerID("node2"))
+
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, conf1.LocalID)
+	w2 := NewControlledTransport(t2, ctl, conf2.LocalID)
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+
+	store1 := NewInmemStore()
+	store2 := NewInmemStore()
+	snaps1 := NewInmemSnapshotStore()
+	snaps2 := NewInmemSnapshotStore()
+	configuration := Configuration{Servers: []Server{
+		{Suffrage: Voter, ID: conf1.LocalID, Address: addr1},
+		{Suffrage: Voter, ID: conf2.LocalID, Address: addr2},
+	}}
+	if err := BootstrapCluster(conf1, store1, store1, snaps1, w1, configuration); err != nil {
+		t.Fatalf("bootstrap node1: %v", err)
+	}
+	if err := BootstrapCluster(conf2, store2, store2, snaps2, w2, configuration); err != nil {
+		t.Fatalf("bootstrap node2: %v", err)
+	}
+	ctl.SetControlled(true)
+
+	r1, err := NewRaft(conf1, &MockFSM{}, store1, store1, snaps1, w1)
+	if err != nil {
+		t.Fatalf("NewRaft node1: %v", err)
+	}
+	r2, err := NewRaft(conf2, &MockFSM{}, store2, store2, snaps2, w2)
+	if err != nil {
+		t.Fatalf("NewRaft node2: %v", err)
+	}
+	t.Cleanup(func() {
+		_ = r1.Shutdown().Error()
+		_ = r2.Shutdown().Error()
+	})
+
+	// Drive either node to leadership purely through capture and injection,
+	// then settle the cluster so the follower has committed the leader's noop.
+	var leader, follower *Raft
+	deadline := time.Now().Add(30 * time.Second)
+	for r1.State() != Leader && r2.State() != Leader {
+		if time.Now().After(deadline) {
+			t.Fatalf("no leader elected; r1=%s r2=%s", r1.State(), r2.State())
+		}
+		pumpController(t, ctl)
+	}
+	if r1.State() == Leader {
+		leader, follower = r1, r2
+	} else {
+		leader, follower = r2, r1
+	}
+	deadline = time.Now().Add(15 * time.Second)
+	for follower.CommitIndex() < 1 {
+		if time.Now().After(deadline) {
+			t.Fatalf("follower never committed the noop: commit=%d", follower.CommitIndex())
+		}
+		pumpController(t, ctl)
+	}
+
+	lc := NewLifecycleController(follower)
+	if err := lc.Pause(follower.localID); err != nil {
+		t.Fatalf("Pause failed: %v", err)
+	}
+	// Pause returns once the main loop has reached the pause boundary, so the
+	// commit index read here is stable: any message already in flight at the
+	// time of the call completed before the boundary.
+	baseline := follower.CommitIndex()
+
+	// The leader tries to replicate a new entry while the follower is paused;
+	// the request is captured by the transport but the paused follower must
+	// not handle it: no response is produced, the follower's commit index does
+	// not advance, and the leader's Apply does not complete.
+	applied := make(chan error, 1)
+	go func() { applied <- leader.Apply([]byte("while-paused"), 0).Error() }()
+
+	window := time.Now().Add(150 * time.Millisecond)
+	for time.Now().Before(window) {
+		if got := follower.CommitIndex(); got != baseline {
+			t.Fatalf("paused follower processed inbound messages: commit=%d", got)
+		}
+		select {
+		case err := <-applied:
+			t.Fatalf("Apply completed while the follower was paused: %v", err)
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+
+	if err := lc.Resume(follower.localID); err != nil {
+		t.Fatalf("Resume failed: %v", err)
+	}
+
+	// After resume the same ingress path processes the captured traffic: the
+	// Apply completes and the follower's commit index advances.
+	deadline = time.Now().Add(10 * time.Second)
+	appliedDone := false
+	for {
+		if time.Now().After(deadline) {
+			t.Fatalf("cluster did not recover after resume: leader=%s follower=%s commit=%d",
+				leader.State(), follower.State(), follower.CommitIndex())
+		}
+		pumpController(t, ctl)
+		if !appliedDone {
+			select {
+			case err := <-applied:
+				if err != nil {
+					t.Fatalf("Apply failed after resume: %v", err)
+				}
+				appliedDone = true
+			default:
+			}
+		}
+		if appliedDone && follower.CommitIndex() > baseline {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// TestLifecycleControllerRestartKeepsPendingInjectible verifies the full
+// lifecycle interaction with the message controller: a message captured before
+// Crash stays pending, and after Restart the LifecycleController re-binds it
+// to the fresh transport wrapper of the same node, so the same handle is
+// injectable again through the normal ingress of the live peer (the peer
+// answers and the response is captured) and the handle is invalidated on
+// acceptance.
+func TestLifecycleControllerRestartKeepsPendingInjectible(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+
+	mkConf := func(id ServerID, hb, elect time.Duration) *Config {
+		conf := inmemConfig(t)
+		conf.HeartbeatTimeout = hb
+		conf.ElectionTimeout = elect
+		conf.LeaderLeaseTimeout = hb / 2
+		conf.CommitTimeout = 50 * time.Millisecond
+		conf.PreVoteDisabled = true
+		conf.LocalID = id
+		return conf
+	}
+	conf1 := mkConf(ServerID("node1"), 1*time.Second, 1*time.Second)
+	conf2 := mkConf(ServerID("node2"), 30*time.Second, 30*time.Second)
+
+	_, t1 := NewInmemTransportWithTimeout(addr1, 5*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 5*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, conf1.LocalID)
+	w2 := NewControlledTransport(t2, ctl, conf2.LocalID)
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+
+	store1 := NewInmemStore()
+	store2 := NewInmemStore()
+	snaps1 := NewInmemSnapshotStore()
+	snaps2 := NewInmemSnapshotStore()
+	configuration := Configuration{Servers: []Server{
+		{Suffrage: Voter, ID: conf1.LocalID, Address: addr1},
+		{Suffrage: Voter, ID: conf2.LocalID, Address: addr2},
+	}}
+	if err := BootstrapCluster(conf1, store1, store1, snaps1, w1, configuration); err != nil {
+		t.Fatalf("BootstrapCluster node1: %v", err)
+	}
+	if err := BootstrapCluster(conf2, store2, store2, snaps2, w2, configuration); err != nil {
+		t.Fatalf("BootstrapCluster node2: %v", err)
+	}
+	ctl.SetControlled(true)
+
+	r1, err := NewRaft(conf1, &MockFSM{}, store1, store1, snaps1, w1)
+	if err != nil {
+		t.Fatalf("NewRaft node1: %v", err)
+	}
+	r2, err := NewRaft(conf2, &MockFSM{}, store2, store2, snaps2, w2)
+	if err != nil {
+		t.Fatalf("NewRaft node2: %v", err)
+	}
+
+	// Drive node1 to leadership purely through capture and injection.
+	deadline := time.Now().Add(30 * time.Second)
+	for r1.State() != Leader {
+		if time.Now().After(deadline) {
+			t.Fatalf("node1 never became leader; state=%s pending=%+v", r1.State(), ctl.Pending())
+		}
+		pumpController(t, ctl)
+	}
+	// Drain the remaining captured traffic so the transfer starts cleanly.
+	deadline = time.Now().Add(15 * time.Second)
+	for len(ctl.Pending()) != 0 {
+		if time.Now().After(deadline) {
+			break
+		}
+		pumpController(t, ctl)
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// Start a leadership transfer; its TimeoutNow request is captured and the
+	// sender blocks on the controller continuation.
+	transferFuture := r1.LeadershipTransferToServer(conf2.LocalID, addr2)
+	_ = transferFuture
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		for _, pm := range p {
+			if pm.Kind == MessageKindTimeoutNowRequest {
+				return true
+			}
+		}
+		return false
+	}, 15*time.Second)
+	var timeoutHandle MessageHandle
+	for _, pm := range ctl.Pending() {
+		if pm.Kind == MessageKindTimeoutNowRequest {
+			timeoutHandle = pm.Handle
+			break
+		}
+	}
+	if timeoutHandle == (MessageHandle{}) {
+		t.Fatalf("TimeoutNow entry not found")
+	}
+
+	lc := NewLifecycleController(r1)
+	if err := lc.Crash(conf1.LocalID); err != nil {
+		t.Fatalf("Crash failed: %v", err)
+	}
+	if err := lc.Restart(conf1.LocalID); err != nil {
+		t.Fatalf("Restart failed: %v", err)
+	}
+	r1b := lc.Raft(conf1.LocalID)
+	if r1b == nil || r1b == r1 {
+		t.Fatalf("expected a fresh runtime after Restart")
+	}
+	t.Cleanup(func() {
+		_ = r1b.Shutdown().Error()
+		_ = r2.Shutdown().Error()
+	})
+
+	// The preserved entry is re-bound to the fresh wrapper of the same node;
+	// restore the in-process route and deliver it through the normal ingress
+	// of node2.
+	freshW1 := r1b.trans.(*ControlledTransport)
+	freshW1.Connect(addr2, w2)
+	w2.Connect(addr1, freshW1)
+
+	if err := ctl.Inject(timeoutHandle); err != nil {
+		t.Fatalf("inject preserved TimeoutNow after restart: %v", err)
+	}
+	// Node2 processed the request through its live ingress: the response is
+	// captured as a new pending entry with reversed routing.
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		for _, pm := range p {
+			if pm.Kind == MessageKindTimeoutNowResponse && pm.Source == conf2.LocalID && pm.Target == conf1.LocalID {
+				return true
+			}
+		}
+		return false
+	}, 5*time.Second)
+	// Acceptance invalidated the handle.
+	if err := ctl.Inject(timeoutHandle); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("handle stayed valid after post-restart acceptance: %v", err)
+	}
+}
+
+func waitForAnyLeader(t *testing.T, nodes []*Raft, timeout time.Duration) *Raft {
+	t.Helper()
+	deadline := time.Now().Add(timeout)
+	for time.Now().Before(deadline) {
+		for _, r := range nodes {
+			if r.State() == Leader {
+				return r
+			}
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("no leader elected")
+	return nil
+}
