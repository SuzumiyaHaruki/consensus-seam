diff --git a/controlled_transport.go b/controlled_transport.go
new file mode 100644
index 0000000..525f043
--- /dev/null
+++ b/controlled_transport.go
@@ -0,0 +1,350 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"fmt"
+	"io"
+	"sync"
+	"time"
+)
+
+// ControlledTransport wraps an InmemTransport and routes every outbound
+// cross-node message through a MessageController while controlled mode is
+// enabled. While disabled, it is a pure pass-through delegate, so production
+// behavior is unchanged. Install one wrapper per node and pass the wrapper to
+// NewRaft as the node's Transport.
+//
+// The wrapper implements Transport, WithPreVote, WithPeers, and WithClose so it
+// is a drop-in LoopbackTransport for in-process testing.
+type ControlledTransport struct {
+	base       *InmemTransport
+	controller *MessageController
+	id         ServerID // the local node's ID, the Source of captured requests
+
+	closedCh    chan struct{}
+	closeOnce   sync.Once
+	pipelinesMu sync.Mutex
+	pipelines   []*controlledPipeline
+}
+
+// NewControlledTransport wraps an in-memory transport and binds it to the
+// local node ID and the shared MessageController. The wrapper auto-registers
+// nothing else: target ServerIDs for captured requests come from the ID
+// argument of each transport call (the target's ID), exactly as Raft invokes
+// them.
+func NewControlledTransport(t *InmemTransport, ctl *MessageController, id ServerID) *ControlledTransport {
+	return &ControlledTransport{
+		base:       t,
+		controller: ctl,
+		id:         id,
+		closedCh:   make(chan struct{}),
+	}
+}
+
+func (t *ControlledTransport) controlled() bool {
+	return t.controller != nil && t.controller.Controlled()
+}
+
+// Consumer implements the Transport interface. Inbound RPCs are consumed
+// directly from the underlying transport's consumer channel; in controlled
+// mode the only writer to that channel is MessageController.Inject.
+func (t *ControlledTransport) Consumer() <-chan RPC {
+	return t.base.Consumer()
+}
+
+// LocalAddr implements the Transport interface.
+func (t *ControlledTransport) LocalAddr() ServerAddress {
+	return t.base.LocalAddr()
+}
+
+// AppendEntries implements the Transport interface. In controlled mode the
+// request is captured and the call blocks until the captured response entry is
+// injected, mirroring the synchronous exchange of InmemTransport.AppendEntries.
+func (t *ControlledTransport) AppendEntries(id ServerID, target ServerAddress, args *AppendEntriesRequest, resp *AppendEntriesResponse) error {
+	if !t.controlled() {
+		return t.base.AppendEntries(id, target, args, resp)
+	}
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{AppendEntriesRequest: copyAppendEntriesRequest(args)}
+	if _, err := t.controller.capture(t, MessageKindAppendEntriesRequest, t.id, id, target, payload, nil, waitCh); err != nil {
+		return err
+	}
+	return t.waitRPC(waitCh, resp, t.base.timeout)
+}
+
+// RequestVote implements the Transport interface. See AppendEntries.
+func (t *ControlledTransport) RequestVote(id ServerID, target ServerAddress, args *RequestVoteRequest, resp *RequestVoteResponse) error {
+	if !t.controlled() {
+		return t.base.RequestVote(id, target, args, resp)
+	}
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{RequestVoteRequest: copyRequestVoteRequest(args)}
+	if _, err := t.controller.capture(t, MessageKindRequestVoteRequest, t.id, id, target, payload, nil, waitCh); err != nil {
+		return err
+	}
+	return t.waitRPC(waitCh, resp, t.base.timeout)
+}
+
+// RequestPreVote implements the WithPreVote interface. See AppendEntries.
+func (t *ControlledTransport) RequestPreVote(id ServerID, target ServerAddress, args *RequestPreVoteRequest, resp *RequestPreVoteResponse) error {
+	if !t.controlled() {
+		return t.base.RequestPreVote(id, target, args, resp)
+	}
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{RequestPreVoteRequest: copyRequestPreVoteRequest(args)}
+	if _, err := t.controller.capture(t, MessageKindRequestPreVoteRequest, t.id, id, target, payload, nil, waitCh); err != nil {
+		return err
+	}
+	return t.waitRPC(waitCh, resp, t.base.timeout)
+}
+
+// InstallSnapshot implements the Transport interface. The snapshot stream is
+// fully buffered into replayable storage at capture time; a copy failure is
+// returned to the caller and no entry is registered. Delivery uses a fresh
+// reader over the controller's private buffer.
+func (t *ControlledTransport) InstallSnapshot(id ServerID, target ServerAddress, args *InstallSnapshotRequest, resp *InstallSnapshotResponse, data io.Reader) error {
+	if !t.controlled() {
+		return t.base.InstallSnapshot(id, target, args, resp, data)
+	}
+	var stream []byte
+	if data != nil {
+		buf, err := io.ReadAll(data)
+		if err != nil {
+			return fmt.Errorf("failed to buffer snapshot stream: %w", err)
+		}
+		stream = buf
+	}
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{InstallSnapshotRequest: copyInstallSnapshotRequest(args)}
+	if _, err := t.controller.capture(t, MessageKindInstallSnapshotRequest, t.id, id, target, payload, stream, waitCh); err != nil {
+		return err
+	}
+	return t.waitRPC(waitCh, resp, 10*t.base.timeout)
+}
+
+// TimeoutNow implements the Transport interface. See AppendEntries.
+func (t *ControlledTransport) TimeoutNow(id ServerID, target ServerAddress, args *TimeoutNowRequest, resp *TimeoutNowResponse) error {
+	if !t.controlled() {
+		return t.base.TimeoutNow(id, target, args, resp)
+	}
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{TimeoutNowRequest: copyTimeoutNowRequest(args)}
+	if _, err := t.controller.capture(t, MessageKindTimeoutNowRequest, t.id, id, target, payload, nil, waitCh); err != nil {
+		return err
+	}
+	return t.waitRPC(waitCh, resp, 10*t.base.timeout)
+}
+
+// AppendEntriesPipeline implements the Transport interface. In controlled
+// mode each pipelined request is captured and its AppendFuture completes when
+// the captured response entry is injected.
+func (t *ControlledTransport) AppendEntriesPipeline(id ServerID, target ServerAddress) (AppendPipeline, error) {
+	if !t.controlled() {
+		return t.base.AppendEntriesPipeline(id, target)
+	}
+	// Mirror the underlying transport's peer validation at creation time.
+	t.base.RLock()
+	_, ok := t.base.peers[target]
+	t.base.RUnlock()
+	if !ok {
+		return nil, fmt.Errorf("failed to connect to peer: %v", target)
+	}
+	p := &controlledPipeline{
+		trans:      t,
+		controller: t.controller,
+		source:     t.id,
+		target:     id,
+		targetAddr: target,
+		doneCh:     make(chan AppendFuture, 16),
+		closedCh:   make(chan struct{}),
+	}
+	t.pipelinesMu.Lock()
+	t.pipelines = append(t.pipelines, p)
+	t.pipelinesMu.Unlock()
+	return p, nil
+}
+
+// EncodePeer implements the Transport interface.
+func (t *ControlledTransport) EncodePeer(id ServerID, addr ServerAddress) []byte {
+	return t.base.EncodePeer(id, addr)
+}
+
+// DecodePeer implements the Transport interface.
+func (t *ControlledTransport) DecodePeer(buf []byte) ServerAddress {
+	return t.base.DecodePeer(buf)
+}
+
+// SetHeartbeatHandler implements the Transport interface. The underlying
+// in-memory transport does not support the fast path, so heartbeats arrive on
+// the consumer channel and are captured like any other message.
+func (t *ControlledTransport) SetHeartbeatHandler(cb func(rpc RPC)) {
+	t.base.SetHeartbeatHandler(cb)
+}
+
+// Connect implements the WithPeers interface. Wrapped transports are unwrapped
+// so the underlying routing tables connect, exactly as with plain
+// InmemTransport values.
+func (t *ControlledTransport) Connect(peer ServerAddress, tr Transport) {
+	base := tr
+	if ct, ok := tr.(*ControlledTransport); ok {
+		base = ct.base
+	}
+	t.base.Connect(peer, base)
+}
+
+// Disconnect implements the WithPeers interface.
+func (t *ControlledTransport) Disconnect(peer ServerAddress) {
+	t.base.Disconnect(peer)
+	t.pipelinesMu.Lock()
+	for _, p := range t.pipelines {
+		if p.targetAddr == peer {
+			p.Close()
+		}
+	}
+	t.pipelinesMu.Unlock()
+}
+
+// DisconnectAll implements the WithPeers interface.
+func (t *ControlledTransport) DisconnectAll() {
+	t.base.DisconnectAll()
+	t.pipelinesMu.Lock()
+	ps := t.pipelines
+	t.pipelines = nil
+	t.pipelinesMu.Unlock()
+	for _, p := range ps {
+		p.Close()
+	}
+}
+
+// Close implements the WithClose interface: it unblocks every controlled call
+// still waiting on a response and closes the underlying transport.
+func (t *ControlledTransport) Close() error {
+	t.closeOnce.Do(func() { close(t.closedCh) })
+	t.pipelinesMu.Lock()
+	ps := t.pipelines
+	t.pipelines = nil
+	t.pipelinesMu.Unlock()
+	for _, p := range ps {
+		p.Close()
+	}
+	return t.base.Close()
+}
+
+// waitRPC blocks until the captured response entry is injected, then copies
+// the typed response into resp. The wait is bounded by the same timeout the
+// underlying transport would use for the same exchange, so a dropped or never
+// injected response resolves exactly like a real transport timeout and never
+// deadlocks node shutdown.
+func (t *ControlledTransport) waitRPC(waitCh chan RPCResponse, resp interface{}, timeout time.Duration) error {
+	var timeoutCh <-chan time.Time
+	if timeout > 0 {
+		timeoutCh = time.After(timeout)
+	}
+	select {
+	case rpcResp := <-waitCh:
+		if rpcResp.Error != nil {
+			return rpcResp.Error
+		}
+		switch out := rpcResp.Response.(type) {
+		case *AppendEntriesResponse:
+			if r, ok := resp.(*AppendEntriesResponse); ok {
+				*r = *out
+				return nil
+			}
+		case *RequestVoteResponse:
+			if r, ok := resp.(*RequestVoteResponse); ok {
+				*r = *out
+				return nil
+			}
+		case *RequestPreVoteResponse:
+			if r, ok := resp.(*RequestPreVoteResponse); ok {
+				*r = *out
+				return nil
+			}
+		case *InstallSnapshotResponse:
+			if r, ok := resp.(*InstallSnapshotResponse); ok {
+				*r = *out
+				return nil
+			}
+		case *TimeoutNowResponse:
+			if r, ok := resp.(*TimeoutNowResponse); ok {
+				*r = *out
+				return nil
+			}
+		}
+		return fmt.Errorf("unexpected response type %T", rpcResp.Response)
+	case <-timeoutCh:
+		return fmt.Errorf("command timed out")
+	case <-t.closedCh:
+		return ErrTransportShutdown
+	}
+}
+
+// controlledPipeline is the controlled-mode AppendPipeline. Each AppendEntries
+// captures a request; the returned AppendFuture completes with the response
+// when the captured response entry is injected.
+type controlledPipeline struct {
+	trans      *ControlledTransport
+	controller *MessageController
+	source     ServerID
+	target     ServerID
+	targetAddr ServerAddress
+
+	doneCh    chan AppendFuture
+	closedCh  chan struct{}
+	closeOnce sync.Once
+}
+
+func (p *controlledPipeline) AppendEntries(args *AppendEntriesRequest, resp *AppendEntriesResponse) (AppendFuture, error) {
+	select {
+	case <-p.closedCh:
+		return nil, ErrPipelineShutdown
+	default:
+	}
+	future := &appendFuture{start: time.Now(), args: args, resp: resp}
+	future.init()
+
+	waitCh := make(chan RPCResponse, 1)
+	payload := MessagePayload{AppendEntriesRequest: copyAppendEntriesRequest(args)}
+	if _, err := p.controller.capture(p.trans, MessageKindAppendEntriesRequest, p.source, p.target, p.targetAddr, payload, nil, waitCh); err != nil {
+		return nil, err
+	}
+
+	timeout := p.trans.base.timeout
+	go func() {
+		var timeoutCh <-chan time.Time
+		if timeout > 0 {
+			timeoutCh = time.After(timeout)
+		}
+		var rpcResp RPCResponse
+		select {
+		case rpcResp = <-waitCh:
+		case <-timeoutCh:
+			rpcResp = RPCResponse{Error: fmt.Errorf("command timed out")}
+		case <-p.closedCh:
+			rpcResp = RPCResponse{Error: ErrPipelineShutdown}
+		}
+		if rpcResp.Error == nil {
+			if out, ok := rpcResp.Response.(*AppendEntriesResponse); ok {
+				*future.resp = *out
+			}
+		}
+		future.respond(rpcResp.Error)
+		select {
+		case p.doneCh <- future:
+		case <-p.closedCh:
+		}
+	}()
+	return future, nil
+}
+
+func (p *controlledPipeline) Consumer() <-chan AppendFuture {
+	return p.doneCh
+}
+
+func (p *controlledPipeline) Close() error {
+	p.closeOnce.Do(func() { close(p.closedCh) })
+	return nil
+}
