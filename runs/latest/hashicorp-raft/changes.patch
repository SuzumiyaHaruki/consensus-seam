+// TestMessageControllerDropAndInjectPreserveOrder verifies that Drop and a
+// successful Inject remove exactly one entry and never reorder the remaining
+// pending entries: Pending always reflects controller acceptance order.
+func TestMessageControllerDropAndInjectPreserveOrder(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+	ctl.SetControlled(true)
+
+	recv := make(chan receivedRPC, 32)
+	go respondLikeRaft(t, t2, recv)
+	t.Cleanup(func() {
+		ctl.SetControlled(false)
+		_ = w1.Close()
+		_ = w2.Close()
+	})
+
+	capture := func(term uint64) MessageHandle {
+		t.Helper()
+		go func() {
+			var resp AppendEntriesResponse
+			_ = w1.AppendEntries(ServerID("node2"), addr2, &AppendEntriesRequest{Term: term}, &resp)
+		}()
+		p := waitPending(t, ctl, func(p []PendingMessage) bool {
+			for _, pm := range p {
+				if pm.Message.AppendEntriesRequest != nil && pm.Message.AppendEntriesRequest.Term == term {
+					return true
+				}
+			}
+			return false
+		}, 5*time.Second)
+		for _, pm := range p {
+			if pm.Message.AppendEntriesRequest != nil && pm.Message.AppendEntriesRequest.Term == term {
+				return pm.Handle
+			}
+		}
+		t.Fatal("captured entry not found")
+		return MessageHandle{}
+	}
+
+	describe := func() []string {
+		var out []string
+		for _, pm := range ctl.Pending() {
+			switch {
+			case pm.Message.AppendEntriesRequest != nil:
+				out = append(out, fmt.Sprintf("req%d", pm.Message.AppendEntriesRequest.Term))
+			case pm.Message.AppendEntriesResponse != nil:
+				out = append(out, "resp")
+			default:
+				out = append(out, string(pm.Kind))
+			}
+		}
+		return out
+	}
+	expect := func(want ...string) {
+		t.Helper()
+		if got := describe(); !reflect.DeepEqual(got, want) {
+			t.Fatalf("pending order = %v, want %v", got, want)
+		}
+	}
+
+	h1 := capture(1)
+	h2 := capture(2)
+	h3 := capture(3)
+	expect("req1", "req2", "req3")
+
+	// Dropping a middle entry must not reorder the rest.
+	if err := ctl.Drop(h2); err != nil {
+		t.Fatalf("Drop: %v", err)
+	}
+	expect("req1", "req3")
+
+	// A successful Inject of the first remaining entry removes it without
+	// reordering; the response is appended after the still-pending req3 in
+	// acceptance order.
+	if err := ctl.Inject(h1); err != nil {
+		t.Fatalf("Inject: %v", err)
+	}
+	waitReceived(t, recv, 5*time.Second)
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 2 && p[1].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	expect("req3", "resp")
+
+	// Inject the remaining request; its response is appended after the first
+	// response, again in acceptance order.
+	if err := ctl.Inject(h3); err != nil {
+		t.Fatalf("Inject: %v", err)
+	}
+	waitReceived(t, recv, 5*time.Second)
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 2 && p[0].Kind == MessageKindAppendEntriesResponse && p[1].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	expect("resp", "resp")
+
+	// Deliver both responses so the blocked callers resolve.
+	for _, pm := range ctl.Pending() {
+		if err := ctl.Inject(pm.Handle); err != nil {
+			t.Fatalf("Inject response: %v", err)
+		}
+	}
+	expect()
+}
+
+// TestMessageControllerClosedOwnerRebind verifies that Inject of an entry
+// whose owning transport was closed fails deterministically with the entry
+// preserved (it never races a permanently-ready closed channel), and that
+// re-binding the entry to a fresh wrapper of the same node (what
+// LifecycleController.Restart does) makes the same handle injectable again
+// through the normal ingress of the target.
+func TestMessageControllerClosedOwnerRebind(t *testing.T) {
+	addr1 := ServerAddress("addr1")
+	addr2 := ServerAddress("addr2")
+	_, t1 := NewInmemTransportWithTimeout(addr1, 2*time.Second)
+	_, t2 := NewInmemTransportWithTimeout(addr2, 2*time.Second)
+	ctl := NewMessageController()
+	w1 := NewControlledTransport(t1, ctl, ServerID("node1"))
+	w2 := NewControlledTransport(t2, ctl, ServerID("node2"))
+	w1.Connect(addr2, w2)
+	w2.Connect(addr1, w1)
+	ctl.SetControlled(true)
+
+	recv := make(chan receivedRPC, 32)
+	go respondLikeRaft(t, t2, recv)
+	t.Cleanup(func() {
+		ctl.SetControlled(false)
+		_ = w2.Close()
+	})
+
+	callerDone := make(chan error, 1)
+	go func() {
+		var resp AppendEntriesResponse
+		callerDone <- w1.AppendEntries(ServerID("node2"), addr2, &AppendEntriesRequest{Term: 7}, &resp)
+	}()
+	p := waitPending(t, ctl, func(p []PendingMessage) bool { return len(p) == 1 }, 5*time.Second)
+	h := p[0].Handle
+
+	// Close the owning transport the way Stop/Crash does; the captured entry
+	// stays pending and the blocked original caller is unblocked with a
+	// transport-shutdown error (the old runtime is gone).
+	if err := w1.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	select {
+	case err := <-callerDone:
+		if err == nil {
+			t.Fatalf("caller completed without error after transport close")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatalf("caller never unblocked after transport close")
+	}
+	p = ctl.Pending()
+	if len(p) != 1 || p[0].Handle != h {
+		t.Fatalf("closed-owner entry was lost: %+v", p)
+	}
+
+	// Inject is now deterministic: it fails with ErrMessageNotAccepted and
+	// preserves the entry on every attempt.
+	for i := 0; i < 5; i++ {
+		if err := ctl.Inject(h); !errors.Is(err, ErrMessageNotAccepted) {
+			t.Fatalf("closed-owner inject %d: got %v, want ErrMessageNotAccepted", i, err)
+		}
+	}
+	p = ctl.Pending()
+	if len(p) != 1 || p[0].Handle != h {
+		t.Fatalf("closed-owner inject did not preserve the entry: %+v", p)
+	}
+
+	// Re-bind the entry to a fresh wrapper of the same node (what
+	// LifecycleController.Restart does), restore the route, and deliver.
+	w1b := NewControlledTransport(t1, ctl, ServerID("node1"))
+	ctl.rebindOwner(w1, w1b)
+	w1b.Connect(addr2, w2)
+	if err := ctl.Inject(h); err != nil {
+		t.Fatalf("inject after rebind: %v", err)
+	}
+	waitReceived(t, recv, 5*time.Second)
+	waitPending(t, ctl, func(p []PendingMessage) bool {
+		return len(p) == 1 && p[0].Kind == MessageKindAppendEntriesResponse
+	}, 5*time.Second)
+	if err := ctl.Inject(ctl.Pending()[0].Handle); err != nil {
+		t.Fatalf("inject response: %v", err)
+	}
+	if err := ctl.Inject(h); !errors.Is(err, ErrMessageNotPending) {
+		t.Fatalf("handle stayed valid after rebind delivery: %v", err)
+	}
+	_ = w1b.Close()
+}
