@@ -0,0 +1,395 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+// lifecycleTestEnv builds one controlled node plus the pieces needed to
+// restart it with the same identity, configuration and durable stores.
+func lifecycleTestEnv(t *testing.T) (*Raft, *LifecycleController, func()) {
+	t.Helper()
+
+	conf := inmemConfig(t)
+	conf.LocalID = ServerID("lifecycle-node")
+
+	logs := NewInmemStore()
+	stable := NewInmemStore()
+	snaps := NewInmemSnapshotStore()
+	fsm := &MockFSM{}
+
+	_, trans := NewInmemTransport(ServerAddress("lifecycle-node"))
+
+	node, err := NewRaft(conf, fsm, logs, stable, snaps, trans)
+	if err != nil {
+		t.Fatalf("err: %v", err)
+	}
+
+	lc := NewLifecycleController(node, func() (*Raft, error) {
+		// A fresh transport is required: Stop/Crash close the previous one.
+		_, trans2 := NewInmemTransport(ServerAddress("lifecycle-node"))
+		return NewRaft(conf, fsm, logs, stable, snaps, trans2)
+	})
+
+	cleanup := func() {
+		if n := lc.Node(); n != nil {
+			_ = n.Shutdown().Error()
+		}
+	}
+	return node, lc, cleanup
+}
+
+func TestLifecycleController_StopRestart(t *testing.T) {
+	node, lc, cleanup := lifecycleTestEnv(t)
+	defer cleanup()
+
+	// Pause retains the same runtime; the pause gate is engaged.
+	if err := lc.Pause(node); err != nil {
+		t.Fatalf("pause: %v", err)
+	}
+	node.pauseMu.Lock()
+	paused := node.paused
+	node.pauseMu.Unlock()
+	if !paused {
+		t.Fatalf("expected node to be paused")
+	}
+	if err := lc.Pause(node); err != nil {
+		t.Fatalf("second pause: %v", err)
+	}
+
+	// Resume continues the same instance.
+	if err := lc.Resume(node); err != nil {
+		t.Fatalf("resume: %v", err)
+	}
+	node.pauseMu.Lock()
+	paused = node.paused
+	node.pauseMu.Unlock()
+	if paused {
+		t.Fatalf("expected node to be resumed")
+	}
+	if err := lc.Resume(node); err != nil {
+		t.Fatalf("second resume: %v", err)
+	}
+
+	// Stop terminates the runtime through the target's normal shutdown.
+	if err := lc.Stop(node); err != nil {
+		t.Fatalf("stop: %v", err)
+	}
+	if state := node.State(); state != Shutdown {
+		t.Fatalf("expected Shutdown state, got %v", state)
+	}
+	if err := lc.Stop(node); err != nil {
+		t.Fatalf("second stop: %v", err)
+	}
+
+	// Restart builds a fresh runtime with the same identity over the same stores.
+	if err := lc.Restart(node); err != nil {
+		t.Fatalf("restart: %v", err)
+	}
+	node2 := lc.Node()
+	if node2 == node {
+		t.Fatalf("expected a fresh runtime after restart")
+	}
+	if node2.localID != node.localID {
+		t.Fatalf("identity changed: %q != %q", node2.localID, node.localID)
+	}
+	if state := node2.State(); state != Follower {
+		t.Fatalf("expected fresh node to start as follower, got %v", state)
+	}
+}
