new file mode 100644
index 0000000..bf55658
--- /dev/null
+++ b/random_controller_test.go
@@ -0,0 +1,135 @@
+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"testing"
+	"time"
+)
+
+// TestRandomControllerDeterminism verifies that the same seed and draw order
+// reproduce the same sequence, that every value stays inside the target's
+// legal domain [minVal, 2*minVal), that repeated decisions keep varying, and
+// that Choices returns deep copies of the recorded history.
+func TestRandomControllerDeterminism(t *testing.T) {
+	mk := func() *RandomController { return NewRandomController(7, ServerID("node-a")) }
+	a, b := mk(), mk()
+	names := []string{
+		RandomChoiceElectionTimeout,
+		RandomChoiceHeartbeatTimeout,
+		RandomChoiceCommitTimeout,
+		RandomChoiceHeartbeatInterval,
+		RandomChoiceSnapshotInterval,
+	}
+	for i := 0; i < 100; i++ {
+		name := names[i%len(names)]
+		minVal := time.Duration(10+i%90) * time.Millisecond
+		ea := a.draw(name, minVal)
+		eb := b.draw(name, minVal)
+		if ea != eb {
+			t.Fatalf("draw %d diverged between identical seeds: %v != %v", i, ea, eb)
+		}
+		if ea < 0 || ea >= minVal {
+			t.Fatalf("draw %d jitter %v outside legal domain [0, %v)", i, ea, minVal)
+		}
+	}
+
+	ca, cb := a.Choices(), b.Choices()
+	if len(ca) != 100 || len(cb) != 100 {
+		t.Fatalf("expected 100 recorded choices, got %d and %d", len(ca), len(cb))
+	}
+	seenHeartbeat := map[time.Duration]bool{}
+	for i := range ca {
+		if ca[i] != cb[i] {
+			t.Fatalf("choice %d diverged between identical seeds: %+v != %+v", i, ca[i], cb[i])
+		}
+		if ca[i].Owner != ServerID("node-a") {
+			t.Fatalf("choice %d owner = %q, want node-a", i, ca[i].Owner)
+		}
+		if ca[i].Name != names[i%len(names)] {
+			t.Fatalf("choice %d name = %q, want %q", i, ca[i].Name, names[i%len(names)])
+		}
+		minVal := time.Duration(10+i%90) * time.Millisecond
+		if ca[i].Value < minVal || ca[i].Value >= 2*minVal {
+			t.Fatalf("choice %d value %v outside legal domain [%v, %v)", i, ca[i].Value, minVal, 2*minVal)
+		}
+		if ca[i].Name == RandomChoiceHeartbeatTimeout {
+			seenHeartbeat[ca[i].Value] = true
+		}
+	}
+	if len(seenHeartbeat) < 2 {
+		t.Fatalf("expected repeated heartbeat decisions to keep varying, got %v", seenHeartbeat)
+	}
+
+	// Choices returns a deep copy: mutating the result is invisible.
+	ca[0].Name = "mutated"
+	ca[0].Value = 0
+	if got := a.Choices()[0]; got.Name == "mutated" || got.Value == 0 {
+		t.Fatalf("Choices returned an aliased history: %+v", got)
+	}
+}
+
+// TestRandomControllerNodeDraws verifies that a controller installed through
+// Config.Random before NewRaft routes every in-scope protocol draw of the
+// node through the controller and records it with the node's owner.
+func TestRandomControllerNodeDraws(t *testing.T) {
+	conf := DefaultConfig()
+	conf.HeartbeatTimeout = 50 * time.Millisecond
+	conf.ElectionTimeout = 50 * time.Millisecond
+	conf.CommitTimeout = 5 * time.Millisecond
+	conf.LeaderLeaseTimeout = 25 * time.Millisecond
+	conf.SnapshotInterval = 20 * time.Millisecond
+	conf.LocalID = ServerID("node-1")
+	conf.Logger = newTestLogger(t)
+
+	rc := NewRandomController(11, conf.LocalID)
+	conf.Random = rc
+
+	store := NewInmemStore()
+	snap := NewInmemSnapshotStore()
+	_, trans := NewInmemTransport(ServerAddress("10.0.0.1:0"))
+	r, err := NewRaft(conf, &MockFSM{}, store, store, snap, trans)
+	if err != nil {
+		t.Fatalf("NewRaft failed: %v", err)
+	}
+	defer func() { _ = r.Shutdown().Error() }()
+
+	minBy := map[string]time.Duration{
+		RandomChoiceElectionTimeout:   conf.ElectionTimeout,
+		RandomChoiceHeartbeatTimeout:  conf.HeartbeatTimeout,
+		RandomChoiceCommitTimeout:     conf.CommitTimeout,
+		RandomChoiceSnapshotInterval:  conf.SnapshotInterval,
+		RandomChoiceHeartbeatInterval: conf.HeartbeatTimeout / 10,
+	}
+
+	deadline := time.Now().Add(5 * time.Second)
+	var choices []RandomChoice
+	for time.Now().Before(deadline) {
+		choices = rc.Choices()
+		if len(choices) >= 3 {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if len(choices) < 3 {
+		t.Fatalf("expected at least 3 recorded draws, got %d", len(choices))
+	}
+	seen := map[string]bool{}
+	for _, c := range choices {
+		minVal, ok := minBy[c.Name]
+		if !ok {
+			t.Fatalf("unexpected choice name %q in %+v", c.Name, c)
+		}
+		if c.Owner != conf.LocalID {
+			t.Fatalf("choice %+v owned by %q, want %q", c, c.Owner, conf.LocalID)
+		}
+		if c.Value < minVal || c.Value >= 2*minVal {
+			t.Fatalf("choice %+v value %v outside legal domain [%v, %v)", c, c.Value, minVal, 2*minVal)
+		}
+		seen[c.Name] = true
+	}
+	if !seen[RandomChoiceHeartbeatTimeout] {
+		t.Fatalf("expected a follower heartbeat draw, choices: %+v", choices)
+	}
+}
