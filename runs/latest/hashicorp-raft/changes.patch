+// Copyright (c) HashiCorp, Inc.
+// SPDX-License-Identifier: MPL-2.0
+
+package raft
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// MessageHandle is an opaque, stable identity for one captured cross-node
+// message. Handles are allocated from a monotonically increasing counter and
+// are never reused: a handle stays valid while its message is pending and
+// becomes invalid after Drop, Clear, or a successful Inject.
+type MessageHandle struct {
+	id uint64
+}
+
+// MessageKind classifies a captured cross-node protocol message. The
+// underlying type is string so kinds are comparable and printable.
+type MessageKind string
+
+// The ten in-boundary cross-node message families, requests and responses.
+const (
+	MessageKindAppendEntriesRequest    MessageKind = "append_entries_request"
+	MessageKindAppendEntriesResponse   MessageKind = "append_entries_response"
+	MessageKindRequestVoteRequest      MessageKind = "request_vote_request"
+	MessageKindRequestVoteResponse     MessageKind = "request_vote_response"
+	MessageKindRequestPreVoteRequest   MessageKind = "request_prevote_request"
+	MessageKindRequestPreVoteResponse  MessageKind = "request_prevote_response"
+	MessageKindInstallSnapshotRequest  MessageKind = "install_snapshot_request"
+	MessageKindInstallSnapshotResponse MessageKind = "install_snapshot_response"
+	MessageKindTimeoutNowRequest       MessageKind = "timeout_now_request"
+	MessageKindTimeoutNowResponse      MessageKind = "timeout_now_response"
+)
+
+// MessagePayload is a typed variant carrier for the native request and
+// response commands that cross the in-boundary transport. Exactly one field is
+// set for a captured message; the field corresponds to the message Kind.
+type MessagePayload struct {
+	AppendEntriesRequest    *AppendEntriesRequest
+	AppendEntriesResponse   *AppendEntriesResponse
+	RequestVoteRequest      *RequestVoteRequest
+	RequestVoteResponse     *RequestVoteResponse
+	RequestPreVoteRequest   *RequestPreVoteRequest
+	RequestPreVoteResponse  *RequestPreVoteResponse
+	InstallSnapshotRequest  *InstallSnapshotRequest
+	InstallSnapshotResponse *InstallSnapshotResponse
+	TimeoutNowRequest       *TimeoutNowRequest
+	TimeoutNowResponse      *TimeoutNowResponse
+}
+
+// command returns the native command carried by the payload, or nil when no
+// field is set.
+func (p MessagePayload) command() interface{} {
+	switch {
+	case p.AppendEntriesRequest != nil:
+		return p.AppendEntriesRequest
+	case p.AppendEntriesResponse != nil:
+		return p.AppendEntriesResponse
+	case p.RequestVoteRequest != nil:
+		return p.RequestVoteRequest
+	case p.RequestVoteResponse != nil:
+		return p.RequestVoteResponse
+	case p.RequestPreVoteRequest != nil:
+		return p.RequestPreVoteRequest
+	case p.RequestPreVoteResponse != nil:
+		return p.RequestPreVoteResponse
+	case p.InstallSnapshotRequest != nil:
+		return p.InstallSnapshotRequest
+	case p.InstallSnapshotResponse != nil:
+		return p.InstallSnapshotResponse
+	case p.TimeoutNowRequest != nil:
+		return p.TimeoutNowRequest
+	case p.TimeoutNowResponse != nil:
+		return p.TimeoutNowResponse
+	}
+	return nil
+}
+
+// PendingMessage is the public, deeply-copied view of one captured message. It
+// is returned in stable controller acceptance order by MessageController.Pending.
+type PendingMessage struct {
+	// Handle is the stable identity of the captured message.
+	Handle MessageHandle
+	// Source is the ServerID of the node that produced the message. For a
+	// request this is the sending node; for a response this is the responding
+	// node (reversed relative to its request).
+	Source ServerID
+	// Target is the ServerID of the node the message is addressed to. For a
+	// response this is the node that issued the original request.
+	Target ServerID
+	// Kind classifies the message.
+	Kind MessageKind
+	// Message is the typed native content of the message. It is a fresh deep
+	// copy on every Pending call; mutating it never affects the controller's
+	// private copy that Inject delivers.
+	Message MessagePayload
+	// Stream is a fresh deep copy of the buffered InstallSnapshot payload
+	// stream. It is non-nil only for MessageKindInstallSnapshotRequest entries
+	// whose captured stream was non-empty; for every other kind it is nil.
+	// Mutating it never affects the controller's private replay buffer.
+	Stream []byte
+}
+
+// Controller errors. All are plain sentinel errors so callers can classify
+// failures with errors.Is.
+var (
+	// ErrMessageNotPending is returned when a handle does not identify a
+	// currently pending message (never captured, dropped, cleared, or already
+	// injected).
+	ErrMessageNotPending = errors.New("message not pending")
+	// ErrTargetUnavailable is returned by Inject when the captured target is
+	// not currently reachable through the normal in-boundary routing table.
+	ErrTargetUnavailable = errors.New("message target unavailable")
+	// ErrMessageNotAccepted is returned by Inject when the target's normal
+	// input boundary did not accept the message (for example the target's
+	// consumer queue is full and the transport send timeout elapsed).
+	ErrMessageNotAccepted = errors.New("message not accepted")
+)
+
+// pendingMessage is the controller-private representation of a captured
+// message. The payload and stream are the controller's own deep copies; the
+// response continuation keeps the original caller's exchange alive until the
+// response entry is injected.
+type pendingMessage struct {
+	handle  MessageHandle
+	kind    MessageKind
+	source  ServerID
+	target  ServerID
+	addr    ServerAddress // routing address of the message destination (requests only)
+	payload MessagePayload
+	stream  []byte // replayable buffered copy of an InstallSnapshot stream
+	waitCh  chan RPCResponse
+	resp    RPCResponse // set for response entries
+	isResp  bool
+	// injecting marks an entry whose Inject delivery is in progress. It is set
+	// under the controller lock before delivery starts and cleared again on a
+	// failed delivery, so concurrent Inject calls on one handle can never
+	// deliver the same message twice.
+	injecting bool
+	owner     *ControlledTransport
+}
+
+// MessageController owns every in-boundary cross-node message while controlled
+// mode is enabled. It is thread-safe; all public methods may be called from any
+// goroutine. Production behavior is unchanged while the controller is disabled
+// or not installed: wrapped transports simply delegate to the underlying
+// transport.
+type MessageController struct {
+	mu         sync.Mutex
+	nextID     uint64
+	pending    []*pendingMessage // controller acceptance order
+	byHandle   map[MessageHandle]*pendingMessage
+	controlled atomic.Bool
+}
+
+// NewMessageController creates an empty controller with controlled mode
+// disabled. Install it by wrapping each node's InmemTransport with
+// NewControlledTransport before starting the Raft nodes, then call
+// SetControlled(true) before the nodes can begin protocol work.
+func NewMessageController() *MessageController {
+	return &MessageController{
+		byHandle: make(map[MessageHandle]*pendingMessage),
+	}
+}
+
+// Controlled reports whether capture is currently enabled.
+func (c *MessageController) Controlled() bool {
+	return c.controlled.Load()
+}
+
+// SetControlled enables or disables capture. When disabled, wrapped transports
+// delegate every call to the underlying transport and no new entries are
+// captured; entries already pending remain manageable through Pending, Drop,
+// Clear, and Inject.
+func (c *MessageController) SetControlled(enabled bool) {
+	c.controlled.Store(enabled)
+}
+
+// Pending returns a deep snapshot of every currently captured message, in
+// stable controller acceptance order. Each call returns fresh copies: the
+// returned payloads and streams never alias the controller's private copies,
+// each other, or the copies returned by earlier Pending calls.
+func (c *MessageController) Pending() []PendingMessage {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]PendingMessage, 0, len(c.pending))
+	for _, e := range c.pending {
+		out = append(out, PendingMessage{
+			Handle:  e.handle,
+			Source:  e.source,
+			Target:  e.target,
+			Kind:    e.kind,
+			Message: copyPayload(e.payload),
+			Stream:  copyBytes(e.stream),
+		})
+	}
+	return out
+}
+
+// Drop removes one pending message without delivering it. The handle becomes
+// invalid. A caller blocked on the dropped message's response continuation
+// remains blocked until its transport-level wait resolves; no other entry is
+// affected and no entry is reordered.
+func (c *MessageController) Drop(handle MessageHandle) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.byHandle[handle]
+	if !ok {
+		return ErrMessageNotPending
+	}
+	c.removeLocked(e)
+	return nil
+}
+
+// Clear removes every pending message without delivering any of them. All
+// handles become invalid.
+func (c *MessageController) Clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, e := range c.pending {
+		delete(c.byHandle, e.handle)
+	}
+	c.pending = nil
+}
+
+// Inject delivers one pending message through the normal input boundary of its
+// captured target and updates the same cache. For a request, Inject enqueues
+// the controller's private copy into the target's consumer channel (the normal
+// protocol ingress); the request's response is separately captured as a new
+// pending entry with reversed routing and a new handle. For a response entry,
+// Inject forwards the stored response to the original caller's continuation so
+// the synchronous call, channel, or future completes normally.
+// Inject is single-delivery: while one Inject delivery of a handle is in
+// progress, a concurrent Inject of the same handle returns ErrMessageNotPending
+// without affecting the in-flight delivery, so a message can never be delivered
+// twice.
+//
+// Inject succeeds as soon as the input boundary confirms acceptance; it does
+// not wait for dequeue, state transition, response, commit, or quiescence.
+// Confirmed acceptance removes the entry and invalidates the handle. An
+// invalid handle, an unavailable target, or explicit non-acceptance returns an
+// error and preserves the entry.
+func (c *MessageController) Inject(handle MessageHandle) error {
+	c.mu.Lock()
+	e, ok := c.byHandle[handle]
+	if !ok {
+		c.mu.Unlock()
+		return ErrMessageNotPending
+	}
+	if e.injecting {
+		// A concurrent Inject is already delivering this entry; refuse the
+		// duplicate so the message is never delivered twice. The in-flight
+		// delivery decides the entry's fate.
+		c.mu.Unlock()
+		return ErrMessageNotPending
+	}
+	e.injecting = true
+	if e.isResp {
+		c.removeLocked(e)
+		c.mu.Unlock()
+		select {
+		case e.waitCh <- e.resp:
+		default: // the caller already timed out or closed; nothing to unblock
+		}
+		return nil
+	}
+	// Snapshot everything needed for delivery while holding the lock; the
+	// entry itself stays pending until acceptance is confirmed.
+	owner := e.owner
+	cmd := e.payload.command()
+	addr := e.addr
+	var reader io.Reader
+	if e.stream != nil {
+		reader = bytes.NewReader(e.stream)
+	}
+	c.mu.Unlock()
+
+	// Deterministic closed-owner handling: an entry whose owning transport was
+	// closed (Stop/Crash) is not deliverable through that transport. The check
+	// is performed once, before delivery, rather than as a select case against
+	// a permanently-ready closed channel, so the outcome is deterministic and
+	// the entry is preserved for a later retry. LifecycleController.Restart
+	// re-binds entries of a restarted node to its fresh wrapper, after which
+	// this check passes and delivery proceeds through the normal ingress.
+	select {
+	case <-owner.closedCh:
+		c.mu.Lock()
+		e.injecting = false
+		c.mu.Unlock()
+		return ErrMessageNotAccepted
+	default:
+	}
+
+	// Resolve the real captured target through the owning transport's normal
+	// routing table, exactly like InmemTransport.makeRPC.
+	owner.base.RLock()
+	peer, ok := owner.base.peers[addr]
+	owner.base.RUnlock()
+	if !ok || peer == nil {
+		// Preserve the entry and handle so a later Inject can retry.
+		c.mu.Lock()
+		e.injecting = false
+		c.mu.Unlock()
+		return ErrTargetUnavailable
+	}
+
+	respCh := make(chan RPCResponse, 1)
+	rpc := RPC{Command: cmd, Reader: reader, RespChan: respCh}
+	var timeoutCh <-chan time.Time
+	if owner.base.timeout > 0 {
+		timeoutCh = time.After(owner.base.timeout)
+	}
+	select {
+	case peer.consumerCh <- rpc:
+	case <-timeoutCh:
+		c.mu.Lock()
+		e.injecting = false
+		c.mu.Unlock()
+		return ErrMessageNotAccepted
+	}
+
+	// Confirmed acceptance: remove the request entry and invalidate its handle.
+	c.mu.Lock()
+	if cur, ok := c.byHandle[handle]; ok && cur == e {
+		c.removeLocked(e)
+	}
+	c.mu.Unlock()
+
+	// Watch for the protocol response and capture it as a new pending entry.
+	go c.awaitResponse(e, respCh)
+	return nil
+}
+
+// awaitResponse waits for the response produced by an injected request and
+// records it as a new pending entry with reversed Source/Target and a fresh
+// handle. The goroutine lives at most as long as the owning transport: it
+// exits when the transport closes.
+func (c *MessageController) awaitResponse(req *pendingMessage, respCh chan RPCResponse) {
+	select {
+	case rpcResp := <-respCh:
+		c.recordResponse(req, rpcResp)
+	case <-req.owner.closedCh:
+	}
+}
+
+// recordResponse turns one protocol response into a pending entry and keeps
+// the original caller's continuation attached to it.
+func (c *MessageController) recordResponse(req *pendingMessage, rpcResp RPCResponse) {
+	kind := responseKind(req.kind)
+	payload, err := payloadFromResponse(req.kind, rpcResp.Response)
+	if err != nil {
+		// Malformed response: never orphan the original caller.
+		select {
+		case req.waitCh <- RPCResponse{Response: rpcResp.Response, Error: err}:
+		default:
+		}
+		return
+	}
+	c.mu.Lock()
+	e := &pendingMessage{
+		handle:  MessageHandle{id: c.nextID},
+		kind:    kind,
+		source:  req.target,
+		target:  req.source,
+		addr:    req.addr,
+		payload: payload,
+		isResp:  true,
+		resp:    rpcResp,
+		waitCh:  req.waitCh,
+		owner:   req.owner,
+	}
+	c.nextID++
+	c.pending = append(c.pending, e)
+	c.byHandle[e.handle] = e
+	c.mu.Unlock()
+}
+
+// capture records one outbound request. The payload must already be a deep
+// copy owned by the controller; the stream, when non-nil, must be a fully
+// buffered, replayable copy.
+func (c *MessageController) capture(owner *ControlledTransport, kind MessageKind, source, target ServerID, addr ServerAddress, payload MessagePayload, stream []byte, waitCh chan RPCResponse) (MessageHandle, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e := &pendingMessage{
+		handle:  MessageHandle{id: c.nextID},
+		kind:    kind,
+		source:  source,
+		target:  target,
+		addr:    addr,
+		payload: payload,
+		stream:  stream,
+		waitCh:  waitCh,
+		owner:   owner,
+	}
+	c.nextID++
+	c.pending = append(c.pending, e)
+	c.byHandle[e.handle] = e
+	return e.handle, nil
+}
+
+// removeLocked deletes an entry while preserving the relative order of the
+// remaining entries (controller acceptance order).
+func (c *MessageController) removeLocked(e *pendingMessage) {
+	delete(c.byHandle, e.handle)
+	for i, cur := range c.pending {
+		if cur == e {
+			c.pending = append(c.pending[:i], c.pending[i+1:]...)
+			return
+		}
+	}
+}
+
+// rebindOwner reassigns every pending entry captured through old to fresh.
+// LifecycleController.Restart calls this when it replaces a closed
+// ControlledTransport with a fresh wrapper over the same underlying transport
+// and controller, so messages captured before a Stop or Crash remain
+// deliverable through the fresh transport of the same node after the restart.
+func (c *MessageController) rebindOwner(old, fresh *ControlledTransport) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for _, e := range c.pending {
+		if e.owner == old {
+			e.owner = fresh
+		}
+	}
+}
+
+// responseKind maps a request kind to its response kind.
+func responseKind(k MessageKind) MessageKind {
+	switch k {
+	case MessageKindAppendEntriesRequest:
+		return MessageKindAppendEntriesResponse
+	case MessageKindRequestVoteRequest:
+		return MessageKindRequestVoteResponse
+	case MessageKindRequestPreVoteRequest:
+		return MessageKindRequestPreVoteResponse
+	case MessageKindInstallSnapshotRequest:
+		return MessageKindInstallSnapshotResponse
+	case MessageKindTimeoutNowRequest:
+		return MessageKindTimeoutNowResponse
+	}
+	return k
+}
+
+// payloadFromResponse builds a typed deep-copied payload from the response to
+// a request of the given kind.
+func payloadFromResponse(kind MessageKind, resp interface{}) (MessagePayload, error) {
+	switch kind {
+	case MessageKindAppendEntriesRequest:
+		r, ok := resp.(*AppendEntriesResponse)
+		if !ok {
+			return MessagePayload{}, fmt.Errorf("unexpected response type %T for %s", resp, kind)
+		}
+		return MessagePayload{AppendEntriesResponse: copyAppendEntriesResponse(r)}, nil
+	case MessageKindRequestVoteRequest:
+		r, ok := resp.(*RequestVoteResponse)
+		if !ok {
+			return MessagePayload{}, fmt.Errorf("unexpected response type %T for %s", resp, kind)
+		}
+		return MessagePayload{RequestVoteResponse: copyRequestVoteResponse(r)}, nil
+	case MessageKindRequestPreVoteRequest:
+		r, ok := resp.(*RequestPreVoteResponse)
+		if !ok {
+			return MessagePayload{}, fmt.Errorf("unexpected response type %T for %s", resp, kind)
+		}
+		return MessagePayload{RequestPreVoteResponse: copyRequestPreVoteResponse(r)}, nil
+	case MessageKindInstallSnapshotRequest:
+		r, ok := resp.(*InstallSnapshotResponse)
+		if !ok {
+			return MessagePayload{}, fmt.Errorf("unexpected response type %T for %s", resp, kind)
+		}
+		return MessagePayload{InstallSnapshotResponse: copyInstallSnapshotResponse(r)}, nil
+	case MessageKindTimeoutNowRequest:
+		r, ok := resp.(*TimeoutNowResponse)
+		if !ok {
+			return MessagePayload{}, fmt.Errorf("unexpected response type %T for %s", resp, kind)
+		}
+		return MessagePayload{TimeoutNowResponse: copyTimeoutNowResponse(r)}, nil
+	}
+	return MessagePayload{}, fmt.Errorf("no response defined for kind %s", kind)
+}
+
+// copyPayload deep-copies every non-nil field of a payload.
+func copyPayload(p MessagePayload) MessagePayload {
+	return MessagePayload{
+		AppendEntriesRequest:    copyAppendEntriesRequest(p.AppendEntriesRequest),
+		AppendEntriesResponse:   copyAppendEntriesResponse(p.AppendEntriesResponse),
+		RequestVoteRequest:      copyRequestVoteRequest(p.RequestVoteRequest),
+		RequestVoteResponse:     copyRequestVoteResponse(p.RequestVoteResponse),
+		RequestPreVoteRequest:   copyRequestPreVoteRequest(p.RequestPreVoteRequest),
+		RequestPreVoteResponse:  copyRequestPreVoteResponse(p.RequestPreVoteResponse),
+		InstallSnapshotRequest:  copyInstallSnapshotRequest(p.InstallSnapshotRequest),
+		InstallSnapshotResponse: copyInstallSnapshotResponse(p.InstallSnapshotResponse),
+		TimeoutNowRequest:       copyTimeoutNowRequest(p.TimeoutNowRequest),
+		TimeoutNowResponse:      copyTimeoutNowResponse(p.TimeoutNowResponse),
+	}
+}
+
+func copyBytes(in []byte) []byte {
+	if in == nil {
+		return nil
+	}
+	out := make([]byte, len(in))
+	copy(out, in)
+	return out
+}
+
+func copyRPCHeader(h RPCHeader) RPCHeader {
+	return RPCHeader{ProtocolVersion: h.ProtocolVersion, ID: copyBytes(h.ID), Addr: copyBytes(h.Addr)}
+}
+
+func copyLog(l *Log) *Log {
+	if l == nil {
+		return nil
+	}
+	return &Log{
+		Index:      l.Index,
+		Term:       l.Term,
+		Type:       l.Type,
+		Data:       copyBytes(l.Data),
+		Extensions: copyBytes(l.Extensions),
+		AppendedAt: l.AppendedAt,
+	}
+}
+
+func copyAppendEntriesRequest(r *AppendEntriesRequest) *AppendEntriesRequest {
+	if r == nil {
+		return nil
+	}
+	out := &AppendEntriesRequest{
+		RPCHeader:         copyRPCHeader(r.RPCHeader),
+		Term:              r.Term,
+		Leader:            copyBytes(r.Leader),
+		PrevLogEntry:      r.PrevLogEntry,
+		PrevLogTerm:       r.PrevLogTerm,
+		LeaderCommitIndex: r.LeaderCommitIndex,
+	}
+	if r.Entries != nil {
+		out.Entries = make([]*Log, len(r.Entries))
+		for i, e := range r.Entries {
+			out.Entries[i] = copyLog(e)
+		}
+	}
+	return out
+}
+
+func copyAppendEntriesResponse(r *AppendEntriesResponse) *AppendEntriesResponse {
+	if r == nil {
+		return nil
+	}
+	return &AppendEntriesResponse{
+		RPCHeader:      copyRPCHeader(r.RPCHeader),
+		Term:           r.Term,
+		LastLog:        r.LastLog,
+		Success:        r.Success,
+		NoRetryBackoff: r.NoRetryBackoff,
+	}
+}
+
+func copyRequestVoteRequest(r *RequestVoteRequest) *RequestVoteRequest {
+	if r == nil {
+		return nil
+	}
+	return &RequestVoteRequest{
+		RPCHeader:          copyRPCHeader(r.RPCHeader),
+		Term:               r.Term,
+		Candidate:          copyBytes(r.Candidate),
+		LastLogIndex:       r.LastLogIndex,
+		LastLogTerm:        r.LastLogTerm,
+		LeadershipTransfer: r.LeadershipTransfer,
+	}
+}
+
+func copyRequestVoteResponse(r *RequestVoteResponse) *RequestVoteResponse {
+	if r == nil {
+		return nil
+	}
+	return &RequestVoteResponse{
+		RPCHeader: copyRPCHeader(r.RPCHeader),
+		Term:      r.Term,
+		Peers:     copyBytes(r.Peers),
+		Granted:   r.Granted,
+	}
+}
+
+func copyRequestPreVoteRequest(r *RequestPreVoteRequest) *RequestPreVoteRequest {
+	if r == nil {
+		return nil
+	}
+	return &RequestPreVoteRequest{
+		RPCHeader:    copyRPCHeader(r.RPCHeader),
+		Term:         r.Term,
+		LastLogIndex: r.LastLogIndex,
+		LastLogTerm:  r.LastLogTerm,
+	}
+}
+
+func copyRequestPreVoteResponse(r *RequestPreVoteResponse) *RequestPreVoteResponse {
+	if r == nil {
+		return nil
+	}
+	return &RequestPreVoteResponse{
+		RPCHeader: copyRPCHeader(r.RPCHeader),
+		Term:      r.Term,
+		Granted:   r.Granted,
+	}
+}
+
+func copyInstallSnapshotRequest(r *InstallSnapshotRequest) *InstallSnapshotRequest {
+	if r == nil {
+		return nil
+	}
+	return &InstallSnapshotRequest{
+		RPCHeader:          copyRPCHeader(r.RPCHeader),
+		SnapshotVersion:    r.SnapshotVersion,
+		Term:               r.Term,
+		Leader:             copyBytes(r.Leader),
+		LastLogIndex:       r.LastLogIndex,
+		LastLogTerm:        r.LastLogTerm,
+		Peers:              copyBytes(r.Peers),
+		Configuration:      copyBytes(r.Configuration),
+		ConfigurationIndex: r.ConfigurationIndex,
+		Size:               r.Size,
+	}
+}
+
+func copyInstallSnapshotResponse(r *InstallSnapshotResponse) *InstallSnapshotResponse {
+	if r == nil {
+		return nil
+	}
+	return &InstallSnapshotResponse{
+		RPCHeader: copyRPCHeader(r.RPCHeader),
+		Term:      r.Term,
+		Success:   r.Success,
+	}
+}
+
+func copyTimeoutNowRequest(r *TimeoutNowRequest) *TimeoutNowRequest {
+	if r == nil {
+		return nil
+	}
+	return &TimeoutNowRequest{RPCHeader: copyRPCHeader(r.RPCHeader)}
+}
+
+func copyTimeoutNowResponse(r *TimeoutNowResponse) *TimeoutNowResponse {
+	if r == nil {
+		return nil
+	}
+	return &TimeoutNowResponse{RPCHeader: copyRPCHeader(r.RPCHeader)}
+}
