name: mini-raft
language: go
protocol: raft
repository: /absolute/path/to/mini_raft

system_boundary:
  kind: protocol_library
  description: >
    Analyze the target protocol library. Discover all materially distinct public
    execution paths inside this boundary. External applications and real network
    behavior are outside the boundary.

# 以下两个字段均可省略；省略时默认整个仓库可读写，不附加只读目录。
# 大型仓库需要限制文件夹级源码权限时，再取消注释并替换实际路径。
# scope_roots:
#   - path/to/protocol
# evidence_roots:
#   - path/to/shared-types

transform_capabilities:
  - message_capture
  - message_injection

build:
  command: go test -run '^$' ./...

test:
  command: go test ./...

capability_checks:
  - name: 基本消息捕获
    capability: message_capture
    command: go test ./... -run '^TestMessageCapture$'
    failure_code: MESSAGE_CAPTURE_FAILED
  - name: 捕获后停止自动发送
    capability: message_capture
    command: go test ./... -run '^TestMessageSuppression$'
    failure_code: MESSAGE_SUPPRESSION_FAILED
  - name: 基本消息注入
    capability: message_injection
    command: go test ./... -run '^TestExactMessageInjection$'
    failure_code: MESSAGE_INJECTION_FAILED

llm:
  analyzer:
    model: deepseek-v4-flash
    thinking: enabled
    reasoning_effort: max
    max_tokens: 32768
  transformer:
    model: deepseek-v4-flash
    thinking: enabled
    reasoning_effort: max
    max_tokens: 32768
  reviewer:
    model: deepseek-v4-pro
    thinking: enabled
    reasoning_effort: high
    max_tokens: 32768

working_directory: .

limits:
  agent1_reanalysis_rounds: 2
  agent2_patch_rounds: 3
